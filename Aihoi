Underground = {
    enabled = false,
    depth = 2.2,
    heartbeatConn = nil,
    renderConn = nil,
    realCF = nil,
    realVel = nil,
    realAngVel = nil,

    setEnabled = function(self, state)
        self.enabled = state
        if state then
            if self.heartbeatConn then return end
            self.heartbeatConn = RunService.Heartbeat:Connect(function()
                if not self.enabled then return end
                pcall(function()
                    local char = lp.Character
                    if not char then return end
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    self.realCF = hrp.CFrame
                    self.realVel = hrp.AssemblyLinearVelocity
                    self.realAngVel = hrp.AssemblyAngularVelocity
                    local depth = self.depth or 2.2
                    local params = RaycastParams.new()
                    params.FilterDescendantsInstances = { char }
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    local result = Workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), params)
                    if result then
                        local fakeY = result.Position.Y - depth
                        hrp.CFrame = CFrame.new(hrp.Position.X, fakeY, hrp.Position.Z)
                    else
                        hrp.CFrame = CFrame.new(hrp.Position.X, -99999, hrp.Position.Z)
                    end
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end)
            end)
            self.renderConn = RunService:BindToRenderStep("UndergroundSync", Enum.RenderPriority.First.Value, function()
                if self.enabled and self.realCF then
                    pcall(function()
                        local char = lp.Character
                        if not char then return end
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if not hrp then return end
                        hrp.CFrame = self.realCF
                        hrp.AssemblyLinearVelocity = self.realVel or Vector3.zero
                        hrp.AssemblyAngularVelocity = self.realAngVel or Vector3.zero
                    end)
                end
            end)
        else
            if self.heartbeatConn then self.heartbeatConn:Disconnect(); self.heartbeatConn = nil end
            if self.renderConn then pcall(function() RunService:UnbindFromRenderStep("UndergroundSync") end); self.renderConn = nil end
            self.realCF = nil; self.realVel = nil; self.realAngVel = nil
        end
    end,

    setDepth = function(self, v) self.depth = v end
}

