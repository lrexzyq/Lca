        local ok, pos = pcall(function() return config.orbit.savedpos end)
        if ok and pos then
            pcall(function()
                localfighter.Entity.RootPart.CFrame = pos
            end)
        end    end
    config.orbit.serverpos = nil
    config.orbit.savedpos = nil
    config.voidspam.phase = nil
    oldpos = nil
