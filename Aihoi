-- 3. Void Spam Logic
voidSpamEnabled = false
local voidRange = math.huge
local hrp = nil
local clientc, clientv, clientva = nil, nil, nil
local heartbeatConn, renderConn = nil

local function betterRandom(mi, ma, dmi, dma)
    local val = math.random(mi, ma)
    repeat val = math.random(mi, ma) until val < dmi or val > dma
    return val
end

function startVoidSpam()
    if heartbeatConn then return end
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not voidSpamEnabled then return end
        pcall(function()
            local char = lp.Character
            if not char then return end
            hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            clientc = hrp.CFrame
            clientv = hrp.AssemblyLinearVelocity
            clientva = hrp.AssemblyAngularVelocity
            local range = voidRange
            hrp.CFrame = CFrame.new(
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2)
            ) * CFrame.Angles(math.pi, math.pi, math.pi)
            hrp.AssemblyLinearVelocity = Vector3.new(
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2)
            )
            hrp.AssemblyAngularVelocity = Vector3.new(
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2)
            )
        end)
    end)
    renderConn = RunService:BindToRenderStep("VoidSpamSync", Enum.RenderPriority.First.Value, function()
        if voidSpamEnabled and hrp then
            pcall(function()
                hrp.CFrame = clientc
                hrp.AssemblyLinearVelocity = clientv
                hrp.AssemblyAngularVelocity = clientva
            end)
        end
    end)
end

function stopVoidSpam()
    voidSpamEnabled = false
    if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
    if renderConn then pcall(function() RunService:UnbindFromRenderStep("VoidSpamSync") end); renderConn = nil end
    hrp = nil
    clientc = nil
    clientv = nil
    clientva = nil
end


-- 4. Anti-Aim Logic (Void Spam style)
AntiAim = {
    enabled = false,
    depth = 2.2,
    heartbeatConn = nil,
    renderConn = nil,
    realCF = nil,
    realVel = nil,
    realAngVel = nil,

    setEnabled = function(self, state)
        self.enabled = state
        if state then
            if self.heartbeatConn then return end
            self.heartbeatConn = RunService.Heartbeat:Connect(function()
                if not self.enabled then return end
                pcall(function()
                    local char = lp.Character
                    if not char then return end
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    self.realCF = hrp.CFrame
                    self.realVel = hrp.AssemblyLinearVelocity
                    self.realAngVel = hrp.AssemblyAngularVelocity
                    local depth = self.depth or 2.2
                    local fakeY = -100000 - depth
                    hrp.CFrame = CFrame.new(hrp.Position.X, fakeY, hrp.Position.Z) * CFrame.Angles(math.pi, math.pi, math.pi)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end)
            self.renderConn = RunService:BindToRenderStep("AntiAimSync", Enum.RenderPriority.First.Value, function()
                if self.enabled and self.realCF then
                    pcall(function()
                        local char = lp.Character
                        if not char then return end
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if not hrp then return end
                        hrp.CFrame = self.realCF
                        hrp.AssemblyLinearVelocity = self.realVel or Vector3.zero
                        hrp.AssemblyAngularVelocity = self.realAngVel or Vector3.zero
                    end)
                end
            end)
        else
            if self.heartbeatConn then self.heartbeatConn:Disconnect(); self.heartbeatConn = nil end
            if self.renderConn then pcall(function() RunService:UnbindFromRenderStep("AntiAimSync") end); self.renderConn = nil end
            self.realCF = nil; self.realVel = nil; self.realAngVel = nil
        end
    end,

    setDepth = function(self, v) self.depth = v end
}


-- 5. Weapon Mods Logic
WeaponMods = {
    reload = false,
    ads = false,
    equip = false,
    _originalStartAiming = nil,
    _originalEquip = nil,

    apply = function(self)
        pcall(function()
            local Gun = safeRequire(lp.PlayerScripts.Modules.ItemTypes.Gun)
            if not Gun then return end

            if not self._originalStartAiming and Gun.StartAiming then
                self._originalStartAiming = Gun.StartAiming
            end
            if not self._originalEquip and Gun.Equip then
                self._originalEquip = Gun.Equip
            end

            if self.reload then
                local IL = safeRequire(ReplicatedStorage.Modules.ItemLibrary)
                if IL and IL.Items then
                    for _, item in pairs(IL.Items) do
                        if (item.Name == "Bow" or item.Name == "Daggers" or item.Name == "Slingshot") and item.ReloadLength then
                            item.ReloadLength = item.Name == "Daggers" and 0.09 or 0
                        end
                    end
                end
            end

            if self.ads and Gun.StartAiming then
                Gun.StartAiming = function(selfItem)
                    selfItem:SetReplicate("IsAiming", true)
                    selfItem.StopSprinting:Fire()
                    selfItem.ViewModel:SetAiming(true)
                    selfItem:SetReplicate("FOVOffset", selfItem.Info.AimFOVOffset)
                    if selfItem.ViewModel.CurrentAimValue then
                        selfItem.ViewModel.CurrentAimValue = 1
                    end
                    return true, "StartAiming"
                end
                if Gun.GetAimSpeed then
                    Gun.GetAimSpeed = function() return 999 end
                end
            elseif not self.ads and self._originalStartAiming then
                Gun.StartAiming = self._originalStartAiming
            end

            if self.equip and Gun.Equip then
                local old = Gun.Equip
                Gun.Equip = function(selfItem, ...)
                    local r = { old(selfItem, ...) }
                    if selfItem.ViewModel then
                        selfItem.ViewModel:StopAnimation("Equip")
                        selfItem.ViewModel:StopAnimation("EquipEmpty")
                    end
                    return table.unpack(r)
                end
            elseif not self.equip and self._originalEquip then
                Gun.Equip = self._originalEquip
            end
        end)
    end,

    setReload = function(self, v) self.reload = v; self:apply() end,
    setADS = function(self, v) self.ads = v; self:apply() end,
    setEquip = function(self, v) self.equip = v; self:apply() end,
}


