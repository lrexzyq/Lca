                            vm.PlayAnimation = savedPlay
                            pcall(function()
                                for _, name in ipairs({"Shoot","Fire","ShootBurst","Shoot_ADS","ShootHip","ShootEmpty","ShootADS","Burst"}) do
                                    vm:StopAnimation(name)
                                end
                            end)
                        end
                        return table.unpack(result)
                    end
                end
                local function silenceShootAnim(self, fn, ...)
                    if not self.ViewModel then return fn(self, ...) end
                    local vm = self.ViewModel; local oldPlay = vm.PlayAnimation
                    vm.PlayAnimation = function() end
                    local result = { pcall(fn, self, ...) }
                    vm.PlayAnimation = oldPlay
                    pcall(function()
                        for _, name in ipairs({"Shoot","Fire","ShootBurst","Shoot_ADS","Shoot_Hip","ShootEmpty","ShootADS","Burst"}) do
                            vm:StopAnimation(name)
                        end
                    end)
                    if result[1] then return table.unpack(result, 2) end
                end
                if Gun.FinishShooting then
                    local old = Gun.FinishShooting
                    Gun.FinishShooting = function(self, ...) return silenceShootAnim(self, old, ...) end
                end
                if Gun.ShootBurst then
                    local old = Gun.ShootBurst
                    Gun.ShootBurst = function(self, ...) return silenceShootAnim(self, old, ...) end
                end
            end
        end)
    end

    -- No Equip Animation
    if ModSettings.NoEquipAnimation then
        task.spawn(function()
            local ok, Gun = pcall(function() return require(lp.PlayerScripts.Modules.ItemTypes.Gun) end)
            if ok and Gun and Gun.Equip then
                local old = Gun.Equip
                Gun.Equip = function(self, ...)
                    local r = { old(self, ...) }
                    if self.ViewModel then
                        self.ViewModel:StopAnimation("Equip")
                        self.ViewModel:StopAnimation("EquipEmpty")
                    end
                    return table.unpack(r)
                end
            end
        end)
    end

    -- Instant ADS
    if ModSettings.InstantADS then
        task.spawn(function()
            local ok, Gun = pcall(function() return require(lp.PlayerScripts.Modules.ItemTypes.Gun) end)
            if ok and Gun then
                if Gun.StartAiming then
                    Gun.StartAiming = function(self, p)
                        self:SetReplicate("IsAiming", true)
                        self.StopSprinting:Fire()
                        self.ViewModel:SetAiming(true)
                        self:SetReplicate("FOVOffset", self.Info.AimFOVOffset)
                        if self.ViewModel.CurrentAimValue then self.ViewModel.CurrentAimValue = 1 end
                        return true, "StartAiming"
                    end
                end
                if Gun.GetAimSpeed then
                    Gun.GetAimSpeed = function(self) return 999 end
                end
            end
        end)
    end

    -- Rapid Fire
    if ModSettings.RapidFire then
        task.spawn(function()
            local ok, Gun = pcall(function() return require(lp.PlayerScripts.Modules.ItemTypes.Gun) end)
            if ok and Gun and Gun.Update then
                local oldUpdate = Gun.Update
                Gun.Update = function(self, dt, ...)
                    if self._shoot_cooldown then self._shoot_cooldown = 0 end
                    return oldUpdate(self, dt, ...)
                end
            end
        end)
    end

    -- No Spread
    if ModSettings.NoSpread then
        task.spawn(function()
            local ok, GameplayUtility = pcall(function() return require(ReplicatedStorage.Modules.GameplayUtility) end)
            if ok and GameplayUtility then
                GameplayUtility.GetSpread = function() return CFrame.identity end
            end
            local FighterController = require(lp.PlayerScripts.Controllers.FighterController)
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer" and self.Name == "UseItem" then
                    local args = {...}
                    if typeof(args[3]) == "table" then
                        args[3]["\2"] = true
                    end
                end
                return oldNamecall(self, ...)
            end)
        end)
    end

    -- No Smoke
    if ModSettings.NoSmoke then
        task.spawn(function()
            local ok, SmokeScreen = pcall(function() return require(lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.FighterInterface.SmokeScreen) end)
            if ok and SmokeScreen and SmokeScreen.Update then
                SmokeScreen.Update = function(self)
                    self._smoke_cloud_spring.Target = 0
                    self._smoke_cloud_cover.Transparency = 1
                    if self._smoke_cloud_dof then self._smoke_cloud_dof.Parent = nil end
                    return
                end
            end
            local ok2, SmokeCloud = pcall(function() return require(lp.PlayerScripts.Modules.SmokeCloud) end)
            if ok2 and SmokeCloud and SmokeCloud.Update then
                SmokeCloud.Update = function(self)
                    if self.Model then self.Model:Destroy() end
                    return true
                end
            end
        end)
    end

    -- No Recoil
    if ModSettings.NoRecoil then
        task.spawn(function()
            local ok, ClientItem = pcall(function() return require(lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem) end)
            if ok and ClientItem and ClientItem._Recoil then
                ClientItem._Recoil = function() return end
            end
        end)
    end

    -- Device Spoof
    if ModSettings.DeviceSpoof then
        task.spawn(function()
            local device = ModSettings.DeviceType or "VR"
            local remote = ReplicatedStorage.Remotes.Replication.Fighter.SetControls
            local controllers = lp.PlayerScripts.Controllers
            local ok, fighterController = pcall(function() return require(controllers:WaitForChild("FighterController", 10)) end)
            if ok and fighterController and fighterController._ReplicateControls then
                fighterController._ReplicateControls = function(self)
                    remote:FireServer(device)
                    if not self._last_controls_replicated_time then
                        self._last_controls_replicated_time = 0
                    end
                    self._last_controls_replicated_time = tick()
                end
                remote:FireServer(device)
            end
        end)
    end

    -- No Flash
    if ModSettings.NoFlash then
        task.spawn(function()
            local ok, Flashed = pcall(function() return require(lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.FighterInterface.Flashed) end)
            if ok and Flashed and Flashed.Flash then
                Flashed.Flash = function() return end
            end
        end)
    end
end

