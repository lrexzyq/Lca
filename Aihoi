undergroundEnabled = false
undergroundDepth = 2.2
undergroundConn = nil
undergroundRealCF = nil
undergroundRealVel = nil
undergroundRealAngVel = nil
undergroundRenderConn = nil

local function startUnderground()
    if undergroundConn then return end
    undergroundConn = RunService.Heartbeat:Connect(function()
        if not undergroundEnabled then return end
        pcall(function()
            local char = lp.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            undergroundRealCF = hrp.CFrame
            undergroundRealVel = hrp.AssemblyLinearVelocity
            undergroundRealAngVel = hrp.AssemblyAngularVelocity
            local depth = undergroundDepth or 2.2
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = { char }
            params.FilterType = Enum.RaycastFilterType.Exclude
            local result = Workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), params)
            local fakeY
            if result then
                fakeY = result.Position.Y - depth
            else
                fakeY = -99999
            end
            hrp.CFrame = CFrame.new(hrp.Position.X, fakeY, hrp.Position.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end)
    undergroundRenderConn = RunService:BindToRenderStep("UndergroundSync", Enum.RenderPriority.First.Value, function()
        if undergroundEnabled and undergroundRealCF then
            pcall(function()
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                hrp.CFrame = undergroundRealCF
                hrp.AssemblyLinearVelocity = undergroundRealVel or Vector3.zero
                hrp.AssemblyAngularVelocity = undergroundRealAngVel or Vector3.zero
            end)
        end
    end)
end

local function stopUnderground()
    if undergroundConn then
        undergroundConn:Disconnect()
        undergroundConn = nil
    end
    if undergroundRenderConn then
        pcall(function() RunService:UnbindFromRenderStep("UndergroundSync") end)
        undergroundRenderConn = nil
    end
    undergroundRealCF = nil
    undergroundRealVel = nil
    undergroundRealAngVel = nil
end

getgenv().SetUnderground = function(val)
    undergroundEnabled = val
    if val then startUnderground() else stopUnderground() end
end
getgenv().UndergroundEnabled = false

