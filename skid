    csync.replicationRoot = nil
end

function Ragebot:UpdateCSync()
    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local csync = self.Pipeline.csync
    if not root then
        csync.active = false
        csync.clientCFrame = nil
        csync.serverCFrame = nil
        csync.serverPosition = nil
        csync.replicationRoot = nil
        return false
    end

    local rep = character:FindFirstChild("PhysicsRepRootPart")
    csync.replicationRoot = rep
    csync.clientCFrame = root.CFrame
    csync.serverCFrame = rep and rep.CFrame or root.CFrame
    csync.serverPosition = csync.serverCFrame.Position
    csync.active = rep ~= nil and rep ~= root
    csync.lastUpdate = os.clock()
    return true
end

function Ragebot:GetServerPosition()
    local csync = self.Pipeline.csync
    if csync.serverPosition then return csync.serverPosition end
    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
