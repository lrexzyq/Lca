function Ragebot:CanUse(item)
    local character = lp.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if not item then return false end
    if self:IsMelee(item) then return true end
    local ammo = tonumber(self:GetItemValue(item, "Ammo"))
    if ammo == nil then return true end
    return ammo > 0
end

function Ragebot:ShouldHoldForVoid()
    return Config.void == true and Config.voidState.phase == "hide"
end

function Ragebot:PrepareShoot(target, item)
    return self:PlanKiciaPosition(target, item)
end

function Ragebot:RunAttackPipeline(target, item)
    self.Pipeline.lastAction = "none"
    if not Config.enabled or not target or not item then return false end
    if self:ShouldHoldForVoid() then return false end
    if not self:ValidateTarget(target) then return false end
    if not self:IsWeaponAllowed(item) then return false end
    if not self:CanUse(item) then
        if self:HandleEmpty(item) then
            self.Pipeline.lastAction = "reload_or_swap"
        end
        return false
    end
    local plan = self:PrepareShoot(target, item)
    if not plan then return false end
    if not self:PlanReady(target, item) then return false end

    local success
    if plan.knife then
        success = self:PerformKnifeAttack(target, item, plan)
    elseif plan.melee then
        success = self:PerformMeleeAttack(target, item)
    else
        success = self:PerformRangedAttack(target, item)
    end

    if success then
        self.Pipeline.lastShot = os.clock()
        self.Pipeline.shotIssued = true
        self.Pipeline.vh.lastPhase = Config.voidState.phase
    end
    return success == true
end

function Ragebot:HideShot()
    if not Config.void or Config.mode ~= "Normal" then return false end
    if Config.voidState.phase ~= "attack" then return false end
    if not self.Pipeline.shotIssued then return false end
    self.Pipeline.shotIssued = false
    local now = os.clock()
    Config.voidState.phase = "hide"
    Config.voidState.phaseStarted = now
    self:StartVH()
    self.Pipeline.vh.lastPhase = "hide"
    VoidSpam:SetEnabled(true)
    self:ResetPlanner()
    return true
end


