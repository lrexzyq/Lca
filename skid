function Ragebot:GetItemValue(item, key)
    if not item then return nil end
    local ok, value = pcall(function()
        if type(item.Get) == "function" then
            local result = item:Get(key)
            if result ~= nil then return result end
        end
        if item.Info and item.Info[key] ~= nil then return item.Info[key] end
        if item.Data and item.Data[key] ~= nil then return item.Data[key] end
    end)
    return ok and value or nil
end

function Ragebot:GetWeaponName(item)
    if not item then return nil end
    local name = self:GetItemValue(item, "Name")
    return tostring(name or item.Name or "")
end

function Ragebot:IsMelee(item)
    if not item then return false end
    local mappedSlot = WeaponSlotByName[self:GetWeaponName(item)]
    if mappedSlot then return mappedSlot == "melee" end
    local kind = tostring(self:GetItemValue(item, "Type") or self:GetItemValue(item, "ItemType") or ""):lower()
    return kind:find("melee", 1, true) ~= nil
end

function Ragebot:IsKnife(item)
    if not self:IsMelee(item) then return false end
    return self:GetWeaponName(item):lower() == "knife"
end

function Ragebot:WeaponCategory(item)
    if not item then return nil end
    local direct = WeaponSlotByName[self:GetWeaponName(item)]
    if direct then return direct end
    return self:IsMelee(item) and "melee" or nil
end

function Ragebot:SelectedWeapons()
    local selected = {
        primary = Config.weapons.primary == true,
        secondary = Config.weapons.secondary == true,
        melee = Config.weapons.melee == true,
    }
    if selected.secondary then
        selected.primary = false
        selected.melee = false
    elseif not selected.primary and not selected.melee then
        selected.primary = true
    end
    return selected
end

function Ragebot:IsWeaponAllowed(item)
    local slot = self:WeaponCategory(item)
    return slot ~= nil and self:SelectedWeapons()[slot] == true
end

function Ragebot:NextSelected(exclude)
    local selected = self:SelectedWeapons()
    for _, slot in ipairs({ "primary", "secondary", "melee" }) do
        if slot ~= exclude and selected[slot] then return slot end
    end
    return nil
end

function Ragebot:Equip(slot)
    if not slot then return false end
    local current = self:GetEquipped()
    if current and self:WeaponCategory(current) == slot then return true end
    if State.Weapon.switching then return false end

    local fighter = self:GetFighter()
    if not fighter then return false end

    State.Weapon.switching = true
    local callOK, result = pcall(function()
        local currentItem = fighter.EquippedItem
        if not currentItem or type(currentItem.EquipItem) ~= "function" then return false end
        return currentItem:EquipItem(slot) ~= false
    end)
    State.Weapon.switching = false
    local ok = callOK and result == true

    if ok then
        State.Weapon.current = self:GetEquipped()
        State.Weapon.category = slot
        State.Weapon.lastSwitch = os.clock()
    end
    return ok
end

function Ragebot:EquipNext(exclude)
    return self:Equip(self:NextSelected(exclude))
end

function Ragebot:TargetAlive(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

function Ragebot:TargetPart(character)
    if not character then return nil end
    return character:FindFirstChild("Head")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

function Ragebot:SameEnvironment(player)
    local mine = lp:GetAttribute("EnvironmentID")
    local theirs = player and player:GetAttribute("EnvironmentID")
    return mine == nil or theirs == nil or mine == theirs
end

function Ragebot:AcquireTarget()
    local priorityTarget = self:GetPriorityTarget()
    if priorityTarget then
        local player = Players:GetPlayerFromCharacter(priorityTarget)
        local part = self:TargetPart(priorityTarget)
        if part then
            State.Target.character = priorityTarget
            State.Target.player = player
            State.Target.part = part
            State.Target.acquiredAt = os.clock()
            Config.target = priorityTarget
            return priorityTarget
        end
    end
    local camera = Workspace.CurrentCamera
    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local origin = camera and camera.CFrame.Position or root and root.Position
    if not origin then return nil end

    local myTeam = lp:GetAttribute("TeamID")
    local best, bestPlayer, bestPart, bestDistance

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp and self:SameEnvironment(player) then
            local theirTeam = player:GetAttribute("TeamID")
            if myTeam == nil or theirTeam == nil or theirTeam ~= myTeam then
                local character = player.Character
                local part = self:TargetPart(character)
                if part and self:TargetAlive(character) then
                    local distance = (part.Position - origin).Magnitude
                    if not bestDistance or distance < bestDistance then
                        best = character
                        bestPlayer = player
                        bestPart = part
                        bestDistance = distance
                    end
                end
            end
        end
    end

    if best then
        State.Target.character = best
        State.Target.player = bestPlayer
        State.Target.part = bestPart
        State.Target.acquiredAt = os.clock()
        Config.target = best
    end
    return best
end

function Ragebot:RefreshTarget()
    if not self:TargetAlive(Config.target) then
        self:ResetTarget()
        return self:AcquireTarget()
    end

    local part = self:TargetPart(Config.target)
    if not part then
        self:ResetTarget()
        return self:AcquireTarget()
    end

    State.Target.part = part
    return Config.target
end

function Ragebot:PlanReady(target, item)
    local planner = State.Planner
    local lock = State.ShootLock
    local now = os.clock()
    local frames = math.clamp(math.floor(tonumber(Config.shootFrames) or 1), 1, 5)
    local frameInterval = 0.06666666666666667 * frames
    local stability = math.clamp(tonumber(Config.stability) or 0.01, 0.01, 1.5)

    if lock.target ~= target or planner.weapon ~= item then
        lock.target = target
        lock.startedAt = now
        lock.nextAt = now + frameInterval
        lock.frames = frames
        lock.interval = frameInterval
        planner.target = target
        planner.weapon = item
        planner.attackStart = now
        planner.shotLockUntil = lock.nextAt
        planner.lastAccepted = -math.huge
        return false
    end

    lock.frames = frames
    lock.interval = frameInterval
    if now < lock.nextAt or now < planner.shotLockUntil then return false end
    if not planner.attackStart then planner.attackStart = now; return false end
    return now - planner.attackStart >= 0.06666666666666667
        and now - planner.lastAccepted >= stability
end

function Ragebot:Reload(item)
    if not item or self:IsMelee(item) then return false end
    local ammo = tonumber(self:GetItemValue(item, "Ammo"))
    local reserve = tonumber(self:GetItemValue(item, "AmmoReserve"))
    if ammo == nil or reserve == nil or ammo > 0 or reserve <= 0 then return false end

    local now = os.clock()
    if now < Config.reloadNext or State.Reload.active then return false end

    local success = false
    State.Reload.active = true
    State.Reload.startedAt = now
    pcall(function()
        if type(item.StartReloading) == "function" then
            item:StartReloading()
            success = true
        end
    end)

    if success then
        local cooldown = 0.4
        pcall(function()
            local info = item.Info
            cooldown = math.max(0.05, tonumber(info and (info.ReloadCooldown or info.ReloadTime)) or 0.4)
        end)
        Config.reloadNext = now + cooldown
        State.Reload.readyAt = now + cooldown
    else
        State.Reload.active = false
        State.Reload.startedAt = 0
        State.Reload.readyAt = 0
    end
    return success
end

function Ragebot:UpdateReload()
    if not State.Reload.active then return end
    if os.clock() >= State.Reload.readyAt then
        State.Reload.active = false
        State.Reload.startedAt = 0
        State.Reload.readyAt = 0
    end
end

function Ragebot:GetMeleeCooldown(item)
    local cooldown = 0.2
    pcall(function()
        local info = item and item.Info
        cooldown = tonumber(info and (info.HeavyAttackCooldown or info.AttackCooldown or info.Cooldown)) or cooldown
    end)
    return math.max(0.05, cooldown)
end

function Ragebot:IsBehindTarget(target)
    local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
    local localRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot or not localRoot then return false end
    local delta = localRoot.Position - targetRoot.Position
    if delta.Magnitude <= 0.001 then return false end
    return targetRoot.CFrame.LookVector:Dot(delta.Unit) <= -0.25
end

function Ragebot:PerformKnifeAttack(target, item, plan)
    if not target or not item or not self:IsKnife(item) then return false end
    local hitPart = plan and plan.part or self:TargetPart(target)
    if not hitPart then return false end
    local state = State.Knife
    local now = os.clock()
    if state.target ~= target or state.weapon ~= item then
        state.target, state.weapon = target, item
        state.hitboxWindowUntil = 0
        state.attackCooldown = 0
        state.backstabActive = false
    end
    if now < state.attackCooldown then return false end

    local origin = (plan and plan.origin) or self:GetAttackOrigin()
    local targetPosition = (plan and plan.position) or hitPart.Position
    if not origin then return false end
    local lookCF = CFrame.lookAt(origin, targetPosition)
    local args = { part = hitPart }
    local heavy = item.HeavyAttack
    local encoded = item.HeavyAttackEncoded
    local aiming = item.StartAiming
    local ok = false

    if type(encoded) == "function" then
        local utility = safeRequire(ReplicatedStorage.Modules.Utility)
        local a, b
        local encodeOK = utility and pcall(function()
            a = utility:EncodeCFrame(lookCF)
            b = utility:EncodeCFrame(lookCF)
        end)
        if encodeOK then ok = pcall(function() encoded(item, a, b, hitPart, args) end) end
    end
    if not ok and type(heavy) == "function" then
        ok = pcall(function() heavy(item, lookCF, lookCF, args) end)
    end
    if not ok and type(aiming) == "function" and type(heavy) == "function" then
        local aimOK = pcall(function() aiming(item, targetPosition) end)
        if aimOK then ok = pcall(function() heavy(item, targetPosition) end) end
    end
    if not ok then return false end

    state.backstabActive = self:IsBehindTarget(target)
    state.hitboxWindowUntil = now + 0.625
    state.attackCooldown = now + 1.25
    State.ShootLock.interval = math.max(0.06666666666666667, 0.06666666666666667 * math.clamp(math.floor(tonumber(Config.shootFrames) or 1), 1, 5))
    State.ShootLock.nextAt = now + State.ShootLock.interval
    return true
end

function Ragebot:PerformMeleeAttack(target, item)
    if not target or not item or not self:IsMelee(item) then return false end
    local hitPart = self:TargetPart(target)
    if not hitPart then return false end

    local now = os.clock()
    local state = State.Knife
    local isKnife = self:IsKnife(item)
    local cooldown = self:GetMeleeCooldown(item)

    if state.target ~= target or state.weapon ~= item then
        state.target, state.weapon = target, item
        state.hitboxWindowUntil = 0
        state.attackCooldown = 0
        state.backstabActive = false
    end
    if now < state.attackCooldown then return false end

    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local targetRoot = target:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or hitPart.Position
    local targetPosition = targetRoot and targetRoot.Position or hitPart.Position
    if (targetPosition - origin).Magnitude <= 0.001 then return false end

    local look = CFrame.lookAt(origin, targetPosition)
    local args = { part = hitPart }
    local heavy = item.HeavyAttack
    local heavyEncoded = item.HeavyAttackEncoded
    local aiming = item.StartAiming
    local success = false

    if type(heavyEncoded) == "function" then
        local utility = safeRequire(ReplicatedStorage.Modules.Utility)
        local a, b
        local ok = utility and pcall(function()
            a = utility:EncodeCFrame(look)
            b = utility:EncodeCFrame(look)
        end)
        if ok then
            success = pcall(function() heavyEncoded(item, a, b, hitPart, args) end)
        end
    end

    if not success and type(heavy) == "function" then
        success = pcall(function() heavy(item, look, look, args) end)
    end

    if not success and type(aiming) == "function" and type(heavy) == "function" then
        local aimOK = pcall(function() aiming(item, targetPosition) end)
        if aimOK then success = pcall(function() heavy(item, targetPosition) end) end
    end

    if not success then
        state.backstabActive = false
        return false
    end

    if isKnife then
        state.backstabActive = self:IsBehindTarget(target)
        state.hitboxWindowUntil = now + 0.625
        state.attackCooldown = now + math.max(1.25, cooldown)
    else
        state.backstabActive = false
        state.hitboxWindowUntil = now + math.min(0.625, cooldown)
        state.attackCooldown = now + cooldown
    end

    State.Planner.attackStart = nil
    State.Planner.lastAccepted = now
    State.Planner.shotLockUntil = now + State.ShootLock.interval
    State.ShootLock.nextAt = now + State.ShootLock.interval
    return true
end

function Ragebot:PerformRangedAttack(target, item)
    if not target or not item or self:IsMelee(item) then return false end
    if State.Reload.active then return false end

    local hitPart = self:TargetPart(target)
    if not hitPart then return false end

    local now = os.clock()
    if now < Config.nextAttack then return false end

    local plan = self:PlanKiciaPosition(target, item)
    if not plan then return false end
    local origin = plan.origin or hitPart.Position
    local aim = CFrame.lookAt(origin, plan.position or hitPart.Position)
    local utility = safeRequire(ReplicatedStorage.Modules.Utility)
    local encoded = nil

    if utility and utility.EncodeCFrame then
        pcall(function() encoded = utility:EncodeCFrame(aim) end)
    end

    local success = false
    if encoded and type(item.AttackEncoded) == "function" then
        success = pcall(function()
            item:AttackEncoded(encoded, encoded, hitPart, CFrame.lookAt)
        end)
    end

    if not success then
        pcall(function()
            if type(item.StartAiming) == "function" then item:StartAiming(hitPart.Position) end
            if type(item.StartShooting) == "function" then
                item:StartShooting(hitPart.Position)
                success = true
            end
        end)
    end

    if success then
        local frames = math.clamp(math.floor(tonumber(Config.shootFrames) or 1), 1, 5)
        local interval = 0.06666666666666667 * frames
        Config.nextAttack = now + interval
        State.Planner.attackStart = nil
        State.Planner.lastAccepted = now
        State.Planner.shotLockUntil = now + interval
        State.ShootLock.nextAt = now + interval
        State.ShootLock.interval = interval
        State.ShootLock.frames = frames
    end
    return success
end

function Ragebot:HandleEmpty(item)
    if not item or self:IsMelee(item) then return false end
    local ammo = tonumber(self:GetItemValue(item, "Ammo"))
    local reserve = tonumber(self:GetItemValue(item, "AmmoReserve"))
    if ammo == nil or ammo > 0 then return false end
    reserve = reserve or 0

    local current = self:WeaponCategory(item)
    local selected = self:SelectedWeapons()
    local selectedCount = 0
    for _, enabled in pairs(selected) do
        if enabled then selectedCount += 1 end
    end

    if selectedCount <= 1 then
        if reserve > 0 then return self:Reload(item) end
        return false
    end

    if Config.swapReload == "Reload, No Swap" then
        return reserve > 0 and self:Reload(item) or false
    end
    if Config.swapReload == "Swap, No Reload" then
        return self:EquipNext(current)
    end
    if Config.swapReload == "Swap & Reload" then
        if reserve > 0 and self:Reload(item) then return true end
        return self:EquipNext(current)
    end
    return false
end

function Ragebot:AutoShoot(target, item)
    if not Config.enabled or Config.mode ~= "Normal" then return false end
    if not target or not item then return false end
    if not self:ValidateTarget(target) then return false end
    if self:ShouldHoldForVoid() then return false end
    if not self:IsWeaponAllowed(item) then return false end

    self.Pipeline.lastAction = "none"
    self.Pipeline.shotIssued = false

    if not self:CanUse(item) then
        if self:HandleEmpty(item) then
            self.Pipeline.lastAction = "reload_or_swap"
        end
        return false
    end

    local plan = self:PrepareShoot(target, item)
    if not plan then return false end
    if not self:PlanReady(target, item) then
        self.Pipeline.lastAction = "hold"
        return false
    end

    local success = false
    if plan.knife then
        success = self:PerformKnifeAttack(target, item, plan)
    elseif plan.melee then
        success = self:PerformMeleeAttack(target, item)
    else
        success = self:PerformRangedAttack(target, item)
    end

    if not success then
        self.Pipeline.lastAction = "attack_failed"
        return false
    end

    self.Pipeline.lastAction = "shot"
    self.Pipeline.lastShot = os.clock()
    self.Pipeline.shotIssued = true
    self.Pipeline.vh.lastPhase = Config.voidState.phase

    if Config.void and Config.voidState.phase == "attack" then
        self:HideShot()
    end
    return true
end

function Ragebot:NormalStep()
    if not Config.enabled or Config.mode ~= "Normal" then return end
    self:UpdateReload()

    local item = self:GetEquipped()
    if not item then
        self.Pipeline.lastAction = "equip"
        self:EquipNext()
        return
    end

    if not self:IsWeaponAllowed(item) then
        self.Pipeline.lastAction = "swap"
        self:EquipNext(self:WeaponCategory(item))
        return
    end

    local target = self:RefreshTarget()
    if not target then
        self.Pipeline.lastAction = "no_target"
        return
    end

    self:AutoShoot(target, item)
end

function Ragebot:StartTranslocate()
    if Config.translocate.active then return end
    Config.translocate.active = true
    Config.translocate.connection = RunService.Heartbeat:Connect(function()
        if not Config.enabled or Config.mode ~= "Translocate" then return end
        pcall(function()
            local target = self:RefreshTarget()
            local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
            if root and targetRoot then
                root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -3)
            end
        end)
    end)
end

function Ragebot:StopTranslocate()
    if Config.translocate.connection then
        pcall(function() Config.translocate.connection:Disconnect() end)
    end
    Config.translocate.connection = nil
    Config.translocate.active = false
end

function Ragebot:PurgeCSyncState()
    local csync = self.Pipeline.csync
    csync.active = false
    csync.clientCFrame = nil
    csync.serverCFrame = nil
    csync.serverPosition = nil
end

function Ragebot:UpdateVoid()
    if not Config.enabled or not Config.void then
        Config.voidState.phase = nil
        Config.voidState.phaseStarted = 0
        State.Void.lastPhase = nil
        self.Pipeline.shotIssued = false
        self:StopVH(false)
        self:PurgeCSyncState()
        VoidSpam:SetEnabled(false)
        return false
    end

    local now = os.clock()
    if not Config.voidState.phase then
        Config.voidState.phase = "hide"
        Config.voidState.phaseStarted = now
        State.Void.lastPhase = "hide"
        State.Void.phaseStarted = now
        VoidSpam:SetEnabled(true)
        return true
    end

    local phase = Config.voidState.phase
    local duration = phase == "hide"
        and math.clamp(tonumber(Config.hide) or 0.5, 0.1, 1)
        or math.clamp(tonumber(Config.attack) or 0.5, 0.1, 2)

    if now - Config.voidState.phaseStarted < duration then
        return phase == "hide"
    end

    if phase == "hide" then
        VoidSpam:SetEnabled(false)
        self:StopVH(false)
        self.Pipeline.vh.lastPhase = "attack"
        Config.voidState.phase = "attack"
        State.Void.lastPhase = "attack"
    else
        VoidSpam:SetEnabled(true)
        self:StartVH()
        Config.voidState.phase = "hide"
        State.Void.lastPhase = "hide"
    end

    Config.voidState.phaseStarted = now
    State.Void.phaseStarted = now
    self:ResetPlanner()
    return Config.voidState.phase == "hide"
end

function Ragebot:SetMode(mode)
    local nextMode = mode == "Translocate" and "Translocate" or "Normal"
    if Config.mode == nextMode then return end
    self:StopTranslocate()
    self:ResetTarget()
    self:ResetPlanner()
    Config.mode = nextMode
    Config.voidState.phase = nil
    Config.voidState.phaseStarted = 0
    VoidSpam:SetEnabled(false)
    if Config.enabled and nextMode == "Translocate" then self:StartTranslocate() end
    self:RefreshDesyncFromUI()
end

function Ragebot:SetEnabled(value)
    Config.enabled = value == true
    if not Config.enabled then
        self:StopTranslocate()
        VoidSpam:SetEnabled(false)
        Config.void = false
        Config.voidState.phase = nil
        Config.target = nil
        self:ResetTarget()
        self:ResetPlanner()
        State.Reload.active = false
        self.Pipeline.shotIssued = false
        self:StopVH(true)
        self:StopCSync()
        self:PurgeCSyncState()
        self:SetDesync(false)
        return
    end
    self:RefreshDesyncFromUI()
    if Config.mode == "Translocate" then self:StartTranslocate() end
end

function Ragebot:SetWeapons(value)
    local selected = { primary = false, secondary = false, melee = false }
    if type(value) == "table" then
        selected.primary = value.primary == true or value.Primary == true
        selected.secondary = value.secondary == true or value.Secondary == true
        selected.melee = value.melee == true or value.Melee == true
    end
    if selected.secondary then
        selected.primary = false
        selected.melee = false
    elseif not selected.primary and not selected.melee then
        selected.primary = true
    end
    Config.weapons = selected
    self:ResetTarget()
    self:ResetPlanner()
end

local desyncRefreshAt = 0

Ragebot.Connection = RunService.Heartbeat:Connect(function()
    pcall(function()
        if not Config.enabled then return end
        Ragebot:StartCSync()
        if os.clock() - desyncRefreshAt >= 0.25 then
            desyncRefreshAt = os.clock()
            Ragebot:RefreshDesyncFromUI()
        end
        Ragebot:UpdateCSync()
        Ragebot:UpdateStatus()
        local hiding = Ragebot:UpdateVoid()
        if Config.mode == "Translocate" then
            if not Config.translocate.active then Ragebot:StartTranslocate() end
            return
        end
        if Config.translocate.active then Ragebot:StopTranslocate() end
        if not hiding then Ragebot:NormalStep() end
    end)
end)

