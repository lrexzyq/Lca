function Ragebot:GetPingSeconds()
    local ping = 0
    pcall(function()
        local Stats = game:GetService("Stats")
        ping = (Stats.Network.ServerStatsItem["Data Ping"]:GetValue() or 0) / 1000
    end)
    return math.max(0, ping)
end

function Ragebot:PredictPosition(part, origin)
    if not part then return nil end
    local base = part.Position
    local velocity = part.AssemblyLinearVelocity
    if velocity.Magnitude > 500 then return base end
    local distance = (base - origin).Magnitude
    local travel = distance / 3000
    local multiplier = math.max(0, tonumber(self.Pipeline.prediction.multiplier) or 1)
    local scale = tonumber(self.Pipeline.prediction.velocityScale) or 1
    local lead = (travel + self:GetPingSeconds()) * multiplier
    return base + velocity * lead * scale
end

function Ragebot:GetAttackOrigin()
    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local csync = self.Pipeline.csync
    local vh = self.Pipeline.vh
    if vh.active and csync.serverPosition then
        return csync.serverPosition
    end
    if csync.active and csync.serverPosition then
        return csync.serverPosition
    end
    return root.Position
end

function Ragebot:PlanKiciaPosition(target, item)
    if not target or not item then return nil end
    local part = self:TargetPart(target)
    local origin = self:GetAttackOrigin()
    if not part or not origin then return nil end
    local predicted = self:PredictPosition(part, origin) or part.Position
    local position = predicted
    if self:IsMelee(item) then
        local targetRoot = target:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            position = targetRoot.Position
        end
    end
    local distance = (position - origin).Magnitude
    return {
        target = target,
        item = item,
        part = part,
        origin = origin,
        position = position,
        predictedPosition = predicted,
        distance = distance,
        melee = self:IsMelee(item),
        knife = self:IsKnife(item),
    }
end

