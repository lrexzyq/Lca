    vh.snapshot.linear = root and root.AssemblyLinearVelocity or nil
    vh.snapshot.angular = root and root.AssemblyAngularVelocity or nil
    vh.currentVoidPos = self:GetServerPosition()
    vh.phaseStarted = os.clock()
    vh.active = true
    vh.lastPhase = "hide"
    if vh.connection then return end
    vh.connection = RunService.RenderStepped:Connect(function()
        if not Config.enabled or not vh.active then return end
        self:UpdateCSync()
        vh.currentVoidPos = self:GetServerPosition()
