Ragebot.CharacterCache = { characters = {}, duelCache = {}, priorities = {}, voidedPlayers = {}, connections = {}, initialized = false }
Ragebot.Status = { enabled = false, text = "", weapon = nil, target = nil, phase = "idle", lastUpdate = 0 }

function Ragebot:TrackCharacters()
    if self.CharacterCache.initialized then return end
    self.CharacterCache.initialized = true
    local cache = self.CharacterCache
    local function remove(player)
        cache.characters[player] = nil
        cache.duelCache[player] = nil
        cache.priorities[player] = nil
        cache.voidedPlayers[player] = nil
    end
    local function add(player, character)
        cache.characters[player] = character
        cache.duelCache[player] = character
    end
    local function hook(player)
        if player.Character then add(player, player.Character) end
        table.insert(cache.connections, player.CharacterAdded:Connect(function(character) add(player, character) end))
        table.insert(cache.connections, player.CharacterRemoving:Connect(function() remove(player) end))
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp then hook(player) end
    end
    table.insert(cache.connections, Players.PlayerAdded:Connect(function(player)
        if player ~= lp then hook(player) end
    end))
    table.insert(cache.connections, Players.PlayerRemoving:Connect(remove))
end

function Ragebot:StopCharacterTracking()
    local cache = self.CharacterCache
    for _, connection in ipairs(cache.connections) do pcall(function() connection:Disconnect() end) end
    cache.connections = {}
    cache.characters = {}
    cache.duelCache = {}
    cache.initialized = false
end

function Ragebot:SetPriority(player, level)
    if player and player ~= lp then self.CharacterCache.priorities[player] = tonumber(level) or 0 end
end

function Ragebot:ClearPriority(player)
    self.CharacterCache.priorities[player] = nil
end

function Ragebot:MarkVoided(player, value)
    if not player then return end
    if value then self.CharacterCache.voidedPlayers[player] = true else self.CharacterCache.voidedPlayers[player] = nil end
end

function Ragebot:ValidateTarget(character)
    if not character or not character.Parent then return false end
    if not self:TargetAlive(character) then return false end
    if not character:FindFirstChild("HumanoidRootPart") then return false end
    local player = Players:GetPlayerFromCharacter(character)
    if not player or player == lp then return false end
    if player:GetAttribute("EnvironmentID") ~= lp:GetAttribute("EnvironmentID") then return false end
    if player:GetAttribute("TeamID") ~= nil and lp:GetAttribute("TeamID") ~= nil and player:GetAttribute("TeamID") == lp:GetAttribute("TeamID") then return false end
    if character:FindFirstChild("_is_ally") and character._is_ally.Value == true then return false end
    return true
end

function Ragebot:GetPriorityTarget()
    local camera = Workspace.CurrentCamera
    local origin = camera and camera.CFrame.Position
    if not origin then return nil end
    local cache = self.CharacterCache
    local best, bestScore
    for player, character in pairs(cache.characters) do
        if self:ValidateTarget(character) then
            local part = self:TargetPart(character)
            if part then
                local distance = (part.Position - origin).Magnitude
                local priority = cache.priorities[player] or 0
                local voidBoost = cache.voidedPlayers[player] and 10000 or 0
                local score = distance - priority * 100 - voidBoost
                if bestScore == nil or score < bestScore then
                    best, bestScore = character, score
                end
            end
        end
    end
    return best
end

function Ragebot:UpdateStatus()
    local now = os.clock()
    if now - self.Status.lastUpdate < 0.1 then return end
    self.Status.lastUpdate = now
    self.Status.enabled = Config.enabled
    self.Status.target = Config.target
    if not Config.enabled then self.Status.text = "" return end
    local item = self:GetEquipped()
    self.Status.weapon = item and self:GetWeaponName(item) or nil
    if Config.void then
        self.Status.phase = Config.voidState.phase or "hide"
        self.Status.text = "ragebot: " .. self.Status.phase
    elseif item then
        self.Status.phase = Config.mode:lower()
        self.Status.text = "ragebot: " .. tostring(self.Status.weapon or "unknown")
    else
        self.Status.phase = Config.mode:lower()
        self.Status.text = "ragebot: no weapon"
    end
end

