local function applyMeleeAnimation()
    task.spawn(function()
        local ok, Melee = pcall(function() return require(lp.PlayerScripts.Modules.ItemTypes.Melee) end)
        if not ok or not Melee then return end
        if WeaponModOriginals.Melee.StartShooting == nil and Melee.StartShooting then
            WeaponModOriginals.Melee.StartShooting = Melee.StartShooting
        end
        if ModSettings.NoMeleeAnimation and Melee.StartShooting and not WeaponModOriginals.Melee.Wrapped then
            local old = WeaponModOriginals.Melee.StartShooting
            Melee.StartShooting = function(self, p1, p2)
                local vm = self.ViewModel
                local savedPlay
                if vm then savedPlay = vm.PlayAnimation; vm.PlayAnimation = function() end end
                local result = { old(self, p1, p2) }
                if vm and savedPlay then
                    vm.PlayAnimation = savedPlay
                    pcall(function()
                        for _, name in ipairs({"Attack", "Attack1", "Attack2", "Swing", "Slash", "Combo1", "Combo2", "Combo3"}) do
                            vm:StopAnimation(name)
                        end
                    end)
                end
                return table.unpack(result)
            end
            WeaponModOriginals.Melee.Wrapped = true
        elseif not ModSettings.NoMeleeAnimation and WeaponModOriginals.Melee.StartShooting then
            Melee.StartShooting = WeaponModOriginals.Melee.StartShooting
            WeaponModOriginals.Melee.Wrapped = false
        end
    end)
end

