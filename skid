        if WeaponModOriginals.Gun.StartShooting == nil and Gun.StartShooting then WeaponModOriginals.Gun.StartShooting = Gun.StartShooting end
        if WeaponModOriginals.Gun.FinishShooting == nil and Gun.FinishShooting then WeaponModOriginals.Gun.FinishShooting = Gun.FinishShooting end
        if WeaponModOriginals.Gun.ShootBurst == nil and Gun.ShootBurst then WeaponModOriginals.Gun.ShootBurst = Gun.ShootBurst end
        if ModSettings.NoShootAnimation then
            if Gun.StartShooting and WeaponModOriginals.Gun.StartShooting then
                Gun.StartShooting = function(self, p1, p2)
                    local vm = self.ViewModel; local savedPlay
                    if vm then savedPlay = vm.PlayAnimation; vm.PlayAnimation = function() end end
                    local result = { WeaponModOriginals.Gun.StartShooting(self, p1, p2) }
                    if vm and savedPlay then
                        vm.PlayAnimation = savedPlay
                        pcall(function()
                            for _, name in ipairs({"Shoot","Fire","ShootBurst","Shoot_ADS","ShootHip","ShootEmpty","ShootADS","Burst"}) do vm:StopAnimation(name) end
                        end)
                    end
                    return table.unpack(result)
                end
            end
