local RAND_MAX = 2147483646
local RAND_MIN = -2147483646
local RAND_EX_MIN = -1147483646
local RAND_EX_MAX = 1147483646

local function safeRandom(minimum, maximum, excludeMinimum, excludeMaximum)
    local value
    repeat
        value = math.random(minimum, maximum)
    until value < excludeMinimum or value > excludeMaximum
    return value
end

VoidSpam = (function()
    local self = { enabled = false, connection = nil, root = nil, savedCFrame = nil, savedVelocity = nil, savedAngular = nil }

    function self:SetEnabled(value)
        local enabled = value == true
        if enabled == self.enabled then return end

        self.enabled = enabled
        if enabled then
            if self.connection then return end
            self.connection = RunService.Heartbeat:Connect(function()
                if not self.enabled then return end
                pcall(function()
                    local character = lp.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    if not root then
                        self.root = nil
                        self.savedCFrame = nil
                        self.savedVelocity = nil
                        self.savedAngular = nil
                        return
                    end
                    if self.root ~= root then
                        self.root = root
                        self.savedCFrame = root.CFrame
                        self.savedVelocity = root.AssemblyLinearVelocity
                        self.savedAngular = root.AssemblyAngularVelocity
                    end
                    root.CFrame = CFrame.new(
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX),
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX),
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX)
                    ) * CFrame.Angles(math.pi, math.pi, math.pi)
                    root.AssemblyLinearVelocity = Vector3.new(
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX),
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX),
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX)
                    )
                    root.AssemblyAngularVelocity = Vector3.new(
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX),
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX),
                        safeRandom(RAND_MIN, RAND_MAX, RAND_EX_MIN, RAND_EX_MAX)
                    )
                end)
            end)
            return
        end

        if self.connection then
            pcall(function() self.connection:Disconnect() end)
        end
        self.connection = nil
        if self.root and self.savedCFrame then
            pcall(function()
                self.root.CFrame = self.savedCFrame
                self.root.AssemblyLinearVelocity = self.savedVelocity or Vector3.zero
                self.root.AssemblyAngularVelocity = self.savedAngular or Vector3.zero
            end)
        end
        self.root = nil
        self.savedCFrame = nil
        self.savedVelocity = nil
        self.savedAngular = nil
    end

    return self
end)()

Ragebot.Desync = {
    enabled = false,
    connection = nil,
    originalCFrame = nil,
    root = nil,
}

function Ragebot:SetDesync(enabled)
    local state = self.Desync
    local value = enabled == true
    if state.enabled == value then return end
    state.enabled = value

    if not value then
        if state.connection then
            pcall(function() state.connection:Disconnect() end)
        end
        state.connection = nil
        if state.root and state.originalCFrame then
            pcall(function()
                if state.root.Parent then
                    state.root.CFrame = state.originalCFrame
                end
            end)
        end
        state.root = nil
        state.originalCFrame = nil
        return
    end

    if state.connection then return end
    state.connection = RunService.RenderStepped:Connect(function()
        if not self.Config.enabled or not state.enabled then return end
        pcall(function()
            local character = lp.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if not root then
                state.root = nil
                state.originalCFrame = nil
                return
            end
            if state.root ~= root then
                state.root = root
                state.originalCFrame = root.CFrame
            end

            local settings = self.DesyncSettings
            local pitch = tonumber(settings.pitch) or 0
            local yaw = tonumber(settings.yaw) or 0
            local customPitch = tonumber(settings.customPitch) or 0
            local customYaw = tonumber(settings.customYaw) or 0
            pcall(function()
                if Options.anti_aim_pitch then pitch = tonumber(Options.anti_aim_pitch.Value) or pitch end
                if Options.anti_aim_yaw then yaw = tonumber(Options.anti_aim_yaw.Value) or yaw end
                if Options.anti_aim_custom_pitch then customPitch = tonumber(Options.anti_aim_custom_pitch.Value) or customPitch end
                if Options.anti_aim_custom_yaw then customYaw = tonumber(Options.anti_aim_custom_yaw.Value) or customYaw end
            end)
            local rep = character:FindFirstChild("PhysicsRepRootPart") or root
            local base = root.CFrame
            local desyncCFrame = CFrame.new(base.Position)
                * CFrame.Angles(0, math.rad(yaw + customYaw), 0)
                * CFrame.Angles(math.rad(pitch + customPitch), 0, 0)

            if rep and rep ~= root then
                rep.CFrame = desyncCFrame
            end
        end)
    end)
end

function Ragebot:RefreshDesyncFromUI()
    local antiAimEnabled = self.DesyncSettings.enabled == true
    pcall(function()
        local toggle = Toggles.anti_aim_enabled
        if toggle then antiAimEnabled = toggle.Value == true end
    end)
    self:SetDesync(antiAimEnabled)
