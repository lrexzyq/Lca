local function ugCaptureSnapshot()
    local char = ugGetCharacter()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hrp then return false end
    local camera = Workspace.CurrentCamera
    local snap = {
        character = char,
        pivot = char:GetPivot(),
        camera = camera and camera.CFrame or nil,
        hrpCFrame = hrp.CFrame,
        hrpVelocity = hrp.AssemblyLinearVelocity,
        hrpAngularVelocity = hrp.AssemblyAngularVelocity,
        humanoidState = nil,
        humanoidAutoRotate = nil,
        parts = {},
        joints = {},
    }
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() snap.humanoidState = hum:GetState() end)
        pcall(function() snap.humanoidAutoRotate = hum.AutoRotate end)
    end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            snap.parts[obj] = {
                cframe = obj.CFrame,
                velocity = obj.AssemblyLinearVelocity,
                angularVelocity = obj.AssemblyAngularVelocity,
                anchored = obj.Anchored,
                collide = obj.CanCollide,
                touch = obj.CanTouch,
                query = obj.CanQuery,
            }
        elseif obj:IsA("Motor6D") then
            snap.joints[obj] = {
                transform = obj.Transform,
                c0 = obj.C0,
                c1 = obj.C1,
                part0 = obj.Part0,
                part1 = obj.Part1,
            }
        elseif obj:IsA("Weld") then
            snap.joints[obj] = {
                c0 = obj.C0,
                c1 = obj.C1,
                part0 = obj.Part0,
                part1 = obj.Part1,
            }
        end
    end
    undergroundSnapshot = snap
    undergroundSnapshotCharacter = char
    undergroundOldCF = snap.hrpCFrame
    undergroundOldVel = snap.hrpVelocity
    undergroundOldAngVel = snap.hrpAngularVelocity
    undergroundOldCamCF = snap.camera
    undergroundOldAnchored = hrp.Anchored
    undergroundOldRootPart0 = nil
    undergroundFirstRun = false
    return true
end

local function ugRestoreSnapshot()
    local snap = undergroundSnapshot
    local char = ugGetCharacter()
    if not snap or not char or snap.character ~= char then
        return false
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    pcall(function() char:PivotTo(snap.pivot) end)

    for joint, state in pairs(snap.joints) do
        if joint and joint.Parent then
            pcall(function()
                if state.part0 then joint.Part0 = state.part0 end
                if state.part1 then joint.Part1 = state.part1 end
                if state.c0 then joint.C0 = state.c0 end
                if state.c1 then joint.C1 = state.c1 end
                if state.transform and joint:IsA("Motor6D") then joint.Transform = state.transform end
            end)
        end
    end

    for part, state in pairs(snap.parts) do
        if part and part.Parent then
            pcall(function()
                part.CFrame = state.cframe
                part.AssemblyLinearVelocity = state.velocity
                part.AssemblyAngularVelocity = state.angularVelocity
                part.Anchored = state.anchored
                part.CanCollide = state.collide
                part.CanTouch = state.touch
                part.CanQuery = state.query
            end)
        end
    end

    pcall(function()
        hrp.CFrame = snap.hrpCFrame
        hrp.AssemblyLinearVelocity = snap.hrpVelocity
        hrp.AssemblyAngularVelocity = snap.hrpAngularVelocity
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if snap.humanoidAutoRotate ~= nil then
                hum.AutoRotate = snap.humanoidAutoRotate
            end
            if snap.humanoidState then
                pcall(function() hum:ChangeState(snap.humanoidState) end)
            end
        end
    end)

    pcall(function()
        local camera = Workspace.CurrentCamera
        if camera and snap.camera then camera.CFrame = snap.camera end
    end)

    return true
end

local function ugStartRestoreWindow()
    if undergroundRestoreConn then
        undergroundRestoreConn:Disconnect()
        undergroundRestoreConn = nil
    end
    local remaining = 12
    undergroundRestoreConn = RunService.Heartbeat:Connect(function()
        if ugRestoreSnapshot() then
            remaining = remaining - 1
            if remaining <= 0 then
                undergroundRestoreConn:Disconnect()
                undergroundRestoreConn = nil
                undergroundSnapshot = nil
                undergroundSnapshotCharacter = nil
            end
        else
            undergroundRestoreConn:Disconnect()
            undergroundRestoreConn = nil
            undergroundSnapshot = nil
            undergroundSnapshotCharacter = nil
        end
    end)
end

local function ugSafeTeleport(hrp)
    if not hrp then return end
    local pos = hrp.Position
    local minY = undergroundFallHeight + undergroundSafeBuffer + 50
    if pos.Y < minY then
        pcall(function()
            hrp.CFrame = CFrame.new(pos.X, minY, pos.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

startUnderground = function()
    if undergroundConn then return end
    if undergroundRestoreConn then
        undergroundRestoreConn:Disconnect()
        undergroundRestoreConn = nil
    end
    if not ugCaptureSnapshot() then
        undergroundEnabled = false
        return
    end
    pcall(function() RunService:UnbindFromRenderStep("UndergroundSync") end)
    pcall(function() RunService:UnbindFromRenderStep("UndergroundSync2") end)
    pcall(function() RunService:UnbindFromRenderStep("UndergroundSync3") end)
    undergroundEnabled = true
    undergroundTick = 0
    undergroundChaosSeed = math.random(1, 1e9)
    ugUpdateFallHeight()
    ugCollectRemotes()

    undergroundConn = RunService.Heartbeat:Connect(function(dt)
        if not undergroundEnabled then return end
        undergroundTick = undergroundTick + dt
        pcall(function()
            local char = ugGetCharacter()
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hrp or char ~= undergroundSnapshotCharacter then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
            end
            undergroundRealCF = hrp.CFrame
            undergroundRealVel = hrp.AssemblyLinearVelocity
            undergroundRealAngVel = hrp.AssemblyAngularVelocity
            local fakeY = ugComputeFakeY(hrp, char)
            local chaos1 = math.sin(undergroundTick * 180 + undergroundChaosSeed) * 100
            local chaos2 = math.cos(undergroundTick * 220 + undergroundChaosSeed) * 100
            hrp.CFrame = CFrame.new(hrp.Position.X + chaos1, fakeY, hrp.Position.Z + chaos2)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end)

    undergroundSteppedConn = RunService.Stepped:Connect(function()
        if not undergroundEnabled then return end
        pcall(function()
            local char = ugGetCharacter()
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hrp or char ~= undergroundSnapshotCharacter then return end
            local fakeY = ugClampY(ugComputeFakeY(hrp, char))
            hrp.CFrame = CFrame.new(hrp.Position.X, fakeY, hrp.Position.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end)

    undergroundRenderConn = RunService:BindToRenderStep("UndergroundSync", Enum.RenderPriority.First.Value, function()
        if undergroundEnabled and undergroundRealCF then
            pcall(function()
                local hrp = ugGetHrp()
                if not hrp or lp.Character ~= undergroundSnapshotCharacter then return end
                hrp.CFrame = undergroundRealCF
                hrp.AssemblyLinearVelocity = undergroundRealVel or Vector3.zero
                hrp.AssemblyAngularVelocity = undergroundRealAngVel or Vector3.zero
            end)
        end
    end)

    undergroundRenderConn2 = RunService:BindToRenderStep("UndergroundSync2", Enum.RenderPriority.Camera.Value, function()
        if not undergroundEnabled then return end
        pcall(function()
            local hrp = ugGetHrp()
            if hrp and undergroundSnapshotCharacter == lp.Character then
                hrp.CFrame = CFrame.new(hrp.Position.X, ugClampY(ugComputeFakeY(hrp, lp.Character)), hrp.Position.Z)
            end
        end)
    end)

    undergroundRenderConn3 = RunService:BindToRenderStep("UndergroundSync3", Enum.RenderPriority.Last.Value, function()
        if not undergroundEnabled then return end
        pcall(function()
            local hrp = ugGetHrp()
            if not hrp or undergroundSnapshotCharacter ~= lp.Character then return end
            local pos = hrp.Position
            hrp.CFrame = CFrame.new(pos.X, ugClampY(pos.Y), pos.Z)
        end)
    end)

    undergroundOwnershipConn = RunService.Heartbeat:Connect(function()
        if not undergroundEnabled then return end
        pcall(function()
            local hrp = ugGetHrp()
            if hrp and undergroundSnapshotCharacter == lp.Character and math.random() < 0.05 then
                pcall(function() hrp:SetNetworkOwner(lp) end)
            end
        end)
    end)

    undergroundJointConn = RunService.Heartbeat:Connect(function()
        if not undergroundEnabled then return end
    end)

    undergroundRemoteConn = nil
    undergroundPhysicsConn = RunService.Heartbeat:Connect(function()
        if not undergroundEnabled then return end
        pcall(function()
            local char = ugGetCharacter()
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hrp or undergroundSnapshotCharacter ~= char then return end
            ugCleanupForces()
        end)
    end)

    undergroundSafeConn = RunService.Heartbeat:Connect(function()
        if not undergroundEnabled then return end
        ugUpdateFallHeight()
        pcall(function()
            local char = ugGetCharacter()
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hrp or undergroundSnapshotCharacter ~= char then return end
            ugSafeTeleport(hrp)
        end)
    end)
end

stopUnderground = function()
    undergroundEnabled = false
    if undergroundConn then undergroundConn:Disconnect() undergroundConn = nil end
    if undergroundSteppedConn then undergroundSteppedConn:Disconnect() undergroundSteppedConn = nil end
    if undergroundOwnershipConn then undergroundOwnershipConn:Disconnect() undergroundOwnershipConn = nil end
    if undergroundJointConn then undergroundJointConn:Disconnect() undergroundJointConn = nil end
    if undergroundPhysicsConn then undergroundPhysicsConn:Disconnect() undergroundPhysicsConn = nil end
    if undergroundSafeConn then undergroundSafeConn:Disconnect() undergroundSafeConn = nil end
    pcall(function() RunService:UnbindFromRenderStep("UndergroundSync") end)
    pcall(function() RunService:UnbindFromRenderStep("UndergroundSync2") end)
    pcall(function() RunService:UnbindFromRenderStep("UndergroundSync3") end)
    undergroundRenderConn = nil
    undergroundRenderConn2 = nil
    undergroundRenderConn3 = nil
    if undergroundRemoteConn then pcall(function() task.cancel(undergroundRemoteConn) end) undergroundRemoteConn = nil end
    if undergroundFloodConn then pcall(function() task.cancel(undergroundFloodConn) end) undergroundFloodConn = nil end
    if undergroundRestoreConn then undergroundRestoreConn:Disconnect() undergroundRestoreConn = nil end
    ugCleanupForces()

    local restored = ugRestoreSnapshot()
    if restored then
        ugStartRestoreWindow()
    else
        local char = ugGetCharacter()
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and undergroundRealCF then
            pcall(function()
                hrp.CFrame = undergroundRealCF
                hrp.AssemblyLinearVelocity = undergroundRealVel or Vector3.zero
                hrp.AssemblyAngularVelocity = undergroundRealAngVel or Vector3.zero
            end)
        end
    end

    undergroundRemoteList = {}
    undergroundRealCF = nil
    undergroundRealVel = nil
    undergroundRealAngVel = nil
    undergroundOldCF = nil
    undergroundOldVel = nil
    undergroundOldAngVel = nil
    undergroundOldCamCF = nil
    undergroundOldAnchored = nil
    undergroundOldRootPart0 = nil
    undergroundFirstRun = true
end

