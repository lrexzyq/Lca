local function ugClampY(y)
    local minY = undergroundFallHeight + undergroundSafeBuffer
    if y < minY then return minY end
    return y
end

local function ugComputeFakeY(hrp, char)
    local depth = math.clamp(tonumber(undergroundDepth) or 2.5, -15, 30)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { char }
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), params)
    local fakeY = result and (result.Position.Y - depth) or (hrp.Position.Y - depth)
    return ugClampY(fakeY)
end

local function ugCollectRemotes()
    undergroundRemoteList = {}
    local seen = {}
    local function scan(container)
        if not container then return end
        for _, obj in ipairs(container:GetDescendants()) do
            if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent")) and not seen[obj] then
                seen[obj] = true
                table.insert(undergroundRemoteList, obj)
            end
        end
    end
    pcall(scan, game:GetService("ReplicatedStorage"))
end

