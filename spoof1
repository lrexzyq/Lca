SkyboxSection:Toggle({
    Name = "Auto Rotate", Flag = "skybox_rotate", Default = false,
    Callback = function(v)
        skyboxData.auto_rotate = v
        if v then
            if skyboxConn then skyboxConn:Disconnect() end
            skyboxConn = RunService.RenderStepped:Connect(function(dt)
                if not skyboxData.enabled or not skyboxData.auto_rotate then return end
                local sky = EnsureSky()
                if sky then
                    sky.SkyboxOrientation = Vector3.new(0, (sky.SkyboxOrientation.Y + skyboxData.rotate_speed * dt) % 360, 0)
                end
            end)
        else
            if skyboxConn then skyboxConn:Disconnect(); skyboxConn = nil end
        end
    end
})
