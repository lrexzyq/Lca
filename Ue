SilentAim.__index = SilentAim

local FONT_NAMES = {
    "monocraft",
    "monocraft bold",
    "ubuntu",
    "tahoma",
    "proggy clean",
    "proggy tiny",
    "pixel arial",
    "smallest pixel",
}

