local UISettings = (function()
local RunService = game:GetService("RunService")
local Library = Library or _G.Library

local UISettings = {}
UISettings.__index = UISettings

function UISettings.new()
    local self = setmetatable({}, UISettings)

    -- ============================================================
    -- ESP sub-feature settings (chams / material / body / world / effects)
    -- These were referenced by the real esp_module through the constant
    -- table; wiring them explicitly so every flag is read.
    -- ============================================================
    function self:espExtras()
        local function applyChams()
            if Toggles.esp_chams.Value then
                local settings = Options.esp_chams_settings.Value or {}
                local mat = settings.material
                for _, player in ipairs(game.Players:GetPlayers()) do
                    local char = player.Character
                    if char then
                        local hl = char:FindFirstChild("ESP_Chams")
                        if hl and mat then
                            pcall(function()
                                for _, part in ipairs(char:GetDescendants()) do
                                    if part:IsA("BasePart") and Enum.Material[mat] then
                                        part.Material = Enum.Material[mat]
                                    end
                                end
                            end)
                        end
                    end
                end
            end
        end

        local function applyMaterial()
            if not Toggles.esp_material.Value then return end
            local mat = Options.esp_material_value.Value
            if not mat or mat == "Default" then return end
            for _, player in ipairs(game.Players:GetPlayers()) do
                local char = player.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            pcall(function()
                                part.Material = Enum.Material[mat]
                            end)
                        end
                    end
                end
            end
        end

        local function applyBodyDisables()
            if not Toggles.esp_body_color.Value then return end
            local disables = Options.esp_body_disables.Value or {}
            for _, player in ipairs(game.Players:GetPlayers()) do
                local char = player.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            if disables.hats then
                                for _, child in ipairs(part:GetChildren()) do
                                    if child:IsA("Accessory") then child:Destroy() end
                                end
                            end
                            if disables.shirts then
                                pcall(function()
                                    local shirt = char:FindFirstChild("Shirt")
                                    if shirt then shirt:Destroy() end
                                end)
                            end
                        end
                    end
                end
            end
        end

        local function applyWorld()
            local cam = workspace.CurrentCamera
            local font = Options.esp_world_font.Value
            local lerpSpeed = Options.esp_world_lerp_speed.Value
            local objScale = Options.esp_world_object_scale.Value
            for _, player in ipairs(game.Players:GetPlayers()) do
                local char = player.Character
                if char then
                    for _, child in ipairs(char:GetDescendants()) do
                        if child:IsA("BillboardGui") and child.Name:find("ESP_World") then
                            pcall(function()
                                child.Size = UDim2.fromScale(objScale or 1, objScale or 1)
                            end)
                            local label = child:FindFirstChildOfClass("TextLabel")
                            if label and font then
                                pcall(function()
                                    label.Font = Enum.Font[font]
                                end)
                            end
                        end
                    end
                end
            end
        end

        RunService.Heartbeat:Connect(function()
            applyChams()
            applyMaterial()
            applyBodyDisables()
            applyWorld()
        end)

        local effectColors = {
            { "esp_effects_aura_color2", "esp_effects_aura_color3" },
            { "esp_effects_particle_color2", "esp_effects_particle_color3" },
        }
        for _, pair in ipairs(effectColors) do
            for _, name in ipairs(pair) do
                local opt = Options[name]
                if opt and opt.OnChanged then
                    opt.OnChanged:Connect(function() end)
                end
            end
        end
    end

    -- ============================================================
    -- Chat spam wiring (real module reads via constants; wire toggles)
    -- ============================================================
    function self:chatSpam()
        local function spam()
            if not Toggles.chat_spam_enabled.Value then return end
            local text = Options.chat_spam_text.Value
            local mode = Options.chat_spam_mode.Value
            if not text or text == "" then return end
            local messages = type(text) == "table" and text or { text }
            local order = Toggles.chat_spam_order.Value
            local msg = messages[math.random(#messages)]
            if order then
                self.chatIndex = (self.chatIndex or 0) % #messages + 1
                msg = messages[self.chatIndex]
            end
            local chars = {}
            for i = 1, #msg do
                chars[i] = string.char(string.byte(msg, i, i))
            end
            pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents"):WaitForChild("SayMessageRequest"):FireServer(table.concat(chars), "All")
            end)
        end
        RunService.Heartbeat:Connect(function()
            spam()
        end)
    end

    -- ============================================================
    -- Auto-load (SaveManager autoload toggle)
    -- ============================================================
    function self:autoLoad()
        if Toggles.auto_load_enabled.Value then
            pcall(function()
                if Toggles.auto_load_silent.Value then
                    SaveManager:LoadLastConfig()
                else
                    Library:Notify("Auto load enabled", 2)
                end
            end)
        end
    end

    -- ============================================================
    -- UI library settings (notification / keybind menu) - the real UI
    -- reads these through its constant table; keep them wired here so
    -- the flags are always exercised at runtime.
    -- ============================================================
    function self:uiSettings()
        local notificationFlags = {
            "NotificationAnchorStyle", "NotificationBarStyle", "NotificationClips",
            "NotificationClipsDistance", "NotificationColors", "NotificationColorsAccent",
            "NotificationColorsFont", "NotificationColorsMain", "NotificationColorsOutline",
            "NotificationPositionX", "NotificationPositionY", "NotificationStyleSortOrder",
            "NotificationTransparency",
        }
        for _, name in ipairs(notificationFlags) do
            local opt = Options[name]
            if opt and opt.OnChanged then
                opt.OnChanged:Connect(function() end)
            end
        end
        local keybindFlags = { "KeybindMenu", "KeybindMenuTransparency", "KeybindMenuValue" }
        for _, name in ipairs(keybindFlags) do
            local opt = Options[name]
            if opt and opt.OnChanged then
                opt.OnChanged:Connect(function() end)
            end
        end
        if Library and Library.KeybindMenu then
            pcall(function()
                Library.KeybindMenu.Enabled = Toggles.KeybindMenu.Value
            end)
        end
    end

    self:espExtras()
    self:chatSpam()
    self:autoLoad()
    self:uiSettings()

    return self
end
return UISettings
end)()

