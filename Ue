pcall(boot_complete_script)
-- ============================================================================
-- Obsidian Ultra UI bridge - direct logic binding
-- Exact requested repo: joustingmatch/ObsidianUltra
-- UI controls call the ORIGINAL Toggles/Options:SetValue() objects directly.
-- ============================================================================

do
    local oldLibrary = Library
    local oldToggles = Toggles or {}
    local oldOptions = Options or {}

    local repo = "https://raw.githubusercontent.com/joustingmatch/ObsidianUltra/main/"

    local function logWarn(...)
        pcall(warn, ...)
    end

    local function safeLoad(path)
        local ok, result = pcall(function()
            local source = game:HttpGet(repo .. path)
            if type(source) ~= "string" or source == "" then
                error("empty response: " .. path)
            end
            local chunk, compileErr = loadstring(source)
            if type(chunk) ~= "function" then
                error(compileErr or ("loadstring failed: " .. path))
            end
            return chunk()
        end)

        if not ok then
            logWarn("[ObsidianUltra] load failed:", path, result)
            return nil
        end

        return result
    end

    local UI = safeLoad("Library.lua")
    if not UI then
        logWarn("[ObsidianUltra] Library.lua failed; original logic remains untouched.")
        return
    end

    local ThemeManager = safeLoad("addons/ThemeManager.lua")
    local SaveManager = safeLoad("addons/SaveManager.lua")

    UI.Options = UI.Options or {}
    UI.Toggles = UI.Toggles or {}

    pcall(function()
        UI.ForceCheckbox = false
        UI.ShowToggleFrameInKeybinds = true
    end)

    local Window
    local okWindow, windowResult = pcall(function()
        return UI:CreateWindow({
            Title = "UE | Obsidian Ultra",
            NotifySide = "Right",
            ShowCustomCursor = true,
            FuzzySearch = true,
            SearchValues = true,
            SearchKeybind = Enum.KeyCode.F,
            Minimizable = true,
            MinimizeKeybind = Enum.KeyCode.RightBracket,
            MinimizedWidth = 300,
            Resizable = true,
            Center = true,
            AutoShow = true,
            MobileButtonsSide = "Left",
        })
    end)

    -- Fallback for libraries that do not accept one of the newer window fields.
    if not okWindow then
        okWindow, windowResult = pcall(function()
            return UI:CreateWindow({
                Title = "UE | Obsidian Ultra",
                NotifySide = "Right",
                ShowCustomCursor = true,
                FuzzySearch = true,
                SearchValues = true,
                SearchKeybind = Enum.KeyCode.F,
                Minimizable = true,
                MinimizeKeybind = Enum.KeyCode.RightBracket,
                MinimizedWidth = 300,
                Resizable = true,
                Center = true,
                AutoShow = true,
            })
        end)
    end

    if not okWindow or not windowResult then
        logWarn("[ObsidianUltra] CreateWindow failed:", windowResult)
        return
    end

    Window = windowResult

    local function createTab(name, icon, description)
        local ok, tab = pcall(function()
            return Window:AddTab({
                Name = name,
                Icon = icon,
                Description = description,
            })
        end)
        if ok and tab then
            return tab
        end

        -- Compatibility fallback for a positional AddTab API.
        ok, tab = pcall(function()
            return Window:AddTab(name, icon)
        end)

        if not ok then
            logWarn("[ObsidianUltra] AddTab failed:", name, tab)
            return nil
        end

        return tab
    end

    local Tabs = {
        Combat = createTab("Combat", "crosshair", "Aim and combat"),
        ESP = createTab("ESP", "eye", "ESP and player visuals"),
        Movement = createTab("Movement", "move", "Movement and camera"),
        Visuals = createTab("Visuals", "palette", "Lighting and visual effects"),
        Misc = createTab("Misc", "layers", "Other features"),
        UI = createTab("UI Settings", "settings", "Menu and configuration"),
    }

    if not (Tabs.Combat and Tabs.ESP and Tabs.Movement and Tabs.Visuals and Tabs.Misc and Tabs.UI) then
        logWarn("[ObsidianUltra] Required tabs failed.")
        pcall(function() UI:Unload() end)
        return
    end

    local function firstToken(name)
        return string.lower(tostring(name):match("^([^_]+)") or "")
    end

    local tabMap = {
        aim = Tabs.Combat,
        aimbot = Tabs.Combat,
        silent = Tabs.Combat,
        triggerbot = Tabs.Combat,
        ragebot = Tabs.Combat,
        targeting = Tabs.Combat,
        target = Tabs.Combat,
        parry = Tabs.Combat,

        esp = Tabs.ESP,
        player = Tabs.ESP,
        target_highlight = Tabs.ESP,

        movement = Tabs.Movement,
        camera = Tabs.Movement,
        third = Tabs.Movement,
        first = Tabs.Movement,

        viewmodel = Tabs.Visuals,
        lighting = Tabs.Visuals,
        world = Tabs.Visuals,
        effects = Tabs.Visuals,
        ambience = Tabs.Visuals,
        bloom = Tabs.Visuals,
        sunrays = Tabs.Visuals,
        atmosphere = Tabs.Visuals,
        color = Tabs.Visuals,
        skybox = Tabs.Visuals,
        weather = Tabs.Visuals,

        animation = Tabs.Misc,
        auto = Tabs.Misc,
        chat = Tabs.Misc,
        name = Tabs.Misc,
        spoof = Tabs.Misc,
        item = Tabs.Misc,
        sound = Tabs.Misc,
        shoot = Tabs.Misc,
        hit = Tabs.Misc,
        custom = Tabs.Misc,
        exploit = Tabs.Misc,
        protection = Tabs.Misc,
        arcade = Tabs.Misc,

        notification = Tabs.UI,
        keybind = Tabs.UI,
    }

    local function chooseTab(name)
        return tabMap[firstToken(name)] or Tabs.Misc
    end

    local groupCache = {}

    local function getGroups(tab)
        if groupCache[tab] then
            return groupCache[tab]
        end

        local left, right

        pcall(function()
            left = tab:AddLeftGroupbox("Features")
        end)

        pcall(function()
            right = tab:AddRightGroupbox("Settings")
        end)

        groupCache[tab] = {
            left = left,
            right = right,
        }

        return groupCache[tab]
    end

    local indexUsed = {}

    local function uniqueIndex(prefix, name)
        local base = (prefix .. "_" .. tostring(name)):gsub("[^%w_]", "_")
        if #base > 80 then
            base = base:sub(1, 80)
        end

        local result = base
        local n = 2
        while indexUsed[result] do
            result = base .. "_" .. n
            n = n + 1
        end

        indexUsed[result] = true
        return result
    end

    -- IMPORTANT:
    -- This is the real connection to the ORIGINAL logic object.
    -- SetValue() invokes that object's callback + OnChanged handlers.
    local function bindValue(source, value)
        if not source then
            return false
        end

        if type(source.SetValue) == "function" then
            local ok = pcall(function()
                source:SetValue(value)
            end)
            return ok
        end

        local ok = pcall(function()
            source.Value = value
        end)
        return ok
    end

    local function labelName(name)
        local s = tostring(name):gsub("_", " ")
        return (s:gsub("(%a)([%w]*)", function(a, b)
            return a:upper() .. b
        end))
    end

    local function getValues(source)
        if type(source.Values) == "table" and #source.Values > 0 then
            return source.Values
        end
        if type(source.Options) == "table" and #source.Options > 0 then
            return source.Options
        end
        return nil
    end

    local function makeToggle(group, name, source)
        if not group or not source then return end

        local idx = uniqueIndex("T", name)
        pcall(function()
            group:AddToggle(idx, {
                Text = labelName(name),
                Default = source.Value == true,
                Callback = function(value)
                    -- Directly changes ORIGINAL Toggle.
                    bindValue(source, value == true)
                end,
            })
        end)
    end

    local function makeKeyPicker(group, name, source)
        if not group or not source then return false end
        local value = source.Value

        if type(value) ~= "table" or value[1] == nil then
            return false
        end

        local key = value[1]
        local mode = value[2] or "Toggle"

        local idx = uniqueIndex("K", name)

        local ok = pcall(function()
            group:AddLabel(labelName(name)):AddKeyPicker(idx, {
                Default = key,
                Mode = mode,
                Text = labelName(name),
                Callback = function(newState)
                    -- Keep the original key picker state in sync when possible.
                    if type(source.SetValue) == "function" then
                        local current = source.Value or {}
                        bindValue(source, { current[1] or key, current[2] or mode })
                    end
                end,
                ChangedCallback = function(newKey, newModifiers)
                    local current = source.Value or {}
                    local currentMode = current[2] or mode
                    bindValue(source, { newKey or current[1] or key, currentMode })
                end,
            })
        end)

        return ok
    end

    local function makeDropdown(group, name, source, values)
        if not group or not source or not values or #values == 0 then
            return false
        end

        local current = source.Value
        local multi = type(current) == "table"
        local idx = uniqueIndex("D", name)

        local ok = pcall(function()
            group:AddDropdown(idx, {
                Values = values,
                Default = current,
                Multi = multi,
                Searchable = #values > 8,
                Text = labelName(name),
                Callback = function(value)
                    -- Directly changes ORIGINAL Option.
                    bindValue(source, value)
                end,
            })
        end)

        return ok
    end

    local function makeOption(group, name, source)
        if not group or not source then return end

        local value = source.Value
        local valueType = typeof(value)

        -- KeyPicker-style source
        if makeKeyPicker(group, name, source) then
            return
        end

        -- ColorPicker
        if valueType == "Color3" then
            pcall(function()
                group:AddLabel(labelName(name)):AddColorPicker(uniqueIndex("C", name), {
                    Default = value,
                    Title = labelName(name),
                    Callback = function(newColor)
                        bindValue(source, newColor)
                    end,
                })
            end)
            return
        end

        -- Dropdown
        local values = getValues(source)
        if values and #values > 0 then
            if makeDropdown(group, name, source, values) then
                return
            end
        end

        -- Numeric option with bounds
        if type(value) == "number" and tonumber(source.Min) and tonumber(source.Max) then
            local minValue = tonumber(source.Min)
            local maxValue = tonumber(source.Max)

            if maxValue >= minValue then
                pcall(function()
                    group:AddSlider(uniqueIndex("S", name), {
                        Text = labelName(name),
                        Default = math.clamp(value, minValue, maxValue),
                        Min = minValue,
                        Max = maxValue,
                        Rounding = tonumber(source.Rounding) or 0,
                        Suffix = source.Suffix,
                        Callback = function(newValue)
                            bindValue(source, newValue)
                        end,
                    })
                end)
                return
            end
        end

        -- Numeric fallback
        if type(value) == "number" then
            pcall(function()
                group:AddInput(uniqueIndex("N", name), {
                    Text = labelName(name),
                    Numeric = true,
                    Default = tostring(value),
                    ClearTextOnFocus = false,
                    Callback = function(newValue)
                        local numberValue = tonumber(newValue)
                        if numberValue ~= nil then
                            bindValue(source, numberValue)
                        end
                    end,
                })
            end)
            return
        end

        -- String / other fallback
        pcall(function()
            group:AddInput(uniqueIndex("I", name), {
                Text = labelName(name),
                Default = tostring(value == nil and "" or value),
                ClearTextOnFocus = false,
                Callback = function(newValue)
                    bindValue(source, newValue)
                end,
            })
        end)
    end

    -- Create controls for the ORIGINAL objects.
    -- Clicking these controls therefore changes the real game state,
    -- not a second shadow table.
    for name, source in pairs(oldToggles) do
        pcall(function()
            if source and source.Value ~= nil then
                local g = getGroups(chooseTab(name))
                makeToggle(g.left or g.right, name, source)
            end
        end)
    end

    for name, source in pairs(oldOptions) do
        pcall(function()
            if source and source.Value ~= nil then
                local g = getGroups(chooseTab(name))
                makeOption(g.right or g.left, name, source)
            end
        end)
    end

    -- UI settings.
    pcall(function()
        local menu = Tabs.UI:AddLeftGroupbox("Menu", "settings")

        menu:AddToggle("UI_KeybindMenu", {
            Text = "Open Keybind Menu",
            Default = UI.KeybindFrame and UI.KeybindFrame.Visible or false,
            Callback = function(value)
                pcall(function()
                    if UI.KeybindFrame then
                        UI.KeybindFrame.Visible = value == true
                    end
                end)
            end,
        })

        menu:AddToggle("UI_CustomCursor", {
            Text = "Custom Cursor",
            Default = UI.ShowCustomCursor == true,
            Callback = function(value)
                pcall(function()
                    UI.ShowCustomCursor = value == true
                end)
            end,
        })

        menu:AddButton({
            Text = "Test Notification",
            Func = function()
                pcall(function()
                    UI:Notify({
                        Title = "UE | Obsidian Ultra",
                        Description = "UI is loaded.",
                        Type = "Success",
                        Time = 3,
                    })
                end)
            end,
        })
    end)

    -- Direct-binding smoke tests (buttons only; do not change state automatically).
    pcall(function()
        local test = Tabs.UI:AddLeftGroupbox("Logic Binding Test", "check")

        test:AddButton({
            Text = "Test Ragebot Toggle Binding",
            Func = function()
                local source = oldToggles.ragebot_enabled
                if not source then
                    logWarn("[ObsidianUltra] ragebot_enabled not found")
                    return
                end
                local before = source.Value == true
                local ok = bindValue(source, not before)
                local after = source.Value == true
                pcall(function()
                    UI:Notify({
                        Title = "Ragebot binding",
                        Description = ok and ("State: " .. tostring(before) .. " -> " .. tostring(after))
                            or "SetValue failed",
                        Type = ok and "Success" or "Error",
                        Time = 3,
                    })
                end)
            end,
        })

        test:AddButton({
            Text = "Test ESP Name Binding",
            Func = function()
                local source = oldToggles.esp_name
                if not source then
                    logWarn("[ObsidianUltra] esp_name not found")
                    return
                end
                local before = source.Value == true
                local ok = bindValue(source, not before)
                local after = source.Value == true
                pcall(function()
                    UI:Notify({
                        Title = "ESP name binding",
                        Description = ok and ("State: " .. tostring(before) .. " -> " .. tostring(after))
                            or "SetValue failed",
                        Type = ok and "Success" or "Error",
                        Time = 3,
                    })
                end)
            end,
        })
    end)

    -- Optional addons; failure here must never kill the main UI.
    if ThemeManager then
        pcall(function()
            ThemeManager:SetLibrary(UI)
            ThemeManager:SetFolder("UE_ObsidianUltra")
            ThemeManager:ApplyToTab(Tabs.UI)
        end)
    end

    if SaveManager then
        pcall(function()
            SaveManager:SetLibrary(UI)
            SaveManager:IgnoreThemeSettings()
            SaveManager:SetIgnoreIndexes({ "UI_KeybindMenu", "UI_CustomCursor" })
            SaveManager:SetFolder("UE_ObsidianUltra")
            SaveManager:BuildConfigSection(Tabs.UI)
            SaveManager:LoadAutoloadConfig()
        end)
    end

    -- Hide the old GUI only; the old Toggle/Option objects and their callbacks
    -- remain alive, so the new UI controls continue driving the real logic.
    pcall(function()
        if oldLibrary and oldLibrary.ScreenGui then
            oldLibrary.ScreenGui.Enabled = false
        end
    end)

    pcall(function()
        UI:Notify({
            Title = "UE | Obsidian Ultra",
            Description = "Direct logic binding enabled.",
            Type = "Success",
            Time = 4,
        })
    end)
end
