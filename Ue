local CustomTracer = (function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local CustomTracer = {}
CustomTracer.__index = CustomTracer

function CustomTracer.new()
    local self = setmetatable({}, CustomTracer)
    self.tracers = {}
    self.drawings = {}

    local function makeLine()
        local line = Drawing.new("Line")
        line.Thickness = 1
        line.Transparency = 1
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Visible = false
        table.insert(self.drawings, line)
        return line
    end

    local function getMuzzlePosition(character)
        local item = character and character:FindFirstChild("EquippedItem")
        local vm = item and item.ViewModel
        local muzzle = vm and (vm:FindFirstChild("Muzzle") or vm:FindFirstChild("MuzzleAttachment"))
        if muzzle then
            return muzzle.WorldPosition
        end
        return vm and vm.CFrame.Position or (character and character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position)
    end

    function self:fire(origin, target)
        if not Toggles.custom_tracer_enabled.Value then return end
        local now = tick()
        local selected = Options.custom_tracer_selected.Value or "default"
        local speed = Options.custom_tracer_speed.Value or 2
        local glow = Options.custom_tracer_glow.Value or 4
        local length = Options.custom_tracer_length.Value or 4
        local outline = Toggles.custom_tracer_outline.Value
        local emission = Options.custom_tracer_emission.Value or 0
        local posLerp = Options.custom_tracer_position_lerp.Value or 1

        local line = makeLine()
        local from = origin
        local to = target
        if posLerp < 1 then
            from = from:Lerp(to, posLerp)
        end
        line.From = from
        line.To = to
        line.Thickness = Options.custom_tracer_width.Value
        line.Color = selected == "secondary" and Options.custom_tracer_color2.Value or Options.custom_tracer_color.Value
        line.Transparency = Options.custom_tracer_fade.Value
        line.Visible = true
        if outline then
            local ol = makeLine()
            ol.From = from
            ol.To = to
            ol.Thickness = line.Thickness + 2
            ol.Color = Color3.new(0, 0, 0)
            ol.Visible = true
            table.insert(self.tracers, {
                line = ol,
                start = now,
                lifetime = Options.custom_tracer_lifetime.Value,
            })
        end
        if emission > 0 then
            local particle = Instance.new("ParticleEmitter")
            particle.Lifetime = NumberRange.new(0.1)
            particle.Rate = 0
            particle.Color = ColorSequence.new(line.Color)
            particle.Size = NumberSequence.new(0.5)
            particle.Parent = workspace.Terrain
            particle:Emit(3)
            task.delay(0.5, function()
                particle:Destroy()
            end)
        end
        table.insert(self.tracers, {
            line = line,
            start = now,
            lifetime = Options.custom_tracer_lifetime.Value,
            length = length,
            speed = speed,
        })
    end

    function self:updateRaycastResults(results)
        -- proto 102: fire a tracer for each raycast hit
        if not Toggles.custom_tracer_enabled.Value then return end
        local origin = getMuzzlePosition(LocalPlayer.Character)
        for _, result in ipairs(results or {}) do
            if result and result.Position then
                self:fire(origin, result.Position)
            end
        end
    end

    RunService.RenderStepped:Connect(function(dt)
        local now = tick()
        local keep = {}
        for _, tracer in ipairs(self.tracers) do
            local age = now - tracer.start
            if age >= tracer.lifetime then
                pcall(function()
                    tracer.line:Remove()
                end)
            else
                local alpha = 1 - (age / tracer.lifetime)
                pcall(function()
                    tracer.line.Transparency = alpha
                    tracer.line.Visible = true
                end)
                table.insert(keep, tracer)
            end
        end
        self.tracers = keep
    end)

    return self
end

function CustomTracer:destroy()
    for _, drawing in ipairs(self.drawings) do
        pcall(function()
            drawing:Remove()
        end)
    end
    self.drawings = {}
    self.tracers = {}
end
return CustomTracer
end)()

