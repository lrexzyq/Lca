local SLOT_ORDER = {
    "Primary",
    "Secondary",
    "Melee",
}

local function getSelectedWeapon(slot)
    return RageState.selectedWeapons[slot]
end

local function isSlotAllowed(slot)
    return RageState.allowedWeapons[slot] == true
end

local function getAllowedSlots()
    local result = {}
    for _, slot in ipairs(SLOT_ORDER) do
        if isSlotAllowed(slot) then
            table.insert(result, slot)
        end
    end
    return result
end

local function resetSwapSequence()
    RageState.currentSlot = "Primary"
end

local function getNextAllowedSlot()
    local allowed = getAllowedSlots()
    if #allowed == 0 then
        return nil
    end

    local currentIndex = table.find(allowed, RageState.currentSlot)
    if not currentIndex then
        RageState.currentSlot = allowed[1]
        return allowed[1]
    end

    local nextIndex = currentIndex % #allowed + 1
    RageState.currentSlot = allowed[nextIndex]
    return allowed[nextIndex]
end

local function getEquippedItem(character)
    return character and character:FindFirstChild("EquippedItem")
end

local function getEquippedWeaponName(character)
    local item = getEquippedItem(character)
    return item and item.Name or nil
end

local function getWeaponType(item)
    return item and item.Info and item.Info.Type or nil
end

local function equipWeapon(character, weaponName)
    local item = getEquippedItem(character)
    if not item or not item.EquipItem or not weaponName then
        return false
    end
    local ok = pcall(function()
        item:EquipItem(weaponName)
    end)
    return ok
end

local function randomUnitVector()
    return Random.new():NextUnitVector()
end

local function getHitbox(character)
    return character and (character:FindFirstChild("HitboxHead") or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
end

local function isAlly(character)
    local flag = character and character:FindFirstChild("_is_ally")
    return flag ~= nil and flag.Value == true
end

local function isAlive(character)
    local hum = character and character:FindFirstChild("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function hasHealthFlag(character)
    return character and character:FindFirstChild("Health") ~= nil
end

local function validateTarget(character)
    if not character then return false end
    if isAlly(character) then return false end
    if not isAlive(character) then return false end
    if not hasHealthFlag(character) then return false end
    return true
end

local function getTarget()
    local camera = workspace.CurrentCamera
    if not camera then
        return nil
    end

    local origin = camera.CFrame.Position
    local best
    local bestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp then
            local character = player.Character
            if validateTarget(character) then
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then
                    local distance = (root.Position - origin).Magnitude
                    if distance < bestDistance then
                        bestDistance = distance
                        best = character
                    end
                end
            end
        end
    end

    return best
end

local attackNum = 0
local heavyAttackNum = 0
local reloadCooldown = 0
local lastMeleeAttack = 0

local function getAnimationKeys(item)
    local viewModel = item and item.ViewModel
    if not viewModel or not viewModel.GetAnimationKeys then
        return {}
    end
    local ok, keys = pcall(function()
        return viewModel:GetAnimationKeys()
    end)
    return ok and keys or {}
end

local function getRotationCFrame(part)
    return part and part.CFrame.Rotation or CFrame.new()
end

local function fireUseItem(payload)
    if not UseItemRemote or not UseItemRemote.FireServer then
        return false
    end
    local ok = pcall(function()
        UseItemRemote:FireServer(payload)
    end)
    return ok
end

local function attackRanged(target)
    local character = lp.Character
    local item = getEquippedItem(character)
    if not item or getWeaponType(item) ~= "Gun" then
        return false
    end

    local hitbox = getHitbox(target)
    if not hitbox then
        return false
    end

    attackNum += 1
    local aimPos = hitbox.Position + randomUnitVector() * 0.5

    local ok = fireUseItem({
        id = HttpService:GenerateGUID(false),
        objectId = HttpService:GenerateGUID(false),
        item = item.Name,
        position = aimPos,
        attackNum = attackNum,
        animationKeys = getAnimationKeys(item),
        rotation = getRotationCFrame(hitbox),
        one = Vector3.one,
        packed = { "\x00", "\x01", "\x02", "\x03" },
    })

    if ok then
        pcall(function()
            if item.StartShooting then
                item:StartShooting(aimPos)
            end
        end)
    end

    return ok
end

local function attackMelee(target)
    local character = lp.Character
    local item = getEquippedItem(character)
    if not item or getWeaponType(item) ~= "Melee" then
        return false
    end

    local hitbox = getHitbox(target)
    if not hitbox then
        return false
    end

    local now = tick()
    local cooldown = item.Info and item.Info.HeavyAttackCooldown or 0.2
    if now - lastMeleeAttack < cooldown then
        return false
    end

    lastMeleeAttack = now
    heavyAttackNum += 1
    local aimPos = hitbox.Position + randomUnitVector() * 0.35

    local ok = fireUseItem({
        id = HttpService:GenerateGUID(false),
        objectId = HttpService:GenerateGUID(false),
        item = item.Name,
        position = aimPos,
        heavyAttackNum = heavyAttackNum,
        animationKeys = getAnimationKeys(item),
        rotation = getRotationCFrame(hitbox),
        one = Vector3.one,
        startAiming = true,
        packed = { "\x00", "\x01", "\x02", "\x03" },
    })

    if ok then
        pcall(function()
            if item.StartAiming then
                item:StartAiming(aimPos)
            end
        end)
        pcall(function()
            if item.HeavyAttack then
                item:HeavyAttack(aimPos)
            end
        end)
    end

    return ok
end

local voidSpamEnabled = false
local voidSpamThread = nil

local function betterRandom(mi, ma, dmi, dma)
    local val = math.random(mi, ma)
    repeat
        val = math.random(mi, ma)
    until val < dmi or val > dma
    return val
end

local function voidSpamLoop()
    while voidSpamEnabled do
        pcall(function()
            local char = lp.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646)
                    ) * CFrame.Angles(math.pi, math.pi, math.pi)
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646)
                    )
                    hrp.AssemblyAngularVelocity = Vector3.new(
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                        betterRandom(-2147483646, 2147483646, -1147483646, 1147483646)
                    )
                end
            end
        end)
        task.wait()
    end
end

local function startVoidSpam()
    if voidSpamThread then
        return
    end
    voidSpamEnabled = true
    voidSpamThread = task.spawn(voidSpamLoop)
end

local function stopVoidSpam()
    voidSpamEnabled = false
    if voidSpamThread then
        task.cancel(voidSpamThread)
        voidSpamThread = nil
    end
end

local voidPhase = "Attack"
local phaseStarted = tick()

local function resetVoidPhase()
    voidPhase = "Attack"
    phaseStarted = tick()
    stopVoidSpam()
end

local function updateVoidPhase(now)
    if not RageState.enabled or not RageState.voidSpam then
        resetVoidPhase()
        return
    end

    local elapsed = now - phaseStarted
    if voidPhase == "Attack" then
        if elapsed >= RageState.attack then
            voidPhase = "Hide"
            phaseStarted = now
            startVoidSpam()
        end
    elseif elapsed >= RageState.hide then
        voidPhase = "Attack"
        phaseStarted = now
        stopVoidSpam()
    end
end

local function handleAmmoAndSwap()
    local character = lp.Character
    local item = getEquippedItem(character)
    if not item then
        return false
    end

    if getWeaponType(item) ~= "Gun" then
        return false
    end

    local data = item.Data
    local ammo = data and data.Ammo
    local reserve = data and data.AmmoReserve

    if ammo == nil or ammo > 0 then
        return false
    end

    if reserve and reserve > 0 then
        if RageState.swapMode == "Reload" then
            local now = tick()
            if now >= reloadCooldown then
                reloadCooldown = now + 0.4
                pcall(function()
                    if item.StartReloading then
                        item:StartReloading()
                    end
                end)
            end
        end
        return true
    end

    if RageState.swapMode == "Swap When Empty" then
        local nextSlot = getNextAllowedSlot()
        if nextSlot then
            local selectedWeapon = getSelectedWeapon(nextSlot)
            equipWeapon(character, selectedWeapon)
        end
    end

    return true
end

local function performAttack()
    local target = getTarget()
    if not target then
        return false
    end

    local allowed = getAllowedSlots()
    if #allowed == 0 then
        return false
    end

    local currentSlot = RageState.currentSlot
    if not isSlotAllowed(currentSlot) then
        currentSlot = allowed[1]
        RageState.currentSlot = currentSlot
    end

    local wantedWeapon = getSelectedWeapon(currentSlot)
    local currentWeapon = getEquippedWeaponName(lp.Character)

    if currentWeapon ~= wantedWeapon then
        equipWeapon(lp.Character, wantedWeapon)
        return false
    end

    if handleAmmoAndSwap() then
        return false
    end

    local item = getEquippedItem(lp.Character)
    local typeName = getWeaponType(item)

    if typeName == "Melee" then
        return attackMelee(target)
    elseif typeName == "Gun" then
        return attackRanged(target)
    end

    return false
end

local Indicator
pcall(function()
    Indicator = Drawing.new("Text")
    Indicator.Center = true
    Indicator.Outline = true
    Indicator.Size = 16
    Indicator.Visible = false
end)

local function updateIndicator()
    if not Indicator then
        return
    end

    if not Toggles.RagebotIndicator.Value or not RageState.enabled then
        Indicator.Visible = false
        return
    end

    local item = getEquippedItem(lp.Character)
    local typeName = getWeaponType(item)

    if typeName == "Melee" then
        Indicator.Text = "ragebot: " .. tostring(item.Name or "Melee")
    else
        Indicator.Text = "ragebot"
    end

    local camera = workspace.CurrentCamera
    if camera then
        local viewport = camera.ViewportSize
        Indicator.Position = Vector2.new(viewport.X / 2, viewport.Y / 2 + 80)
    end

    Indicator.Visible = true
end

local function updateStateFromUI()
    RageState.enabled = Toggles.RagebotEnabled.Value
    RageState.voidSpam = Toggles.RagebotVoidSpam.Value
    RageState.hide = math.clamp(tonumber(Options.RagebotHide.Value) or 0.25, 0.1, 1)
    RageState.attack = math.clamp(tonumber(Options.RagebotAttack.Value) or 0.5, 0.1, 2)
    RageState.swapMode = Options.RagebotSwap.Value or "Swap When Empty"

    local selected = Options.RagebotWeapons.Value or {}
    RageState.allowedWeapons = {
        Primary = selected.Primary == true,
        Secondary = selected.Secondary == true,
        Melee = selected.Melee == true,
    }

    RageState.selectedWeapons = {
        Primary = Options.RagebotPrimary.Value or "Assault Rifle",
        Secondary = Options.RagebotSecondary.Value or "Handgun",
        Melee = Options.RagebotMelee.Value or "Fists",
    }
end

