local value = math.clamp(math.floor(tonumber(Options.SlidingValue.Value) or 1), 1, 100)
states.rage_state.movement.slide_boost_value = value
movement_sync.Sliding = true
Options.SlidingInput:SetValue(tostring(value))
movement_sync.Sliding = false
end)
Options.SlidingInput:OnChanged(function()
if movement_sync.Sliding then return end
local value = tonumber(Options.SlidingInput.Value)
if not value then return end
value = math.clamp(math.floor(value), 1, 100)
states.rage_state.movement.slide_boost_value = value
movement_sync.Sliding = true
Options.SlidingValue:SetValue(value)
Options.SlidingInput:SetValue(tostring(value))
movement_sync.Sliding = false
end)
Toggles.Walking:OnChanged(function()
states.rage_state.movement.velocity = Toggles.Walking.Value
end)
Options.WalkingValue:OnChanged(function()
if movement_sync.Walking then return end
local value = math.clamp(math.floor(tonumber(Options.WalkingValue.Value) or 50), 1, 500)
