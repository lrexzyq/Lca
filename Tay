local movement_sync = {
Fly = false,
Sliding = false,
Walking = false,
}
Toggles.Fly:OnChanged(function()
states.rage_state.movement.fly = Toggles.Fly.Value
end)
Options.FlySpeed:OnChanged(function()
if movement_sync.Fly then return end
local value = math.clamp(math.floor(tonumber(Options.FlySpeed.Value) or 50), 10, 1000)
states.rage_state.movement.fly_speed = value
movement_sync.Fly = true
Options.FlySpeedInput:SetValue(tostring(value))
movement_sync.Fly = false
end)
Options.FlySpeedInput:OnChanged(function()
if movement_sync.Fly then return end
local value = tonumber(Options.FlySpeedInput.Value)
if not value then return end
value = math.clamp(math.floor(value), 10, 1000)
states.rage_state.movement.fly_speed = value
movement_sync.Fly = true
Options.FlySpeed:SetValue(value)
Options.FlySpeedInput:SetValue(tostring(value))
movement_sync.Fly = false
end)
Toggles.Sliding:OnChanged(function()
states.rage_state.movement.slide_boost = Toggles.Sliding.Value
end)
Options.SlidingValue:OnChanged(function()
