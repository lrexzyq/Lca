local undergroundEnabled = false
local undergroundDepth = 2.5
local undergroundConn = nil
local undergroundRenderConn = nil
local undergroundRealCF = nil
local undergroundRealVel = nil
local undergroundRealAngVel = nil
local undergroundOldCF = nil
local undergroundOldVel = nil
local undergroundOldAngVel = nil
local undergroundOldCamCF = nil
local undergroundFirstRun = true

local function startUnderground()
    if undergroundConn then return end
    undergroundFirstRun = true
    undergroundConn = RunService.Heartbeat:Connect(function()
        if not undergroundEnabled then return end
        pcall(function()
            local char = lp.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            if undergroundFirstRun then
                undergroundOldCF = hrp.CFrame
                undergroundOldVel = hrp.AssemblyLinearVelocity
                undergroundOldAngVel = hrp.AssemblyAngularVelocity
                undergroundOldCamCF = Workspace.CurrentCamera.CFrame
                undergroundFirstRun = false
            end
            undergroundRealCF = hrp.CFrame
            undergroundRealVel = hrp.AssemblyLinearVelocity
            undergroundRealAngVel = hrp.AssemblyAngularVelocity
            local depth = undergroundDepth or 2.5
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = { char }
            params.FilterType = Enum.RaycastFilterType.Exclude
            local result = Workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), params)
            local fakeY
            if result then
                fakeY = result.Position.Y - depth
            else
                fakeY = -99999
            end
            hrp.CFrame = CFrame.new(hrp.Position.X, fakeY, hrp.Position.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end)
    undergroundRenderConn = RunService:BindToRenderStep("UndergroundSync", Enum.RenderPriority.First.Value, function()
        if undergroundEnabled and undergroundRealCF then
            pcall(function()
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                hrp.CFrame = undergroundRealCF
                hrp.AssemblyLinearVelocity = undergroundRealVel or Vector3.zero
                hrp.AssemblyAngularVelocity = undergroundRealAngVel or Vector3.zero
            end)
        end
    end)
end

local function stopUnderground()
    if undergroundConn then
        undergroundConn:Disconnect()
        undergroundConn = nil
    end
    if undergroundRenderConn then
        pcall(function() RunService:UnbindFromRenderStep("UndergroundSync") end)
        undergroundRenderConn = nil
    end
    if undergroundOldCF then
        pcall(function()
            local char = lp.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = undergroundOldCF
                    hrp.AssemblyLinearVelocity = undergroundOldVel or Vector3.zero
                    hrp.AssemblyAngularVelocity = undergroundOldAngVel or Vector3.zero
                end
            end
            if undergroundOldCamCF then
                Workspace.CurrentCamera.CFrame = undergroundOldCamCF
            end
        end)
        undergroundOldCF = nil
        undergroundOldVel = nil
        undergroundOldAngVel = nil
        undergroundOldCamCF = nil
    end
    undergroundRealCF = nil
    undergroundRealVel = nil
    undergroundRealAngVel = nil
    undergroundFirstRun = true
end

local voidSpamEnabled = false
local voidRange = math.huge
local voidHrp = nil
