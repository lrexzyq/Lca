-- AIMBOT
-- ============================================================
Aimbot = {
    enabled = false,
    visCheck = true,
    teamCheck = true,
    fov = 360,
    maxDist = math.huge,
    prediction = 0,
    smoothing = 0,
    cc = nil,

    getCC = function(self)
        if not self.cc then
            self.cc = safeRequire(lp.PlayerScripts.Controllers.CameraController)
        end
        return self.cc
    end,

    setEnabled = function(self, state) self.enabled = state; if not state then self.cc = nil end end,
    setVisibleCheck = function(self, v) self.visCheck = v end,
    setTeamCheck = function(self, v) self.teamCheck = v end,
    setFOV = function(self, v) self.fov = v end,
    setMaxDist = function(self, v) self.maxDist = v end,
    setPrediction = function(self, v) self.prediction = v end,
    setSmoothing = function(self, v) self.smoothing = v end,

    update = function(self)
        if not self.enabled then return end
        local c = self:getCC()
        if not c or not c._current_subject then return end

        local myEnv = lp:GetAttribute("EnvironmentID")
        local myTeam = lp:GetAttribute("TeamID")
        local cam = Workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local cx, cy = cam.ViewportSize.X/2, cam.ViewportSize.Y/2

        local best, bestDist = nil, math.huge

        for _, p in ipairs(Players:GetPlayers()) do
            if p == lp then continue end
            if p:GetAttribute("EnvironmentID") ~= myEnv then continue end
            if self.teamCheck and myTeam ~= nil and p:GetAttribute("TeamID") == myTeam then continue end

            local char = p.Character
            if not char then continue end

            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not head or not hum or hum.Health <= 0 then continue end

            local aimPos = head.Position
            if self.prediction > 0 then
                local vel = head.AssemblyLinearVelocity
                if vel.Magnitude < 500 then
                    aimPos = head.Position + vel * self.prediction
                end
            end

            local dist = (aimPos - camPos).Magnitude
            if dist > self.maxDist then continue end

            local sp, vis = cam:WorldToViewportPoint(aimPos)
            if not vis then continue end

            if ((sp.X - cx)^2 + (sp.Y - cy)^2)^0.5 > self.fov then continue end

            if self.visCheck then
                local rp = RaycastParams.new()
                rp.FilterDescendantsInstances = { lp.Character, head.Parent }
                rp.FilterType = Enum.RaycastFilterType.Exclude
                local result = Workspace:Raycast(camPos, (head.Position - camPos).Unit * 1000, rp)
                if result and result:IsDescendantOf(head.Parent) then
                    -- visible
                else
                    continue
                end
            end

            if dist < bestDist then
                bestDist = dist
                best = { pos = aimPos, camPos = camPos, char = char }
            end
        end

        if best then
            pcall(function()
                c:MimicRotation(CFrame.lookAt(best.camPos, best.pos).Rotation)
            end)
        end
    end
}

RunService.RenderStepped:Connect(function() Aimbot:update() end)

