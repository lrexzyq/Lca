-- Void Spam
RagebotSection:Toggle({
    Title = "Void Spam",
    Value = false,
    Callback = function(v)
        Ragebot.config.voidspam.enabled = v
        if v then
            if Ragebot.config.target.immune then
                Ragebot.config.voidspam.phase = nil
                return
            end
            if Ragebot.isSling(Ragebot.getweapon()) then
                Ragebot.config.voidspam.lastswitch = tick()
                Ragebot.config.voidspam.phase = "shoot"
                Ragebot.config.voidspam.currentduration = Ragebot.randVs(
                    Ragebot.config.voidspam.shoot_min,
                    Ragebot.config.voidspam.shoot_max
                )
            else
                Ragebot.config.voidspam.phase = nil
            end
        else
            Ragebot.config.voidspam.phase = nil
            if Ragebot.clrVoidSnap then Ragebot.clrVoidSnap() end
        end
    end,
})

RagebotSection:Slider({
    Title = "Attack Time",
    Step = 0.1,
    Width = 200,
    Value = { Min = 0.1, Max = 2, Default = 1 },
    Callback = function(v)
        local val = Ragebot.clampVs(v)
        Ragebot.config.voidspam.shoot_min = val
        Ragebot.config.voidspam.shoot_max = val
    end,
})

