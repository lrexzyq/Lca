    while true do
        task.wait(1)

        if Library.Unloaded then
            break
        end

        local elapsed =
            math.floor(os.clock() - sessionStart)

        local text

        if elapsed < 60 then
            text = elapsed .. " giây"
        elseif elapsed < 3600 then
            text = string.format(
                "%d phút %d giây",
                elapsed // 60,
                elapsed % 60
            )
        else
            text = string.format(
                "%d giờ %d phút",
                elapsed // 3600,
                (elapsed % 3600) // 60
            )
        end

        SessionLabel:SetText(
            field("Thời gian chơi", text, ORANGE)
        )
    end
end)

