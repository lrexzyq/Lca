local voidFirstRun = true

local function betterRandom(mi, ma, dmi, dma)
    local val = math.random(mi, ma)
    local attempts = 0
    while (val >= dmi and val <= dma) and attempts < 100 do
        val = math.random(mi, ma)
        attempts = attempts + 1
    end
    return val
end

function startVoidSpam()
    if voidHeartbeatConn then return end
    voidFirstRun = true
    voidHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not voidSpamEnabled then return end
        pcall(function()
            local char = lp.Character
            if not char then return end
            voidHrp = char:FindFirstChild("HumanoidRootPart")
            if not voidHrp then return end
            if voidFirstRun then
                voidOldCF = voidHrp.CFrame
                voidOldVel = voidHrp.AssemblyLinearVelocity
                voidOldAngVel = voidHrp.AssemblyAngularVelocity
                voidOldCamCF = Workspace.CurrentCamera.CFrame
                voidFirstRun = false
            end
            voidClientc = voidHrp.CFrame
            voidClientv = voidHrp.AssemblyLinearVelocity
            voidClientva = voidHrp.AssemblyAngularVelocity
            local range = voidRange
            voidHrp.CFrame = CFrame.new(
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2)
            ) * CFrame.Angles(math.pi, math.pi, math.pi)
            voidHrp.AssemblyLinearVelocity = Vector3.new(
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2)
            )
            voidHrp.AssemblyAngularVelocity = Vector3.new(
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2),
                betterRandom(-range, range, -range/2, range/2)
            )
        end)
    end)
    voidRenderConn = RunService:BindToRenderStep("VoidSpamSync", Enum.RenderPriority.First.Value, function()
        if voidSpamEnabled and voidHrp then
            pcall(function()
                voidHrp.CFrame = voidClientc
                voidHrp.AssemblyLinearVelocity = voidClientv
                voidHrp.AssemblyAngularVelocity = voidClientva
            end)
        end
    end)
end

function stopVoidSpam()
    voidSpamEnabled = false
    if voidHeartbeatConn then
        voidHeartbeatConn:Disconnect()
        voidHeartbeatConn = nil
    end
    if voidRenderConn then
        pcall(function() RunService:UnbindFromRenderStep("VoidSpamSync") end)
