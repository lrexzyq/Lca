local function setRunService(type)
    runServiceType = type
    if runServiceConnection then
        runServiceConnection:Disconnect()
        runServiceConnection = nil
    end
    if type == "Heartbeat" then
        runServiceConnection = RunService.Heartbeat:Connect(function() Aimbot:update() end)
    elseif type == "RenderStepped" then
        runServiceConnection = RunService.RenderStepped:Connect(function() Aimbot:update() end)
    elseif type == "PreSimulation" then
        runServiceConnection = RunService.PreSimulation:Connect(function() Aimbot:update() end)
    end
end

