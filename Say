})

RagebotSection:Toggle({
    Title = "Enable",
    Value = false,
    Callback = function(v)
        Ragebot.config.target.rageMasterOn = v
        if Ragebot.config.target.auto then return end
        if v then
            local target = Ragebot.nearest()
            if target then
                Ragebot.config.target.manualkey = true
                Ragebot.settarget(target)
            end
        else
            Ragebot.cleartarget()
        end
    end,
})

RagebotSection:Keybind({
    Title = "Ragebot Key",
    Desc = "Keybind to toggle",
    Value = "None",
    Callback = function(v)
