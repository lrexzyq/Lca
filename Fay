function translocateController:SetRootPart(rootPart)
    if self.rootPart ~= rootPart then
        self.rootPart = rootPart
        self.oldCFrame = rootPart and rootPart.CFrame or nil
        self.serverCFrame = nil
    elseif self.oldCFrame == nil and rootPart then
        self.oldCFrame = rootPart.CFrame
    end
end

function translocateController:GetClientCFrame()
    local cf = self.oldCFrame
    if not cf and self.rootPart then
        cf = self.rootPart.CFrame
    end
    return cf
end

function translocateController:SetServerCFrame(cf)
    self.serverCFrame = cf
end

function translocateController:GetServerCFrame()
    local cf = self.serverCFrame
    if not cf and self.rootPart then
        cf = self.rootPart.CFrame
    end
    return cf
end

function translocateController:HeartbeatUpdate()
    local root = self.rootPart
    local serverCF = self.serverCFrame
    if not root or not serverCF then
        return
    end

    self.oldCFrame = root.CFrame
    pcall(function()
        root.CFrame = serverCF
    end)
end

function translocateController:RenderStepUpdate()
    local root = self.rootPart
    local clientCF = self.oldCFrame
    if not root or not clientCF then
        return
    end

    pcall(function()
        root.CFrame = clientCF
    end)
    self.oldCFrame = nil
end

function translocateController:BindRenderStep()
    if self.renderBound then
        return
    end

    pcall(function()
        runsvc:UnbindFromRenderStep(self.boundId)
    end)

    runsvc:BindToRenderStep(
        self.boundId,
        Enum.RenderPriority.First.Value,
        function()
            self:RenderStepUpdate()
        end
    )

    self.renderBound = true
end

function translocateController:Reset()
    self.oldCFrame = nil
    self.serverCFrame = nil
    self.rootPart = nil

    if self.renderBound then
        pcall(function()
            runsvc:UnbindFromRenderStep(self.boundId)
        end)
        self.renderBound = false
    end
end



