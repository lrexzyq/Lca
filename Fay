local SLOTS = { primary = 1, secondary = 2, melee = 3 }
local MELEE_NMS = {
    ["Battle Axe"] = true, ["Chainsaw"] = true, ["Daggers"] = true, ["Fists"] = true,
    ["Gunblade"] = true, ["Katana"] = true, ["Knife"] = true, ["Spear"] = true,
    ["Scythe"] = true, ["Trowel"] = true, ["Maul"] = true, ["Riot Shield"] = true,
}
local INFINITE_AMMO_WEAPONS = {
    ["Energy Rifle"] = true,
    ["Energy Pistols"] = true,
}

local function isInfiniteWeapon()
    local w = getweapon()
    if not w then return false end
    return INFINITE_AMMO_WEAPONS[w] == true
end

local function selectedWeaponTable()
    local selected = config.target.weaponSelection or {}
    if selected.secondary then
        return { primary = false, secondary = true, melee = false }
    end
    local primary = selected.primary == true
    local melee = selected.melee == true
    if not primary and not melee then
        primary = true
    end
    return { primary = primary, secondary = false, melee = melee }
end

local function selectionHas(kind)
    return selectedWeaponTable()[kind] == true
end

local function selectedSlots()
    local selected = selectedWeaponTable()
    local out = {}
    if selected.primary then out[#out + 1] = 1 end
    if selected.secondary then out[#out + 1] = 2 end
    if selected.melee then out[#out + 1] = 3 end
    return out
end

local function wantSlot()
    local current = modules.fighter and modules.fighter.LocalFighter and modules.fighter.LocalFighter.EquippedItem
    local currentSlot = whichSlot(current)
    local slots = selectedSlots()
    if currentSlot then
        for _, slot in ipairs(slots) do
            if slot == currentSlot then
                return slot
            end
        end
    end
    return slots[1] or 1
end

local function pickMelee()
    return selectionHas("melee") and not selectionHas("primary") and not selectionHas("secondary")
end

local function nextSelectedSlot(currentSlot)
    local slots = selectedSlots()
    if #slots == 0 then return 1 end
    if #slots == 1 then return slots[1] end
    for i, slot in ipairs(slots) do
        if slot == currentSlot then
            return slots[(i % #slots) + 1]
        end
    end
    return slots[1]
end

local function getammo()
    if isInfiniteWeapon() then return nil, nil, false end
    local success, controller = pcall(function()
        return safeRequire(player.PlayerScripts.Controllers.FighterController)
    end)
    if success and controller and controller.LocalFighter and controller.LocalFighter.EquippedItem then
        local item = controller.LocalFighter.EquippedItem
        local itemName, current, maxAmmo = "", 0, 0
        local isMelee = false
        local ok = pcall(function()
            itemName = tostring(item:Get("Name") or item.Name or "")
            current = item:Get("CurrentAmmo") or item:Get("Ammo") or 0
            maxAmmo = item:Get("MaxAmmo") or item:Get("MaxBullets") or current
            if type(itemName) == "string" and itemName:lower():find("melee", 1, true) then
                isMelee = true
            end
            if MELEE_NMS[itemName] then isMelee = true end
        end)
        if not ok then
            return 0, 0, pickMelee()
        end
        if pickMelee() then isMelee = true end
        return tonumber(current) or 0, tonumber(maxAmmo) or 0, isMelee
    end
    return 0, 0, pickMelee()
end

local function meleeNm(nm)
    if type(nm) ~= "string" or nm == "" then return false end
    if nm:lower():find("melee", 1, true) then return true end
    return MELEE_NMS[nm] == true
end

local function itemMelee(item)
    if not item then return false end
    local nm = item:Get("Name") or item.Name
    if meleeNm(nm) then return true end
    local t = item:Get("ItemType") or item:Get("Type") or item:Get("Category")
    return type(t) == "string" and t:lower():find("melee", 1, true) ~= nil
end

local function isSling(weapon)
