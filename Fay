        pitch = 0,
        yaw = 0,
        customPitch = 0,
        customYaw = 0,
        floorHide = false,
        physicsRep = nil,
    }

    Ragebot.desync = desyncState

    local function unbindDesync()
        pcall(function()
            runsvc:UnbindFromRenderStep(DESYNC_STEP_NAME)
        end)
    end

    local function getDesyncCFrame(hrp)
        local base = hrp.CFrame
        local yaw = math.rad(desyncState.yaw)
        local pitch = math.rad(desyncState.pitch)
        local customYaw = math.rad(desyncState.customYaw)
        local customPitch = math.rad(desyncState.customPitch)

        return CFrame.new(base.Position)
            * CFrame.Angles(0, yaw + customYaw, 0)
            * CFrame.Angles(pitch + customPitch, 0, 0)
    end

    local function applyDesync(hrp, rep, cframe)
        if rep and rep.Parent then
            rep.CFrame = cframe
        end

        if hrp and hrp.Parent then
            -- Keep the visible root aligned with the same desync transform.
            hrp.CFrame = cframe
        end
    end

    function Ragebot:setupDesync()
        if Ragebot._desyncBound then
            return
        end
        Ragebot._desyncBound = true

        runsvc:BindToRenderStep(DESYNC_STEP_NAME, Enum.RenderPriority.Camera.Value, function()
            local rageOn = Toggles.RagebotEnabled and Toggles.RagebotEnabled.Value
            local antiAimOn = Toggles.RagebotAntiAim and Toggles.RagebotAntiAim.Value

            if not rageOn or not antiAimOn then
                local character = player.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                local rep = character and (character:FindFirstChild("PhysicsRepRootPart") or hrp)

                if rep and hrp then
                    rep.CFrame = hrp.CFrame
                end
                desyncState.physicsRep = rep
                return
            end

            local character = player.Character
            if not character then
                return
            end

            local hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then
                return
            end

            desyncState.enabled = true
            desyncState.pitch = tonumber(Options.RagebotAntiAimPitch.Value) or 0
            desyncState.yaw = tonumber(Options.RagebotAntiAimYaw.Value) or 0
            desyncState.customPitch = tonumber(Options.RagebotAntiAimCustomPitch.Value) or 0
            desyncState.customYaw = tonumber(Options.RagebotAntiAimCustomYaw.Value) or 0
            desyncState.floorHide = Toggles.RagebotAntiAimFloorHide
                and Toggles.RagebotAntiAimFloorHide.Value or false

            local rep = character:FindFirstChild("PhysicsRepRootPart") or hrp
            desyncState.physicsRep = rep

            if desyncState.floorHide and hrp.Position.Y < 8 then
                applyDesync(
                    hrp,
                    rep,
                    hrp.CFrame * CFrame.new(0, -3, 0)
                )
                return
            end

            applyDesync(hrp, rep, getDesyncCFrame(hrp))
        end)
    end

    function Ragebot:unbindDesync()
        unbindDesync()
        Ragebot._desyncBound = false
        desyncState.enabled = false
        desyncState.physicsRep = nil
    end

    Ragebot:setupDesync()
end

