local ragePartGlue = {}
function ragePartGlue:Acquire(item, targetPart)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or targetPart.Position
    local targetPosition = targetPart.Position
    if item and item.Get then
        pcall(function()
            local offset = item:Get("AttackOffset")
            if typeof(offset) == "Vector3" then
                targetPosition += offset
            end
        end)
    end
    if (targetPosition - origin).Magnitude <= 1e-4 then
        return CFrame.new(targetPosition)
    end
    return CFrame.lookAt(origin, targetPosition)
end


ragePlanner._partGlue = ragePartGlue

local function kiciaPlanPosition(targetChar, hitPart)
    if not hitPart then return nil end
    local state
    pcall(function()
        state = targetChar and (targetChar:GetAttribute("FighterState") or targetChar:GetAttribute("State"))
    end)
    if tostring(state) == "Below" then
        return hitPart.Position + Vector3.new(0, -3, 0)
    end
    return hitPart.Position + Vector3.new(0, 0.5, 0)
end

local function buildKiciaAttack(item, targetChar, hitPart, aimPosition)
    if not item or not targetChar or not hitPart then return nil end
    local localChar = LocalPlayer.Character
    local root = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or hitPart.Position
    local planned = aimPosition or kiciaPlanPosition(targetChar, hitPart) or hitPart.Position
    local acquire = ragePartGlue:Acquire(item, hitPart)
    local attackPosition = acquire.Position
    if (planned - attackPosition).Magnitude > 0.001 then
        attackPosition = planned
    end
    local lookCF = CFrame.lookAt(attackPosition, hitPart.Position)
    local rootCF = root and root.CFrame
    local rx, ry, rz = 0, 0, 0
    if rootCF then
        rz, ry, rx = rootCF:ToOrientation()
    end
    local attackCF = CFrame.lookAt(attackPosition, hitPart.Position)
    return lookCF, attackCF, {part = hitPart}, origin
end

local function performKnifeRageAttack(item, targetChar, hitPart, aimPosition)
    if not item or not targetChar or not hitPart or not isKnifeItem(item) then return false end
    local now = os.clock()
    if meleeAttackState.lastTarget ~= targetChar or meleeAttackState.lastWeapon ~= item then
        resetKnifeAttackState()
    end
    meleeAttackState.lastTarget = targetChar
    meleeAttackState.lastWeapon = item
    local lookCF, attackCF, attackArgs = buildKiciaAttack(item, targetChar, hitPart, aimPosition)
    if not lookCF then return false end
    local function doHeavyAttack()
        local ok = false
        local encodedLook, encodedAttack
        local encodeOK = pcall(function()
            encodedLook = modules.utility:EncodeCFrame(lookCF)
            encodedAttack = modules.utility:EncodeCFrame(attackCF)
        end)
        if encodeOK and type(item.HeavyAttackEncoded) == "function" then
            ok = pcall(function()
                item:HeavyAttackEncoded(encodedLook, encodedAttack, hitPart, CFrame.lookAt)
            end)
        end
        if not ok and type(item.HeavyAttack) == "function" then
            ok = pcall(function()
                item:HeavyAttack(lookCF, attackCF, attackArgs)
            end)
        end
        if not ok and type(item.StartAiming) == "function" and type(item.HeavyAttack) == "function" then
            local aimOK = pcall(function() item:StartAiming(aimPosition or hitPart.Position) end)
            if aimOK then
                ok = pcall(function() item:HeavyAttack(aimPosition or hitPart.Position) end)
            end
        end
        return ok
    end
    if now < meleeAttackState.hitboxWindowUntil then
        if not doHeavyAttack() then return false end
        meleeAttackState.lastAttack = now
        ragePerf.lastAttackTick = now
        config.target.lastchar = targetChar
        if config.voidspam.enabled and config.voidspam.phase == "shoot" then config.voidspam.shotIssued = true end
        hideShot()
        return true
    end
    if now < meleeAttackState.attackCooldown then return false end
    recordKnifeBackstab(now)
    if not doHeavyAttack() then
        meleeAttackState.hitboxWindowUntil = -math.huge
        return false
    end
    meleeAttackState.lastAttack = now
    ragePerf.lastAttackTick = now
    config.target.lastchar = targetChar
    if config.voidspam.enabled and config.voidspam.phase == "shoot" then config.voidspam.shotIssued = true end
    hideShot()
    return true
end

