function ragePlanner:ShouldPlan(target, distance, shootFrames)
    local threshold = (tonumber(distance) or 0) * math.clamp(math.floor(tonumber(shootFrames) or 1), 1, 5)
    if not self._shootLock:ShouldFire(target, threshold) then
        self._attackStart = nil
        return false
    end
    local now = os.clock()
    if not self._attackStart then
        self._attackStart = now
        return false
    end
    return now - self._attackStart >= 0.06666666666666667
end

