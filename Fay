local Exploits = (function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    local Exploits = {}
    Exploits.__index = Exploits

    function Exploits.new(clientFighter, clientItem)
        local self = setmetatable({}, Exploits)
        self.clientFighter = clientFighter
        self.clientItem = clientItem
        self.lastShot = 0

        local function getEquippedItem(character)
            return character and character:FindFirstChild("EquippedItem")
        end

        local function getCurrentItem()
            local item = getEquippedItem(LocalPlayer.Character)
            if item then
                self.clientItem = item
                return item
            end
            return self.clientItem
        end

        local function fullAuto()
            if not Toggles.exploits_full_auto or not Toggles.exploits_full_auto.Value then
                return
            end

            local item = getCurrentItem()
            if not item then return end

            local info = item:FindFirstChild("Info") or item.Info
            if not info then return end

            local itemType
            pcall(function() itemType = info.Type end)
            if itemType ~= "Gun" then return end

            local interval = 60 / 600
            local now = tick()
            if now - self.lastShot < interval then return end
            self.lastShot = now

            pcall(function()
                local camera = workspace.CurrentCamera
                if not camera then return end

                local direction = camera.CFrame.Position + camera.CFrame.LookVector * 100

                if self.clientItem and type(self.clientItem.StartShooting) == "function" then
                    self.clientItem:StartShooting(direction)
                elseif type(item.StartShooting) == "function" then
                    item:StartShooting(direction)
                end
            end)
        end

        function self:removeSpread(payload)
            if not ModSettings.NoSpread then
                return payload
            end

            if type(payload) == "table" then
                payload.spread = 0
                payload.randomSpread = 0
            end

            return payload
        end

        function self:forceBackstab(character)
            if not Toggles.exploits_always_backstab
                or not Toggles.exploits_always_backstab.Value then
                return false
            end
            local item = getCurrentItem()
            if not item or not isKnifeItem(item) then return false end
            if not character or not character.Parent then return false end
            local hitPart = character:FindFirstChild("Head")
                or character:FindFirstChild("HumanoidRootPart")
            if not hitPart then return false end
            local targetRoot = character:FindFirstChild("HumanoidRootPart")
            local aimPosition = targetRoot and targetRoot.Position or hitPart.Position
            return performKnifeRageAttack(item, character, hitPart, aimPosition)
        end

        local function autoRespawn()
            if not Toggles.arcade_auto_respawn or not Toggles.arcade_auto_respawn.Value then
                return
            end

            local character = LocalPlayer.Character
            local hum = character and character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                task.wait(1)
                pcall(function() LocalPlayer:LoadCharacter() end)
            end
        end

        local function autoAmmo()
            if not Toggles.arcade_auto_ammo or not Toggles.arcade_auto_ammo.Value then
                return
            end

            local item = getCurrentItem()
            if not item then return end

            local data = item:FindFirstChild("Data") or item.Data
            if not data then return end

            local ammo, reserve
            pcall(function()
                ammo = data.Ammo
                reserve = data.AmmoReserve
            end)

            if ammo == 0 and tonumber(reserve) and reserve > 0 then
                pcall(function()
                    if type(item.StartReloading) == "function" then
                        item:StartReloading()
                    end
                end)
            end
        end

        function self:grenadeSettings(character)
            local settings = Options.exploits_grenade_settings
                and Options.exploits_grenade_settings.Value or {}

            local item = getEquippedItem(character)
            if not item then return end

            local info = item:FindFirstChild("Info") or item.Info
            if not info then return end

            local itemType
            pcall(function() itemType = info.Type end)
            if itemType ~= "Grenade" then return end

            if settings["cook on throw"] then
                pcall(function()
                    if type(item.StartCooking) == "function" then
                        item:StartCooking()
                    end
                end)
            end

            if settings["always backstab"] then
                pcall(function()
                    if type(item.ThrowBackstab) == "function" then
                        item:ThrowBackstab()
                    end
                end)
            end
        end

        self.connections = {
            RunService.Heartbeat:Connect(fullAuto),
            RunService.Heartbeat:Connect(autoRespawn),
            RunService.Heartbeat:Connect(autoAmmo),
            RunService.Heartbeat:Connect(function()
                self:grenadeSettings(LocalPlayer.Character)
            end),
        }

        return self
    end

    function Exploits:Destroy()
        if self.connections then
            for _, connection in ipairs(self.connections) do
                pcall(function() connection:Disconnect() end)
            end
            self.connections = nil
        end
    end

    return Exploits
end)()

