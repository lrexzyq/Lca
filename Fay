local function safeRequire(obj)
    if not obj then return nil end
    local success, res = pcall(require, obj)
    if success then return res end
    return nil
end

local function safeFindPath(root, ...)
    local current = root
    for i = 1, select("#", ...) do
        if not current then return nil end
        local name = select(i, ...)
        current = current:FindFirstChild(name)
    end
    return current
end

local function safeRequirePath(root, ...)
    return safeRequire(safeFindPath(root, ...))
end

local function safeCloneRef(obj)
    if type(cloneref) == "function" then
        local ok, result = pcall(cloneref, obj)
        if ok and result then
            return result
        end
    end
    return obj
end

local function worldToScreen(pos)
    local cam = Workspace.CurrentCamera
    if not cam or typeof(pos) ~= "Vector3" then
        return Vector2.zero, false
    end
    local vec, onScreen = cam:WorldToViewportPoint(pos)
    return Vector2.new(vec.X, vec.Y), onScreen
end

