local function snapVoid(hrp)
    if not hrp or lobbyCache() then return end
    vfrSnap.cf = hrp.CFrame
    vfrSnap.lv = hrp.AssemblyLinearVelocity
    vfrSnap.av = hrp.AssemblyAngularVelocity
    local range = math.max(5, math.min(10000000000, tonumber(config.voidspam.range) or 10000))
    pcall(function()
        local p = Vector3.new(
            randomRangeCoordinate(range),
            -math.max(100000, math.min(10000000000, range * 10)),
            randomRangeCoordinate(range)
        )
        local v = Vector3.new(
            randomRangeCoordinate(range),
            randomRangeCoordinate(range),
            randomRangeCoordinate(range)
        )
        hrp.CFrame = CFrame.new(p) * CFrame.Angles(math.pi, math.pi, math.pi)
        hrp.AssemblyLinearVelocity = v
        hrp.AssemblyAngularVelocity = v
    end)
end

