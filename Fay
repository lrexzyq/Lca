local Triggerbot = {}
Triggerbot.__index = Triggerbot

local TRIGGERBOT_HITBOXES = {
    HitboxBody = true,
    HitboxHead = true,
    PhysicalHitboxHead = true,
    HitboxBodySmall = true,
    HitboxHeadSmall = true,
    FakeMass = true,
}

function Triggerbot.new()
    local self = setmetatable({}, Triggerbot)
    self.connections = {}
    self.lastTarget = nil
    self.lastTargetTime = 0
    self.rayParams = RaycastParams.new()
    self.rayParams.FilterType = Enum.RaycastFilterType.Exclude
    self.forgetTime = 0.15
    self.nextTargetDelay = 0

    local function getToggle(name)
        return Toggles[name] and Toggles[name].Value or false
    end

    local function getOption(name, default)
        local option = Options[name]
        if not option then return default end
        local value = option.Value
        return value == nil and default or value
    end

    local function buildFilter()
        local filter = {}
        local function add(container)
            if container and container.Parent then
                table.insert(filter, container)
            end
        end
        add(Workspace:FindFirstChild("characters"))
        add(Workspace:FindFirstChild("viewmodels"))
        add(LocalPlayer.Character)
        self.rayParams.FilterDescendantsInstances = filter
        pcall(function() self.rayParams.CollisionGroup = "NoCollide" end)
    end

    local function getEquippedItem(character)
        if not character then return nil end
        local item = character:FindFirstChild("EquippedItem")
        if item then return item end
        return character:FindFirstChildOfClass("Tool")
    end

    local function getInfo(item)
        if not item then return nil end
        local child = item:FindFirstChild("Info")
        if child then return child end
        local ok, value = pcall(function() return item.Info end)
        if ok then return value end
        return nil
    end

    local function getItemType(item)
        local info = getInfo(item)
        if not info then return nil end
        if typeof(info) == "Instance" then
            local typeValue = info:FindFirstChild("Type")
            if typeValue and typeValue:IsA("StringValue") then return typeValue.Value end
        end
        local ok, value = pcall(function() return info.Type end)
        if ok and type(value) == "string" then return value end
        return nil
    end

    local function isAiming(item)
        if not item then return false end
        local ok, value = pcall(function()
            if type(item.IsFullyAiming) == "function" then
                return item:IsFullyAiming()
            end
            return false
        end)
        return ok and value == true
    end

    local function scopedWeaponAllowed(item)
        local list = getOption("triggerbot_scoped", {})
        if type(list) ~= "table" then return false end
        if next(list) == nil then return true end
        local itemName = tostring(item.Name or "")
        local info = item:FindFirstChild("Info")
        local infoName = ""
        if info then
            local nameValue = info:FindFirstChild("Name")
            if nameValue and nameValue:IsA("StringValue") then
                infoName = nameValue.Value
            else
                local ok, value = pcall(function() return info.Name end)
                if ok and type(value) == "string" then infoName = value end
            end
        end
        for weaponName, enabled in pairs(list) do
            if enabled then
                local wanted = tostring(weaponName)
                if itemName == wanted or infoName == wanted then
                    return true
                end
            end
        end
        return false
    end

    local function getTarget()
        local cam = Workspace.CurrentCamera
        if not cam then return nil end
        buildFilter()
        local maxDistance = math.max(0, tonumber(getOption("triggerbot_max_distance", 500)) or 500)
        local result = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * maxDistance, self.rayParams)
        if not result or not result.Instance then return nil end

        local hit = result.Instance
        local blacklist = getOption("triggerbot_part_blacklist", {})
        if type(blacklist) == "table" and blacklist[hit.Name] then return nil end
        if not TRIGGERBOT_HITBOXES[hit.Name] then return nil end

        local character = hit:FindFirstAncestorOfClass("Model")
        if not character then return nil end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return nil end
        local ally = character:FindFirstChild("_is_ally")
        if ally and ally.Value then return nil end
        local player = Players:GetPlayerFromCharacter(character)
        if not player or player == LocalPlayer then return nil end

        return {
            part = hit,
            character = character,
            player = player,
            position = result.Position,
        }
    end

    local function keyHeld()
        local keybind = Options.triggerbot_keybind
        if not keybind then return true end
        local mode = keybind.Mode or "Toggle"
        if mode == "Always" then return true end
        if mode == "Hold" then
            local key = keybind.Value
            if typeof(key) == "EnumItem" then
                return UserInputService:IsKeyDown(key)
            end
            return false
        end
        if mode == "Press" then
            return keybind:GetState()
        end
        if type(keybind.GetState) == "function" then
            return keybind:GetState()
        end
        return false
    end

    local function antiKatanaCheck(character)
        local settings = getOption("triggerbot_settings", {})
        if not settings["anti katana"] then return true end
        local equipped = getEquippedItem(character)
        if not equipped then return true end
        local itemType = getItemType(equipped)
        return itemType ~= "Melee" and string.lower(tostring(equipped.Name or "")) ~= "katana"
    end

    local function shouldShoot()
        if not getToggle("triggerbot_enabled") then return false end
        if not keyHeld() then return false end
        local character = LocalPlayer.Character
        local item = getEquippedItem(character)
        if not item then return false end
        local settings = getOption("triggerbot_settings", {})
        local itemType = getItemType(item)
        if settings["scoped only"] and itemType == "Gun" and not isAiming(item) then
            return false
        end
        if settings["scoped only"] and itemType ~= "Gun" then
            return false
        end
        if next(settings) ~= nil and settings["scoped weapon filter"] and not scopedWeaponAllowed(item) then
            return false
        end
        local now = tick()
        self.forgetTime = tonumber(getOption("triggerbot_forget_time", self.forgetTime)) or self.forgetTime
        if self.lastTarget and now - self.lastTargetTime > self.forgetTime then
            self.lastTarget = nil
        end
        if settings["no delay between targets"] then
            self.nextTargetDelay = 0
        else
            self.nextTargetDelay = math.max(0, tonumber(getOption("triggerbot_target_delay", 0)) or 0)
        end
        return true
    end

    local function fire(target)
        local character = LocalPlayer.Character
        local item = getEquippedItem(character)
        if not item or not target then return end
        if not keyHeld() or not getToggle("triggerbot_enabled") then return end
        local ok = pcall(function()
            if type(item.StartShooting) == "function" then
                item:StartShooting(target.position)
                return
            end
            local input = item.Input
            if type(input) == "function" then
                input(target.position)
            end
        end)
        if not ok then
            pcall(function()
                local input = item.Input
                if type(input) == "function" then input(target.position) end
            end)
        end
    end

    Options.triggerbot_forget_time:OnChanged(function(value)
        self.forgetTime = tonumber(value) or self.forgetTime
    end)

    table.insert(self.connections, RunService.Heartbeat:Connect(function()
        if not shouldShoot() then return end
        local target = getTarget()
        if not target then return end
        local now = tick()
        if self.lastTarget and target.character ~= self.lastTarget and now - self.lastTargetTime < self.nextTargetDelay then
            return
        end
        if not antiKatanaCheck(target.character) then return end
        self.lastTarget = target.character
        self.lastTargetTime = now
        local reaction = math.max(0, tonumber(getOption("triggerbot_reaction_time", 0)) or 0)
        local offset = tonumber(getOption("triggerbot_reaction_time_offset", 0)) or 0
        local shootDelay = math.max(0, tonumber(getOption("triggerbot_shoot_delay", 0)) or 0)
        task.delay((reaction + offset) / 1000, function()
            task.wait(shootDelay / 1000)
            fire(target)
        end)
    end))

    table.insert(self.connections, RunService.RenderStepped:Connect(function()
        buildFilter()
    end))

    return self
end

function Triggerbot:destroy()
    for _, connection in ipairs(self.connections) do
        pcall(function() connection:Disconnect() end)
    end
    self.connections = {}
end


