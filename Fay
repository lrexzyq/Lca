    flickHumanness = 0.3,
    shootAfterFlick = false,
    shotDelay = 0.05,
    cooldown = 0.2,
    fireMode = "FireServer",

    _state = "Idle",
    _trajectory = nil,
    _trajectoryIndex = 1,
    _elapsed = 0,
    _total = 0,
