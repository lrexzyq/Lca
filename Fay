local function tickVoidSpam()
    if not config.voidspam.enabled then return end

    local hasTarget = config.target.character and valid(config.target.character)


    if not hasTarget then
        if config.voidspam.phase ~= "hide" then
            config.voidspam.phase = "hide"
            config.voidspam.shotIssued = false
            config.voidspam.currentduration = math.huge
            config.voidspam.lastswitch = tick()
        end
        return
    end


    if config.voidspam.phase == "hide" and config.voidspam.currentduration == math.huge then
        config.voidspam.phase = "shoot"
        config.voidspam.shotIssued = false
        config.voidspam.currentduration = randVs(
            config.voidspam.shoot_min,
            config.voidspam.shoot_max
        )
        config.voidspam.lastswitch = tick()
        return
    end


    if config.state.outofammo or config.state.reloading then
        config.voidspam.phase = "hide"
        config.voidspam.shotIssued = false
        config.voidspam.currentduration = math.huge
        config.voidspam.lastswitch = tick()
        return
    end

    local now = tick()
    local elapsed = now - config.voidspam.lastswitch

    if config.voidspam.phase == "shoot" then

        if config.voidspam.shotIssued then
            config.voidspam.phase = "hide"
            config.voidspam.currentduration = randVs(
                config.voidspam.hide_min,
                config.voidspam.hide_max
            )
            config.voidspam.lastswitch = now
        elseif elapsed >= config.voidspam.currentduration then

            config.voidspam.currentduration = randVs(
                config.voidspam.shoot_min,
                config.voidspam.shoot_max
            )
            config.voidspam.lastswitch = now
        end
    elseif config.voidspam.phase == "hide" then
        if elapsed >= config.voidspam.currentduration then
            config.voidspam.phase = "shoot"
            config.voidspam.shotIssued = false
            config.voidspam.currentduration = randVs(
                config.voidspam.shoot_min,
                config.voidspam.shoot_max
            )
            config.voidspam.lastswitch = now
        end
    else
        config.voidspam.phase = "shoot"
        config.voidspam.shotIssued = false
        config.voidspam.currentduration = randVs(
            config.voidspam.shoot_min,
            config.voidspam.shoot_max
        )
        config.voidspam.lastswitch = now
    end
end

