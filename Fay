        if WeaponModOriginals.Gun.ShootBurst == nil and Gun.ShootBurst then WeaponModOriginals.Gun.ShootBurst = Gun.ShootBurst end
        if ModSettings.NoShootAnimation then
            if Gun.StartShooting and WeaponModOriginals.Gun.StartShooting then
