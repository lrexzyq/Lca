    Text = "Mode",
    Values = { "Normal", "Translocate" },
    Default = Ragebot.config.target.evasion.mode == "Translocate" and "Translocate" or "Normal",
    Callback = function(v)
        local mode = tostring(v or "Normal")
        local current = Ragebot.config.target.evasion.mode
        if mode == "Translocate" then
            if Ragebot.stopvoid then Ragebot.stopvoid() end
            if Ragebot.stopTranslocateSync then Ragebot.stopTranslocateSync() end
            Ragebot.config.target.evasion.mode = "Translocate"
            if Ragebot.enabled and Ragebot.startTranslocateSync then
                Ragebot.startTranslocateSync()
            end
        else
            if Ragebot.stopTranslocateSync then Ragebot.stopTranslocateSync() end
            Ragebot.config.target.evasion.mode = "Normal"
            if Ragebot.enabled and Ragebot.refreshAtk then
                Ragebot.refreshAtk()
            end
            if Ragebot.config.target.enabled and Ragebot.config.target.character and Ragebot.config.target.autoshoot then
                if Ragebot.startsync then Ragebot.startsync() end
            end
        end
    end
})

