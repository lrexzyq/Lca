local function manageSwapReload()
    if not Ragebot.enabled or config.target.evasion.mode == "Translocate" then return false end
    local lf = modules.fighter and modules.fighter.LocalFighter
    local currentItem = lf and lf.EquippedItem
    if not currentItem or itemMelee(currentItem) then return false end
    if isInfiniteWeapon() then return false end
    local currentAmmo, _, melee = getammo()
    if melee or (tonumber(currentAmmo) or 0) > 0 then return false end
    local mode = tostring(config.target.swapReloadMode or "Swap & Reload")
    local currentSlot = whichSlot(currentItem) or wantSlot()
    local selected = selectedWeaponTable()
    local selectedCount = 0
    for _, enabled in pairs(selected) do
        if enabled then
            selectedCount = selectedCount + 1
        end
    end
    local hasAlternate = selectedCount > 1
    local shouldReload = (not hasAlternate) or mode == "Swap & Reload" or mode == "Reload, No Swap"
    local shouldSwap = hasAlternate and (mode == "Swap & Reload" or mode == "Swap, No Reload")
    if shouldReload then
        reloadCurrentItem(currentItem)
    end
    if not shouldSwap then return false end
    local nextSlot = nextSelectedSlot(currentSlot)
    if nextSlot == currentSlot then return false end
    config.target.weaponPick = (nextSlot == 1 and "primary") or (nextSlot == 2 and "secondary") or "melee"
    eqSlot()
    return true
end

local function autoshoot()

    if config.target.evasion.mode == "Translocate" then return end
    if not config.target.enabled or not config.target.character or not valid(config.target.character) or not config.target.autoshoot then return end
    if config.voidspam.enabled and config.voidspam.phase == "hide" then return end
    if config.target.immune then return end
    local weapon = getweapon()
    local checksling = isSling(weapon)
    eqSlot()
    local lf = modules.fighter and modules.fighter.LocalFighter
    if not lf or not lf.EquippedItem then return end

    local equipped = lf.EquippedItem
    local now = tick()
    local shootFrames = math.clamp(math.floor(tonumber(config.target.shootFrames) or 1), 1, 5)
    local frameDelay = 0.06666666666666667 * shootFrames
    local targetLock = config.target.character
    if now < rageNextAttackAt then return end
    local targetRootForLock = targetLock and targetLock:FindFirstChild("HumanoidRootPart")
    local myRootForLock = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local lockDistance = (targetRootForLock and myRootForLock) and (targetRootForLock.Position - myRootForLock.Position).Magnitude or 0
    if not ragePlanner:ShouldPlan(targetLock, lockDistance, shootFrames) then return end

    if itemMelee(equipped) then
        if not isKnifeItem(equipped) then return end
        local targetChar = config.target.character
        if not valid(targetChar) then return end
        local hitPart = hitpartfromname(targetChar, config.target.hitpart)
        if not hitPart then return end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local origin = root and root.Position or hitPart.Position
        local plannedPos = kiciaPlanPosition(targetChar, hitPart) or hitPart.Position
        local targetPos = predict(hitPart, origin)
        if targetPos == hitPart.Position then
            targetPos = plannedPos
        end
        local didAttack = performKnifeRageAttack(equipped, targetChar, hitPart, targetPos)
        if didAttack then
            rageShootLock.interval = frameDelay
            rageShootLock.nextAt = os.clock() + frameDelay
        end
        return
    end
    if not isInfiniteWeapon() then
        if config.state.reloading or config.state.outofammo then return end
        if (config.state.reloadReadyAt or 0) > tick() then return end
        if not canuse() then return end
    end
    local targetChar = config.target.character
    if not valid(targetChar) then
        ragePlanner:ResetState()
        return
    end
    local hitPart = hitpartfromname(targetChar, config.target.hitpart)
    if not hitPart then return end
    local shootPos
    local targetPos
    if vhState and vhState.active and checksling then
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        shootPos = root and root.Position or Vector3.new()
        targetPos = predict(hitPart)
    else
        if vhState and vhState.active then
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            shootPos = myRoot and myRoot.Position or Vector3.new()
        elseif config.state.csyncactive and config.orbit.serverpos then
            shootPos = config.orbit.serverpos
        else
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            shootPos = root and root.Position or Vector3.new()
        end
        targetPos = predict(hitPart)
    end
    local lookCF = CFrame.new(shootPos, targetPos)
    local encodedLook = modules.utility:EncodeCFrame(lookCF)
    local data = {
        [utf8.char(1)] = {
            [utf8.char(0)] = encodedLook,
            [utf8.char(1)] = encodedLook,
            [utf8.char(2)] = hitPart,
            [utf8.char(3)] = modules.utility:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42)),
        },
    }
    local equipped = lf.EquippedItem
    if equipped and equipped:Get("ObjectID") then
        local encodedAttackFn = equipped.AttackEncoded
        if type(encodedAttackFn) == "function" then
            local encodedOK = pcall(function()
                encodedAttackFn(equipped, encodedLook, encodedLook, hitPart, modules.utility)
            end)
            if encodedOK then
                ragePerf.lastAttackTick = now
                rageNextAttackAt = now + frameDelay
                rageShootLock.interval = frameDelay
                rageShootLock.nextAt = now + frameDelay
                if config.voidspam.enabled and not isSling(getweapon()) and config.voidspam.phase == "shoot" then
                    config.voidspam.shotIssued = true
                end
                hideShot()
                return
            end
        end
        ragePerf.lastAttackTick = tick()
        local attempts = math.clamp(math.floor(tonumber(config.target.shootAttempts) or 1), 1, 3)
        for _ = 1, attempts do
            pcall(function()
                replicatedstorage.Remotes.Replication.Fighter.UseItem:FireServer(
                    equipped:Get("ObjectID"),
                    modules.enums:ToEnum("StartShooting"),
                    data,
                    nil
                )
            end)
        end

        rageNextAttackAt = now + frameDelay
        rageShootLock.interval = frameDelay
        rageShootLock.nextAt = os.clock() + frameDelay
        ragePlanner._attackStart = nil
        if config.voidspam.enabled and not isSling(getweapon())
            and config.voidspam.phase == "shoot" then
            config.voidspam.shotIssued = true
        end
        hideShot()
    end
end

