local function valid(char)
    if not char or not char.Parent then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    local targetplayer = Players:GetPlayerFromCharacter(char)
    if not targetplayer or isteammate(targetplayer) then return false end
    return true
end

local function closestplayerinfov(radius)
    local center = silentfovcenter()
    local best, bestDist = nil, math.huge
    local cam = Workspace.CurrentCamera
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local char = p.Character
            if valid(char) then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local sp, onScreen = worldToScreen(root.Position)
                    if onScreen then
                        local dx = sp.X - center.X
                        local dy = sp.Y - center.Y
                        local dist = math.sqrt(dx*dx + dy*dy)
                        if dist <= radius and dist < bestDist then
                            best = char
                            bestDist = dist
                        end
                    end
                end
            end
        end
    end
    return best
end

