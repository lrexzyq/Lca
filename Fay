local function drawingNew(kind)
    if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then
        return nil
    end
    local ok, object = pcall(Drawing.new, kind)
    if ok then return object end
    return nil
end

function ESP.new()
    local self = setmetatable({}, ESP)
    self.players = {}
    self.connections = {}
    self.events = {
        esp_color_changed = Instance.new("BindableEvent"),
        esp_fill_changed = Instance.new("BindableEvent"),
        esp_effects_changed = Instance.new("BindableEvent"),
        esp_effects_color_changed = Instance.new("BindableEvent"),
    }
    return self
end

function ESP:cleanupState(state)
    if not state then return end
    for _, connection in ipairs(state.connections or {}) do
        pcall(function() connection:Disconnect() end)
    end
    state.connections = {}
    for _, drawing in ipairs(state.drawings or {}) do
        pcall(function() drawing.Visible = false end)
        pcall(function() drawing:Remove() end)
    end
    state.drawings = {}
    if state.character then
        for _, name in ipairs({"ESP_Aura", "ESP_Particles", "ESP_Chams", "ESP_WorldName", "ESP_WorldDistance", "ESP_WorldImage"}) do
            local object = state.character:FindFirstChild(name)
            if object then pcall(function() object:Destroy() end) end
        end
    end
end

function ESP:createState(player, character)
    local state = {
        player = player,
        character = character,
        humanoid = nil,
        humanoidRootPart = nil,
        health = 0,
        maxHealth = 150,
        parts = {},
        corners = {},
        connections = {},
        drawings = {},
        squares = {},
        images = {},
        lines = {},
        text = {},
        lerpedHealth = nil,
        bodyOriginals = {},
    }

    for i = 1, 26 do
        local outline = i > 13
        local line = drawingNew("Line")
        if line then
            line.Visible = false
            line.Thickness = 1 + (outline and 2 or 0)
            line.Color = outline and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
            table.insert(state.drawings, line)
            table.insert(state.lines, line)
        end
    end

    for i = 1, 4 do
        local text = drawingNew("Text")
        if text then
            text.Outline = true
            text.Visible = false
            text.Color = Color3.new(1, 1, 1)
            text.Center = true
            text.Size = 12
            table.insert(state.drawings, text)
            table.insert(state.text, text)
        end
    end

    for i = 1, 4 do
        local square = drawingNew("Square")
        if square then
            square.Visible = false
            square.Outline = true
            table.insert(state.drawings, square)
            table.insert(state.squares, square)
        end
    end

    local healthBg = drawingNew("Square")
    if healthBg then
        healthBg.Visible = false
        healthBg.Filled = true
        healthBg.Color = Color3.new(0, 0, 0)
        table.insert(state.drawings, healthBg)
        table.insert(state.squares, healthBg)
    end

    local healthFill = drawingNew("Square")
    if healthFill then
        healthFill.Visible = false
        healthFill.Filled = true
        table.insert(state.drawings, healthFill)
        table.insert(state.squares, healthFill)
    end

    local image = drawingNew("Image")
    if image then
        image.Visible = false
        image.Outline = true
        image.Color = Color3.new(1, 1, 1)
        image.Filled = true
        table.insert(state.drawings, image)
        table.insert(state.images, image)
    end

    if state.squares[1] then state.squares[1].Thickness = 3 end
    if state.squares[2] then state.squares[2].ZIndex = 2; state.squares[2].Color = Color3.new(1, 1, 1) end
    if state.squares[3] then state.squares[3].ZIndex = 2; state.squares[3].Color = Color3.new(1, 1, 1); state.squares[3].Filled = true end
    if state.squares[4] then state.squares[4].Filled = true; state.squares[4].Color = Color3.new(0, 0, 0) end

    if state.text[1] then state.text[1].Text = player.Name end
    if state.text[2] then state.text[2].Text = "none" end
    if state.text[4] then
        state.text[4].Center = false
    end

    if state.images[1] then
        local fillImage = Options.esp_fill_image.Value
        local fillConfig = IMAGES[fillImage] or IMAGES.default
        state.images[1].Image = fillConfig.image
        state.images[1].Center = true
        state.fillScale = fillConfig.size
    end

    return state
end

function ESP:computeCorners(part)
    if not part or not part:IsA("BasePart") then return {} end
    local size = part.Size / 2
    local corners = {}
    local x, y, z = size.X, size.Y, size.Z
    table.insert(corners, Vector3.new(-x, -y, -z))
    table.insert(corners, Vector3.new(-x, -y, z))
    table.insert(corners, Vector3.new(-x, y, -z))
    table.insert(corners, Vector3.new(-x, y, z))
    table.insert(corners, Vector3.new(x, -y, -z))
    table.insert(corners, Vector3.new(x, -y, z))
    table.insert(corners, Vector3.new(x, y, -z))
    table.insert(corners, Vector3.new(x, y, z))
    return corners
end

function ESP:updatePlayerState(player, character)
    local state = self.players[player]
    if not state or not character then return end

    for _, connection in ipairs(state.connections or {}) do
        pcall(function() connection:Disconnect() end)
    end
    state.connections = {}

    state.character = character
    state.humanoidRootPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
    state.humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
    state.parts = {}
    state.corners = {}
    state.lerpedHealth = nil
    state.bodyOriginals = {}

    if not state.humanoid or not state.humanoidRootPart then
        state.health = 0
        state.maxHealth = 150
        return
    end

    table.insert(state.connections, state.humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if state.humanoid then state.health = state.humanoid.Health end
    end))
    table.insert(state.connections, state.humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
        if state.humanoid then state.maxHealth = state.humanoid.MaxHealth end
    end))
    state.health = state.humanoid.Health
    state.maxHealth = state.humanoid.MaxHealth

    for _, partName in ipairs(SKELETON_PARTS) do
        local part = character:FindFirstChild(partName) or character:WaitForChild(partName, 2)
        if part and part:IsA("BasePart") then
            state.parts[partName] = part
            state.corners[partName] = self:computeCorners(part)
        end
    end
end

function ESP:computeBounds(state)
    local cam = workspace.CurrentCamera
    if not cam or not state or not state.humanoidRootPart then return nil end
    local dynamic = Options.esp_bounds_type.Value == "dynamic"
    local widthScale = (tonumber(Options.esp_bounds_width_scale.Value) or 100) / 100

    local function worldToScreen(position)
        local screen, onScreen = cam:WorldToViewportPoint(position)
        return Vector2.new(screen.X, screen.Y), onScreen
    end

    if dynamic then
        local minX, minY = math.huge, math.huge
        local maxX, maxY = -math.huge, -math.huge
        local valid = false
        for partName, part in pairs(state.parts) do
            if part and part.Parent then
                local corners = state.corners[partName]
                if corners then
                    for _, offset in ipairs(corners) do
                        local screen, onScreen = worldToScreen((part.CFrame * CFrame.new(offset)).Position)
                        if onScreen then
                            valid = true
                            minX = math.min(minX, screen.X)
                            maxX = math.max(maxX, screen.X)
                            minY = math.min(minY, screen.Y)
                            maxY = math.max(maxY, screen.Y)
                        end
                    end
                end
            end
        end
        if not valid then return nil end
        local width = math.max(10, maxX - minX)
        local height = math.max(10, maxY - minY)
        return width * widthScale, height * widthScale, Vector2.new((minX + maxX) / 2, minY)
    end

    local hrp = state.humanoidRootPart
    local top, topOn = worldToScreen((hrp.CFrame * CFrame.new(0, 2.5, 0)).Position)
    local bottom, bottomOn = worldToScreen((hrp.CFrame * CFrame.new(0, -3.5, 0)).Position)
    if not topOn or not bottomOn then return nil end
    local height = math.max(10, math.abs(top.Y - bottom.Y))
    return height * 0.55 * widthScale * 2, height * widthScale, Vector2.new((top.X + bottom.X) / 2, top.Y)
end

function ESP:drawSkeleton(state)
    for _, line in ipairs(state.lines or {}) do
        pcall(function() line.Visible = false end)
    end
    if not Toggles.esp_skeleton.Value or not state.character then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local outline = Toggles.esp_skeleton_outline.Value

    for i, pair in ipairs(SKELETON_LINES) do
        local fromPart = state.parts[pair[1]]
        local toPart = state.parts[pair[2]]
        local line = state.lines[i]
        if fromPart and toPart and line then
            local from, onFrom = cam:WorldToViewportPoint(fromPart.Position)
            local to, onTo = cam:WorldToViewportPoint(toPart.Position)
            if onFrom and onTo then
                line.From = Vector2.new(from.X, from.Y)
                line.To = Vector2.new(to.X, to.Y)
                line.Color = resolveColor(Options.esp_skeleton_color.Value, Color3.new(1, 1, 1))
                line.Visible = true
                local outlineLine = state.lines[i + 13]
                if outlineLine then
                    outlineLine.From = line.From
                    outlineLine.To = line.To
                    outlineLine.Visible = outline
                end
            end
        end
    end
end

function ESP:drawBox(state, size, position)
    for i = 1, 4 do
        if state.squares[i] then state.squares[i].Visible = false end
    end
    if state.images[1] then state.images[1].Visible = false end

    local box = Toggles.esp_box.Value
    local fill = Toggles.esp_fill.Value
    if not box and not fill then return end
    local half = Vector2.new(size.X / 2, 0)

    if box and state.squares[1] and state.squares[2] then
        state.squares[1].Size = size
        state.squares[1].Position = position - half
        state.squares[1].Color = resolveColor(Options.esp_box_color.Value, Color3.new(1, 1, 1))
        state.squares[1].Visible = true
        state.squares[2].Size = size
        state.squares[2].Position = position - half
        state.squares[2].Color = Color3.new(1, 1, 1)
        state.squares[2].Visible = true
    end

    if fill then
        local fillImage = Options.esp_fill_image.Value
        if fillImage ~= "default" and state.images[1] then
            local cfg = IMAGES[fillImage] or IMAGES.default
            state.images[1].Image = cfg.image
            state.images[1].Size = size
            state.images[1].Position = position - half
            state.images[1].Visible = cfg.image ~= ""
        elseif state.squares[3] and state.squares[4] then
            state.squares[3].Size = size
            state.squares[3].Position = position - half
            state.squares[3].Color = resolveColor(Options.esp_fill_color.Value, Color3.new(1, 1, 1))
            state.squares[3].Transparency = 0.5
            state.squares[3].Visible = true
            state.squares[4].Size = size
            state.squares[4].Position = position - half
            state.squares[4].Color = Color3.new(0, 0, 0)
            state.squares[4].Transparency = 0.8
            state.squares[4].Visible = true
        end
    end
end

function ESP:drawName(state, position)
    local name = state.text[1]
    if not name then return end
    name.Visible = false
    if not Toggles.esp_name.Value then return end
    name.Text = state.player.Name
    name.Color = resolveColor(Options.esp_name_color.Value, Color3.new(1, 1, 1))
    name.Position = position - Vector2.new(0, 14)
    name.Visible = true
end

function ESP:drawWeapon(state, position)
    local weapon = state.text[2]
    if not weapon then return end
    weapon.Visible = false
    if not Toggles.esp_weapon.Value then return end
    local character = state.character
    local item = character and character:FindFirstChild("EquippedItem")
    weapon.Text = item and item.Name or "none"
    weapon.Color = resolveColor(Options.esp_weapon_color.Value, Color3.new(1, 1, 1))
    weapon.Position = position + Vector2.new(0, 2)
    weapon.Visible = true
end

function ESP:drawDistance(state, position)
    local distance = state.text[3]
    if not distance or not state.humanoidRootPart then return end
    distance.Visible = false
    if not Toggles.esp_distance.Value then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local dist = (state.humanoidRootPart.Position - cam.CFrame.Position).Magnitude
    distance.Text = "[" .. math.round(dist) .. "]"
    distance.Color = resolveColor(Options.esp_distance_color.Value, Color3.new(1, 1, 1))
    distance.Position = position + Vector2.new(0, Toggles.esp_weapon.Value and 16 or 2)
    distance.Visible = true
end

function ESP:drawHealthbar(state, size, position)
    local bg = state.squares[5]
    local fill = state.squares[6]
    if bg then bg.Visible = false end
    if fill then fill.Visible = false end
    if not Toggles.esp_healthbar.Value or not state.humanoid then return end

    local maxHealth = math.max(1, state.humanoid.MaxHealth)
    local ratio = math.clamp(state.humanoid.Health / maxHealth, 0, 1)
    local lerpSpeed = math.clamp(tonumber(Options.esp_healthbar_health_lerp.Value) or 0.2, 0, 1)
    state.lerpedHealth = state.lerpedHealth or ratio
    state.lerpedHealth = state.lerpedHealth + (ratio - state.lerpedHealth) * lerpSpeed

    local barSize = Vector2.new(4, size.Y - 2)
    if Toggles.esp_healthbar_resize.Value then
        barSize = Vector2.new(4, math.max(1, (size.Y - 2) * state.lerpedHealth))
    end

    local barPosition = position - Vector2.new(size.X / 2 + 6, -size.Y + 1)
    local bgPosition = barPosition - Vector2.new(1, -1)
    if bg then
        bg.Size = Vector2.new(6, size.Y)
        bg.Position = bgPosition
        bg.Color = Color3.new(0, 0, 0)
        bg.Visible = true
    end
    if fill then
        fill.Size = barSize
        fill.Position = barPosition
        fill.Color = resolveColor(Options.esp_healthbar_color.Value, Color3.new(0, 1, 0))
        fill.Visible = true
    end
end

function ESP:drawFlags(state, position)
    local flags = state.text[4]
    if not flags then return end
    flags.Visible = false
    if not Toggles.esp_flag_health_text.Value and not Toggles.esp_flag_staring_text.Value then return end
    local text = ""
    local prefix = Options.esp_flag_prefix.Value or "minimal"
    local prefixMap = { ["bridge only"] = "", minimal = "HP", full = "HEALTH" }
    local prefixText = prefixMap[prefix] or ""

    if Toggles.esp_flag_health_text.Value and state.humanoid then
        text = text .. "[" .. prefixText .. " " .. math.round(state.humanoid.Health) .. "]"
    end
    if Toggles.esp_flag_staring_text.Value and state.humanoidRootPart then
        local cam = workspace.CurrentCamera
        local origin = cam and cam.CFrame.Position or Vector3.zero
        local dist = (state.humanoidRootPart.Position - origin).Magnitude
        if dist < 25 then text = text .. (text ~= "" and " " or "") .. "staring" end
    end

    flags.Text = text
    flags.Color = resolveColor(Options.esp_flags_color.Value, Color3.new(1, 1, 1))
    flags.Position = position + Vector2.new(0, 16)
    flags.Visible = text ~= ""
end

function ESP:drawEffects(state)
    if not state.character then return end
    local ally = state.character:FindFirstChild("_is_ally")
    if not Toggles.esp_show_team.Value and ally and ally.Value then return end

    if Toggles.esp_effects_aura.Value then
        local aura = state.character:FindFirstChild("ESP_Aura")
        if not aura then
            aura = Instance.new("Highlight")
            aura.Name = "ESP_Aura"
            aura.FillTransparency = 1
            aura.OutlineTransparency = 0
            aura.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            aura.Parent = state.character
        end
        aura.OutlineColor = resolveColor(Options.esp_effects_aura_color1.Value, Color3.new(1, 1, 1))
        aura.Enabled = true
    else
        local aura = state.character:FindFirstChild("ESP_Aura")
        if aura then aura:Destroy() end
    end

    if Toggles.esp_effects_particle.Value and state.humanoidRootPart then
        local particleFolder = state.character:FindFirstChild("ESP_Particles")
        if not particleFolder then
            particleFolder = Instance.new("Folder")
            particleFolder.Name = "ESP_Particles"
            particleFolder.Parent = state.character
        end
        local attachment = particleFolder:FindFirstChild("Attachment")
        if not attachment then
            attachment = Instance.new("Attachment")
            attachment.Name = "Attachment"
            attachment.Parent = particleFolder
        end
        local emitter = attachment:FindFirstChild("Emitter")
        if not emitter then
            emitter = Instance.new("ParticleEmitter")
            emitter.Name = "Emitter"
            emitter.Rate = 10
            emitter.Size = NumberSequence.new(0.5)
            emitter.Lifetime = NumberRange.new(0.5)
            emitter.Parent = attachment
        end
        emitter.Color = ColorSequence.new(resolveColor(Options.esp_effects_particle_color1.Value, Color3.new(1, 1, 1)))
        emitter.Enabled = true
    else
        local particleFolder = state.character:FindFirstChild("ESP_Particles")
        if particleFolder then particleFolder:Destroy() end
    end
end

function ESP:drawWorldElements(state)
    local character = state.character
    local hrp = state.humanoidRootPart
    if not character or not hrp then return end
    local maxDistance = math.max(0, tonumber(Options.esp_world_max_distance.Value) or 150)

    local existing = character:FindFirstChild("ESP_WorldName")
    if Toggles.esp_world_name.Value then
        if not existing then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "ESP_WorldName"
            billboard.Size = UDim2.fromOffset(180, 24)
            billboard.AlwaysOnTop = true
            billboard.Adornee = hrp
            billboard.MaxDistance = maxDistance
            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.Text = character.Name
            label.TextColor3 = resolveColor(Options.esp_world_name_color.Value, Color3.new(1, 1, 1))
            label.TextStrokeTransparency = 0
            label.Parent = billboard
            billboard.Parent = character
        end
    elseif existing then
        existing:Destroy()
    end

    local distanceBillboard = character:FindFirstChild("ESP_WorldDistance")
    if Toggles.esp_world_distance.Value then
        if not distanceBillboard then
            distanceBillboard = Instance.new("BillboardGui")
            distanceBillboard.Name = "ESP_WorldDistance"
            distanceBillboard.Size = UDim2.fromOffset(120, 20)
            distanceBillboard.AlwaysOnTop = true
            distanceBillboard.Adornee = hrp
            distanceBillboard.MaxDistance = maxDistance
            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.Text = "0"
            label.TextColor3 = resolveColor(Options.esp_world_distance_color.Value, Color3.new(1, 1, 1))
            label.TextStrokeTransparency = 0
            label.Parent = distanceBillboard
            distanceBillboard.Parent = character
        else
            local label = distanceBillboard:FindFirstChildOfClass("TextLabel")
            local cam = workspace.CurrentCamera
            if label and cam then
                label.Text = "[" .. math.round((hrp.Position - cam.CFrame.Position).Magnitude) .. "]"
                label.TextColor3 = resolveColor(Options.esp_world_distance_color.Value, Color3.new(1, 1, 1))
            end
        end
    elseif distanceBillboard then
        distanceBillboard:Destroy()
    end

    local imageBillboard = character:FindFirstChild("ESP_WorldImage")
    if Toggles.esp_world_image.Value then
        if not imageBillboard then
            imageBillboard = Instance.new("BillboardGui")
            imageBillboard.Name = "ESP_WorldImage"
            imageBillboard.Size = UDim2.fromOffset(40, 40)
            imageBillboard.AlwaysOnTop = true
            imageBillboard.Adornee = hrp
            imageBillboard.MaxDistance = maxDistance
            local image = Instance.new("ImageLabel")
            image.Size = UDim2.fromScale(1, 1)
            image.BackgroundTransparency = 1
            image.Image = tostring(Options.esp_world_image_value.Value or "")
            image.Parent = imageBillboard
            imageBillboard.Parent = character
        else
            local image = imageBillboard:FindFirstChildOfClass("ImageLabel")
            if image then image.Image = tostring(Options.esp_world_image_value.Value or "") end
        end
    elseif imageBillboard then
        imageBillboard:Destroy()
    end
end

function ESP:hideAll(state)
    for _, drawing in ipairs(state.drawings or {}) do
        pcall(function() drawing.Visible = false end)
    end
end

function ESP:drawChams(state)
    if not state.character then return end
    local chams = Toggles.esp_chams.Value
    local override = Toggles.esp_override_appearance.Value
    local highlight = state.character:FindFirstChild("ESP_Chams")
    if not chams then
        if highlight then highlight:Destroy() end
        return
    end
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Chams"
        highlight.Parent = state.character
    end
    highlight.FillColor = resolveColor(Options.esp_chams_color.Value, Color3.new(1, 1, 1))
    highlight.OutlineColor = resolveColor(Options.esp_chams_color2.Value, Color3.new(0, 0, 0))
    highlight.FillTransparency = math.clamp(tonumber(Options.esp_chams_alpha_fill.Value) or 0.5, 0, 1)
    highlight.OutlineTransparency = math.clamp(tonumber(Options.esp_chams_alpha_outline.Value) or 0, 0, 1)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = true
    if override then highlight.FillColor = resolveColor(Options.esp_chams_color.Value, Color3.new(1, 1, 1)) end
end

function ESP:drawBodyAppearance(state)
    if not state.character then return end
    if not Toggles.esp_body_color.Value then
        for part, original in pairs(state.bodyOriginals) do
            if part and part.Parent then
                part.Transparency = original.Transparency
                part.Color = original.Color
            end
        end
        state.bodyOriginals = {}
        return
    end
    local transparency = math.clamp(tonumber(Options.esp_body_transparency.Value) or 0, 0, 1)
    local color = resolveColor(Options.esp_body_color_value.Value, Color3.new(1, 1, 1))
    for _, part in ipairs(state.character:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency < 1 then
            if not state.bodyOriginals[part] then
                state.bodyOriginals[part] = { Transparency = part.Transparency, Color = part.Color }
            end
            part.Transparency = transparency
            part.Color = color
        end
    end
end

function ESP:update(player)
    local state = self.players[player]
    if not state then return end

    local character = state.character
    if not character or not character.Parent then
        self:hideAll(state)
        return
    end

    local ally = character:FindFirstChild("_is_ally")
    if not Toggles.esp_show_team.Value and ally and ally.Value then
        self:hideAll(state)
        return
    end

    self:drawChams(state)
    self:drawBodyAppearance(state)
    self:drawEffects(state)
    self:drawWorldElements(state)

    local coreVisible = Toggles.esp_name.Value or Toggles.esp_distance.Value or Toggles.esp_weapon.Value
        or Toggles.esp_box.Value or Toggles.esp_fill.Value or Toggles.esp_skeleton.Value
        or Toggles.esp_healthbar.Value or Toggles.esp_flag_health_text.Value
        or Toggles.esp_flag_staring_text.Value

    if not coreVisible then
        self:hideAll(state)
        return
    end
    if not state.humanoid or not state.humanoidRootPart or state.humanoid.Health <= 0 then
        self:hideAll(state)
        return
    end

    local bounds = self:computeBounds(state)
    if not bounds then
        self:hideAll(state)
        return
    end

    local size, height, position = bounds
    local sizeVec = Vector2.new(size, height)
    self:drawSkeleton(state)
    self:drawBox(state, sizeVec, position)
    self:drawName(state, position)
    self:drawWeapon(state, position)
    self:drawDistance(state, position)
    self:drawHealthbar(state, sizeVec, position)
    self:drawFlags(state, position)
end

function ESP:start()
    if self.started then return self end
    self.started = true

    local function onPlayerAdded(player)
        if player == lp then return end
        if self.players[player] then
            self:cleanupState(self.players[player])
        end
        local state = self:createState(player, nil)
        self.players[player] = state

        table.insert(state.connections, player.CharacterAdded:Connect(function(character)
            self:updatePlayerState(player, character)
        end))
        table.insert(state.connections, player.CharacterRemoving:Connect(function()
            self:hideAll(state)
            state.character = nil
            state.humanoid = nil
            state.humanoidRootPart = nil
        end))

        if player.Character then
            task.spawn(function()
                self:updatePlayerState(player, player.Character)
            end)
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        onPlayerAdded(player)
    end
    table.insert(self.connections, Players.PlayerAdded:Connect(onPlayerAdded))
    table.insert(self.connections, Players.PlayerRemoving:Connect(function(player)
        local state = self.players[player]
        if state then
            self:cleanupState(state)
            self.players[player] = nil
        end
    end))
    table.insert(self.connections, RunService.RenderStepped:Connect(function()
        for player in pairs(self.players) do
            self:update(player)
        end
    end))

    for _, event in pairs(self.events) do
        table.insert(self.connections, event.Event:Connect(function()
            for _, state in pairs(self.players) do
                if state.character then self:drawEffects(state) end
            end
        end))
    end
    return self
end

function ESP:destroy()
    for _, connection in ipairs(self.connections) do
        pcall(function() connection:Disconnect() end)
    end
    self.connections = {}
    for player, state in pairs(self.players) do
        self:cleanupState(state)
        self.players[player] = nil
    end
    for _, event in pairs(self.events) do
        pcall(function() event:Destroy() end)
    end
    self.started = false
end


-- ============================================================================
-- Cosmetics / Skin Changer
-- ============================================================================
local Cosmetics = {}
Cosmetics.__index = Cosmetics

function Cosmetics.new()
    local self = setmetatable({}, Cosmetics)
    self.cache = {}
    self.skins = {}
    self.charms = {}
    self.finishers = {}
    self.ownableWeapons = {}
    self.connections = {}

    local function getOption(name)
        local option = Options and Options[name]
        return option and option.Value or nil
    end

    local function setOption(name, value)
        local option = Options and Options[name]
        if option and type(option.SetValue) == "function" then
            return pcall(function() option:SetValue(value) end)
        end
        return false
    end

    local function getEquippedItem(character)
        return character and character:FindFirstChild("EquippedItem")
    end

    local function weaponOf(item)
        if not item then return nil end
        local info = item:FindFirstChild("Info")
        if info then
            local nameValue = info:FindFirstChild("Name")
            if nameValue and nameValue:IsA("StringValue") then
                return nameValue.Value
            end
        end
        return item.Name
    end

    function self:loadSaveData()
        local data = getOption("cosmetics_changer_save_data")
        if type(data) ~= "string" or data == "" then return end
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(data)
        end)
        if not ok or type(decoded) ~= "table" then return end
        self.skins = type(decoded.skins) == "table" and decoded.skins or {}
        self.charms = type(decoded.charms) == "table" and decoded.charms or {}
        self.finishers = type(decoded.finishers) == "table" and decoded.finishers or {}
    end

    function self:saveData()
        local ok, payload = pcall(function()
            return HttpService:JSONEncode({
                skins = self.skins,
                charms = self.charms,
                finishers = self.finishers,
            })
        end)
        if ok then setOption("cosmetics_changer_save_data", payload) end
    end

    function self:applySkin(character, skinName, weaponName)
        character = character or LocalPlayer.Character
        local item = getEquippedItem(character)
        if not item then return false, "No equipped item" end

        local name = weaponName or weaponOf(item) or "Unknown"
        local skin = skinName
        if not skin or skin == "" then skin = self.skins[name] end
        if not skin or skin == "none" then return false, "No skin selected" end

        self.skins[name] = skin
        local applied = false
        local handle = item:FindFirstChild("Handle")
        if handle then
            pcall(function() handle.TextureID = skin; applied = true end)
        end
        for _, desc in ipairs(item:GetDescendants()) do
            if desc:IsA("Texture") or desc:IsA("Decal") then
                pcall(function() desc.Texture = skin; applied = true end)
            elseif desc:IsA("SpecialMesh") then
                pcall(function() desc.TextureId = skin; applied = true end)
            end
        end
        return applied, applied and ("Applied " .. skin .. " to " .. name) or "No texture-bearing object found"
    end

    function self:applyWrap(character, wrapName, inverted)
        character = character or LocalPlayer.Character
        if type(wrapName) ~= "string" or wrapName == "" or wrapName == "none" then return false end
        local item = getEquippedItem(character)
        if not item then return false end
        local changed = false
        for _, desc in ipairs(item:GetDescendants()) do
            if desc:IsA("Texture") or desc:IsA("Decal") then
                pcall(function()
                    desc.Texture = wrapName
                    if inverted and desc:IsA("Texture") then
                        desc.StudsPerTileU = -math.abs(tonumber(desc.StudsPerTileU) or 1)
                    end
                    changed = true
                end)
            end
        end
        return changed
    end

    function self:applyFinisher(_, finisherName)
        if type(finisherName) ~= "string" or finisherName == "" or finisherName == "none" then return false end
        self.finishers[finisherName] = true
        return true
    end

    function self:randomSkin()
        local names = {}
        for _, name in pairs(self.skins) do
            if type(name) == "string" and name ~= "" then table.insert(names, name) end
        end
        if #names == 0 then return "none" end
        return names[math.random(1, #names)]
    end

    function self:randomFinisher()
        local names = {}
        for name in pairs(self.finishers) do table.insert(names, name) end
        if #names == 0 then return "none" end
        return names[math.random(1, #names)]
    end

    function self:setWeaponFilter(weapon, enabled)
        if type(weapon) ~= "string" or weapon == "" then return false end
        local filter = getOption("weapon_filter")
        if type(filter) ~= "table" then filter = {} end
        filter[weapon] = enabled == true
        return setOption("weapon_filter", filter)
    end

    function self:isWeaponFiltered(weapon)
        local filter = getOption("weapon_filter")
        return type(filter) == "table" and filter[weapon] == false
    end

    function self:bindCharacter(character)
        if not character then return end
        local connection = character.ChildAdded:Connect(function(child)
            if child.Name ~= "EquippedItem" then return end
            local skin = self.skins[weaponOf(child) or ""]
            if skin then
                task.defer(function()
                    if character.Parent then self:applySkin(character, skin) end
                end)
            end
        end)
        table.insert(self.connections, connection)

        local equipped = getEquippedItem(character)
        if equipped then
            local skin = self.skins[weaponOf(equipped) or ""]
            if skin then task.defer(function() self:applySkin(character, skin) end) end
        end
    end

    self:loadSaveData()
    if LocalPlayer.Character then self:bindCharacter(LocalPlayer.Character) end
    table.insert(self.connections, LocalPlayer.CharacterAdded:Connect(function(character)
        self:bindCharacter(character)
    end))
    return self
end

function Cosmetics:destroy()
    for _, connection in ipairs(self.connections or {}) do
        pcall(function() connection:Disconnect() end)
    end
    self.connections = {}
    self.cache = {}
    self.skins = {}
    self.charms = {}
    self.finishers = {}
end

-- ============================================================================
-- Silent Aim
-- ============================================================================
local SilentAim = {}
SilentAim.__index = SilentAim

local function silentDrawing(kind)
    local ok, drawing = pcall(function()
        return Drawing.new(kind)
    end)
    return ok and drawing or nil
end

function SilentAim.new()
    local self = setmetatable({}, SilentAim)
    self.drawings = {}
    self.connections = {}
    self.target = nil
    self.hitchanceFail = false
    self.manipulated = false

    self.fovCircle = silentDrawing("Circle")
    self.fovFill = silentDrawing("Circle")
    self.fovOutline = silentDrawing("Circle")
    self.visualizeLine = silentDrawing("Line")

    for _, drawing in ipairs({ self.fovCircle, self.fovFill, self.fovOutline, self.visualizeLine }) do
        if drawing then
            table.insert(self.drawings, drawing)
            pcall(function() drawing.Visible = false end)
        end
    end

    local function opt(name, default)
        local option = Options and Options[name]
        local value = option and option.Value
        return value == nil and default or value
    end

    local function tog(name, default)
        local toggle = Toggles and Toggles[name]
        local value = toggle and toggle.Value
        return value == nil and default or value
    end

    local function getTargetPart(character)
        if not character then return nil end
        local cam = Workspace.CurrentCamera
        if tog("silent_closest_part", false) and cam then
            local best, bestDist = nil, math.huge
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    local dist = (part.Position - cam.CFrame.Position).Magnitude
                    if dist < bestDist then best, bestDist = part, dist end
                end
            end
            if best then return best end
        end
        return character:FindFirstChild("HitboxHead")
            or character:FindFirstChild("Head")
            or character:FindFirstChild("HumanoidRootPart")
    end

    function self:isEnabled()
        return tog("silent_toggle", false)
    end

    function self:acquire()
        local cam = Workspace.CurrentCamera
        if not cam then return nil end
        local radius = math.max(0, tonumber(opt("silent_radius", 180)) or 180)
        local viewport = cam.ViewportSize
        local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
        local origin = cam.CFrame.Position
        local best, bestScore = nil, math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local hum = character and character:FindFirstChildOfClass("Humanoid")
                if character and hum and hum.Health > 0 then
                    local ally = character:FindFirstChild("_is_ally")
                    if not (ally and ally.Value) then
                        local part = getTargetPart(character)
                        if part then
                            local screen, onScreen = cam:WorldToViewportPoint(part.Position)
                            if onScreen and (part.Position - origin).Magnitude <= radius then
                                local score = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                                if score < bestScore then
                                    bestScore = score
                                    best = { player = player, character = character, part = part, position = part.Position }
                                end
                            end
                        end
                    end
                end
            end
        end
        self.target = best
        return best
    end

    function self:getTarget()
        if not self:isEnabled() then return nil end
        local target = self:acquire()
        if not target then return nil end
        local chance = math.clamp(tonumber(opt("silent_hitchance", 100)) or 100, 0, 100)
        if math.random(1, 100) > chance then
            self.hitchanceFail = true
            self.manipulated = false
            return nil
        end
        self.hitchanceFail = false
        self.manipulated = true
        return target
    end

    local function visuals()
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local enabled = self:isEnabled()
        local show = enabled and tog("silent_showfov", true)
        local radius = math.clamp(tonumber(opt("silent_radius", 180)) or 180, 1, 89)
        local viewport = cam.ViewportSize
        local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
        local focal = (viewport.X / 2) / math.tan(math.rad(cam.FieldOfView) / 2)
        local pixelRadius = focal * math.tan(math.rad(radius))

        local function circle(obj, color, visible, filled, thickness)
            if not obj then return end
            obj.Radius = pixelRadius
            obj.Position = center
            obj.Color = color
            obj.Filled = filled
            obj.Thickness = thickness
            obj.Visible = visible
        end

        circle(self.fovCircle, resolveColor(opt("silent_color1", "White"), Color3.new(1,1,1)), show, false, 1)
        circle(self.fovFill, resolveColor(opt("silent_fill_color1", "Cyan"), Color3.new(0,1,1)), show and tog("silent_fov_fill", false), true, 1)
        circle(self.fovOutline, resolveColor(opt("silent_outline_color1", "Black"), Color3.new(0,0,0)), show and tog("silent_fov_outline", true), false, 2)

        if self.visualizeLine then
            local target = enabled and self:acquire() or nil
            if target and tog("silent_visualize", false) then
                local screen = cam:WorldToViewportPoint(target.position)
                self.visualizeLine.From = center
                self.visualizeLine.To = Vector2.new(screen.X, screen.Y)
                self.visualizeLine.Color = resolveColor(opt("silent_color2", "Cyan"), Color3.new(0,1,1))
                self.visualizeLine.Visible = true
            else
                self.visualizeLine.Visible = false
            end
        end
    end

    table.insert(self.connections, RunService.RenderStepped:Connect(function()
        pcall(visuals)
    end))
    return self
end

function SilentAim:manipulate(originalPosition, originalPart, originalRay)
    local toggle = Toggles and Toggles.silent_manipulation
    if not (toggle and toggle.Value) then
        self.manipulated = false
        return originalPosition, originalPart, originalRay
    end
    local target = self:getTarget()
    if not target then return originalPosition, originalPart, originalRay end
    return target.position, target.part, nil
end

function SilentAim:destroy()
    for _, connection in ipairs(self.connections or {}) do
        pcall(function() connection:Disconnect() end)
    end
    self.connections = {}
    for _, drawing in ipairs(self.drawings or {}) do
        pcall(function()
            if drawing.Remove then drawing:Remove() end
        end)
    end
    self.drawings = {}
    self.target = nil
end

