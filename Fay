local function translocateApplyForcedCrouch(enabled)



    local entity = localfighter and localfighter.Entity
    if entity then
        for _, name in ipairs({ "_ApplyForcedCrouch", "ApplyForcedCrouch", "SetForcedCrouch" }) do
            local fn = entity[name]
            if type(fn) == "function" then
                pcall(fn, entity, enabled == true)
                return
            end
        end
    end
end

local function translocateCompute(originCFrame, hasTarget)
    local state = config.target.evasion.translocate
    state.hasTarget = hasTarget == true

    if not originCFrame then
        state.serverCFrame = nil
        state.active = false
        return nil
    end

    local offset = tonumber(state.offset) or -5

    if state.hasTarget then
        local tagged = CollectionService:GetTagged("OutOfBoundsPart")
        local anchor = nil

        for _, part in ipairs(tagged) do
            if part and part:IsA("BasePart") and part:GetAttribute("KillDelay") == 0 then
                anchor = part
                break
            end
        end

        if anchor then
            local cf = anchor.CFrame * CFrame.new(
                0,
                -anchor.Size.Y / 2 + offset,
                0
            )
            state.serverCFrame = cf
            state.active = true
            return cf
        end
    end

    local fallback = CFrame.new(
        originCFrame.Position + Vector3.new(10000, 10000, 1000000000)
    )
    state.serverCFrame = fallback
    state.active = state.hasTarget
    return fallback
end

local function clearTranslocateState()





    local state = config.target.evasion.translocate
    state.active = false
    state.hasTarget = false
    state.serverCFrame = nil
    config.orbit.serverpos = nil
    config.orbit.active = false
end

local function applyTranslocateStep()
    local state = config.target.evasion.translocate
    if config.target.evasion.mode ~= "Translocate" then
        clearTranslocateState()
        return false
    end

    if not localfighter or not localfighter.Entity or not localfighter.Entity.RootPart then
        clearTranslocateState()
        return false
    end

    local rootPart = localfighter.Entity.RootPart
    translocateController:SetRootPart(rootPart)

    local hasTarget = config.target.character ~= nil and valid(config.target.character)
    local targetRoot = hasTarget and config.target.character:FindFirstChild("HumanoidRootPart") or nil
    hasTarget = targetRoot ~= nil





    local clientCFrame = translocateController:GetClientCFrame()
    if not clientCFrame then
        clearTranslocateState()
        return false
    end

    local computedCFrame = translocateCompute(clientCFrame, hasTarget)
    if not computedCFrame then
        return false
    end

    translocateApplyForcedCrouch(false)
    translocateController:SetServerCFrame(computedCFrame)
    translocateController:HeartbeatUpdate()

    config.orbit.serverpos = computedCFrame.Position
    config.orbit.active = true
    state.serverCFrame = computedCFrame
    state.active = hasTarget

    return true
end

