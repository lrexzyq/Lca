local rageShootLock = {
    target = nil,
    nextAt = 0,
    interval = 0,
}

function rageShootLock:Reset()
    self.target = nil
    self.nextAt = 0
    self.interval = 0
end

function rageShootLock:ShouldFire(target, threshold)
    local now = os.clock()
    local window = math.max(0, tonumber(threshold) or 0)
    if self.target ~= target then
        self.target = target
        self.nextAt = 0
        self.interval = 0
    end
    if now < self.nextAt then
        return false
    end
    self.interval = window
    return true
end

