local function worldDrawingLine()
    local ok, line = pcall(function()
        return Drawing.new("Line")
    end)
    if not ok or not line then return nil end
    line.Thickness = 1
    line.Transparency = 1
    line.Color = Color3.new(1, 1, 1)
    line.Visible = false
    return line
end

function World.new()
    local self = setmetatable({}, World)
    self.drawings = {}
    self.players = {}
    self.connections = {}
    self.targetPlayer = nil
    self.weatherEmitter = nil
    self.weatherAttachment = nil

    local function addDrawing(kind)
        local ok, drawing = pcall(function()
            return Drawing.new(kind)
        end)
        if not ok or not drawing then return nil end
        table.insert(self.drawings, drawing)
        return drawing
    end

    local function getToggle(name)
        return Toggles[name] and Toggles[name].Value or false
    end

    local function getOption(name, default)
        local option = Options[name]
        if option == nil then return default end
        local value = option.Value
        if value == nil then return default end
        return value
    end

    local function getColor(name, default)
        local value = getOption(name, default)
        if typeof(value) == "Color3" then return value end
        return resolveColor(value, default)
    end

    function self:getTarget()
        if not getToggle("target_highlight_enabled") then return nil end
        return self.targetPlayer
    end

    function self:setTarget(player)
        self.targetPlayer = player
    end

    local function setupPlayer(player)
        if self.players[player] then return end
        local state = {
            player = player,
            character = nil,
            highlight = nil,
            line = nil,
            visible = false,
        }
        self.players[player] = state

        local function onCharacter(character)
            state.character = character
            state.visible = false
            if state.highlight then
                pcall(function() state.highlight:Destroy() end)
                state.highlight = nil
            end
            local ok, highlight = pcall(Instance.new, "Highlight")
            if not ok or not highlight then return end
            highlight.Name = "WorldTargetHighlight"
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Enabled = false
            highlight.Parent = character
            state.highlight = highlight
        end

        if player.Character then
            onCharacter(player.Character)
        end

        table.insert(self.connections, player.CharacterAdded:Connect(onCharacter))
    end

    for _, player in ipairs(Players:GetPlayers()) do
        setupPlayer(player)
    end

    table.insert(self.connections, Players.PlayerAdded:Connect(setupPlayer))
    table.insert(self.connections, Players.PlayerRemoving:Connect(function(player)
        local state = self.players[player]
        if state then
            if state.highlight then pcall(function() state.highlight:Destroy() end) end
            if state.line then pcall(function() state.line:Remove() end) end
            self.players[player] = nil
        end
        if self.targetPlayer == player then
            self.targetPlayer = nil
        end
    end))

    table.insert(self.connections, RunService.RenderStepped:Connect(function()
        local cam = Workspace.CurrentCamera
        if not cam then return end

        if getToggle("crosshair_enabled") then
            local viewport = cam.ViewportSize
            local cx, cy = viewport.X / 2, viewport.Y / 2
            local length = math.max(0, tonumber(getOption("crosshair_length", 8)) or 8)
            local thickness = math.max(1, tonumber(getOption("crosshair_thickness", 1)) or 1)
            local gap = math.max(0, tonumber(getOption("crosshair_offset", 4)) or 4)
            local color = getColor("crosshair_color_3", Color3.new(1, 1, 1))
            local rotation = tonumber(getOption("crosshair_rotation_value", 0)) or 0
            local speed = tonumber(getOption("crosshair_rotation_speed", 0)) or 0
            if getToggle("crosshair_rotation") then
                rotation = rotation + speed * tick()
            end
            local radians = math.rad(rotation)
            local cosv, sinv = math.cos(radians), math.sin(radians)
            local dirs = {{1,0},{-1,0},{0,1},{0,-1}}
            for i = 1, 4 do
                local line = self.crosshairLines and self.crosshairLines[i]
                if not line then
                    self.crosshairLines = self.crosshairLines or {}
                    line = addDrawing("Line")
                    self.crosshairLines[i] = line
                end
                if line then
                    local dx, dy = dirs[i][1], dirs[i][2]
                    local rx = dx * cosv - dy * sinv
                    local ry = dx * sinv + dy * cosv
                    line.From = Vector2.new(cx + rx * gap, cy + ry * gap)
                    line.To = Vector2.new(cx + rx * (gap + length), cy + ry * (gap + length))
                    line.Thickness = thickness
                    line.Color = color
                    line.Transparency = 1
                    line.Visible = true
                end
            end
        elseif self.crosshairLines then
            for _, line in ipairs(self.crosshairLines) do
                if line then line.Visible = false end
            end
        end

        local target = self:getTarget()
        for player, state in pairs(self.players) do
            if state.highlight then
                local show = target == player and state.character ~= nil
                state.highlight.Enabled = show
                if show then
                    state.highlight.FillColor = getColor("target_highlight_fill", Color3.new(1, 0, 0))
                    state.highlight.OutlineColor = getColor("target_highlight_outline", Color3.new(1, 1, 1))
                    state.highlight.FillTransparency = math.clamp(tonumber(getOption("target_highlight_fill_alpha", 0.35)) or 0.35, 0, 1)
                    state.highlight.OutlineTransparency = math.clamp(tonumber(getOption("target_highlight_outline_alpha", 0)) or 0, 0, 1)
                end
            end
        end

        local tracerEnabled = getToggle("target_tracer_enabled")
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        for player, state in pairs(self.players) do
            if player == LocalPlayer then continue end
            local character = state.character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local hum = character and character:FindFirstChildOfClass("Humanoid")
            local valid = tracerEnabled and hrp and hum and hum.Health > 0
            if valid then
                local screen, visible = cam:WorldToViewportPoint(hrp.Position)
                if not state.line then
                    state.line = addDrawing("Line")
                    if state.line then
                        state.line.Thickness = 1
                    end
                end
                if state.line then
                    state.line.From = center
                    state.line.To = Vector2.new(screen.X, screen.Y)
                    state.line.Color = getColor("target_tracer_color", Color3.new(1, 1, 1))
                    state.line.Transparency = 1
                    state.line.Visible = visible
                end
            elseif state.line then
                state.line.Visible = false
            end
        end
    end))

    table.insert(self.connections, RunService.Heartbeat:Connect(function()
        if getToggle("skybox_enabled") then
            local sky = Lighting:FindFirstChildOfClass("Sky")
            if not sky then
                sky = Instance.new("Sky")
                sky.Parent = Lighting
            end
            local asset = tostring(getOption("skybox_value", "1898729298"))
            if not asset:find("rbxassetid://", 1, true) then
                asset = "rbxassetid://" .. asset
            end
            sky.SkyboxBk = asset
            sky.SkyboxBl = asset
            sky.SkyboxDn = asset
            sky.SkyboxFt = asset
            sky.SkyboxLf = asset
            sky.SkyboxRt = asset
            sky.SkyboxUp = asset
        end

        local cam = Workspace.CurrentCamera
        if not cam then return end
        if not getToggle("weather_enabled") then
            if self.weatherEmitter then self.weatherEmitter.Enabled = false end
            return
        end

        if not self.weatherAttachment or self.weatherAttachment.Parent ~= cam then
            if self.weatherAttachment then pcall(function() self.weatherAttachment:Destroy() end) end
            self.weatherAttachment = Instance.new("Attachment")
            self.weatherAttachment.Name = "WorldWeatherAttachment"
            self.weatherAttachment.Parent = cam
            self.weatherEmitter = Instance.new("ParticleEmitter")
            self.weatherEmitter.Name = "WorldWeatherEmitter"
            self.weatherEmitter.Lifetime = NumberRange.new(3)
            self.weatherEmitter.Rate = 30
            self.weatherEmitter.Speed = NumberRange.new(10, 20)
            self.weatherEmitter.Size = NumberSequence.new(0.5)
            self.weatherEmitter.Parent = self.weatherAttachment
        end

        local emitter = self.weatherEmitter
        emitter.Enabled = true
        local weatherType = tostring(getOption("weather_value", "Rain"))
        local color = getColor("weather_color_1", Color3.new(1, 1, 1))
        local life = math.max(0, tonumber(getOption("weather_lifetime_multiplier", 1)) or 1)
        local rate = math.max(0, tonumber(getOption("weather_rate_multiplier", 1)) or 1)
        local timescale = math.max(0, tonumber(getOption("weather_timescale_multiplier", 1)) or 1)

        if weatherType == "Snow" then
            emitter.Texture = "rbxasset://textures/particles/snow.dds"
            emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
            emitter.Rate = 12 * rate
            emitter.Speed = NumberRange.new(2 * timescale, 6 * timescale)
            emitter.Lifetime = NumberRange.new(4 * life)
            emitter.Size = NumberSequence.new(0.8)
        elseif weatherType == "Fog" or weatherType == "Mist" then
            emitter.Texture = "rbxasset://textures/particles/smoke.dds"
            emitter.Color = ColorSequence.new(color)
            emitter.Rate = 8 * rate
            emitter.Speed = NumberRange.new(1 * timescale, 3 * timescale)
            emitter.Lifetime = NumberRange.new(5 * life)
            emitter.Size = NumberSequence.new(2)
        else
            emitter.Texture = "rbxasset://textures/particles/raindrop.dds"
            emitter.Color = ColorSequence.new(color)
            emitter.Rate = 40 * rate
            emitter.Speed = NumberRange.new(25 * timescale, 40 * timescale)
            emitter.Lifetime = NumberRange.new(2 * life)
            emitter.Size = NumberSequence.new(0.5)
        end
    end))

    return self
end

function World:destroy()
    for _, connection in ipairs(self.connections) do
        pcall(function() connection:Disconnect() end)
    end
    self.connections = {}
    for _, state in pairs(self.players) do
        if state.highlight then pcall(function() state.highlight:Destroy() end) end
        if state.line then pcall(function() state.line:Remove() end) end
    end
    if self.weatherAttachment then pcall(function() self.weatherAttachment:Destroy() end) end
    for _, drawing in ipairs(self.drawings) do
        pcall(function() drawing:Remove() end)
    end
    self.drawings = {}
    self.players = {}
end

