-- ============================================================================
-- Effects + ESP subsystem
-- Hardened to avoid nil/indexing errors when UI values, characters, cameras,
-- Drawing API objects, or optional R15 body parts are unavailable.
-- ============================================================================
local HIT_SOUND_ASSETS = {
    sparkle = "5070376932",
    ding = "5617972474",
    thud = "4539867272",
    ping = "5070394352",
}

local COLOR_PRESETS = {
    White = Color3.new(1, 1, 1),
    Red = Color3.fromRGB(255, 70, 70),
    Green = Color3.fromRGB(80, 255, 120),
    Blue = Color3.fromRGB(80, 160, 255),
    Yellow = Color3.fromRGB(255, 225, 70),
    Purple = Color3.fromRGB(190, 100, 255),
    Cyan = Color3.fromRGB(70, 235, 255),
    Orange = Color3.fromRGB(255, 165, 70),
}

local function resolveColor(value, fallback)
    if typeof(value) == "Color3" then
        return value
    end
    if type(value) == "string" and COLOR_PRESETS[value] then
        return COLOR_PRESETS[value]
    end
    return fallback or Color3.new(1, 1, 1)
end

local Effects = {}
Effects.__index = Effects

local EFFECT_TYPES = { "fortnite damage", "hit marker", "phantom forces" }

function Effects.new()
    local self = setmetatable({}, Effects)
    self.effects = {}
    self.markers = {}
    self.particles = {}
    self.colorIndex = 0
    self.stackWindows = {}
    self.connections = {}
    self.trackedCharacters = {}

    self.colors = {
        resolveColor(Options.hit_effects_col_1.Value, Color3.new(1, 1, 1)),
        resolveColor(Options.hit_effects_col_2.Value, Color3.new(1, 1, 1)),
        resolveColor(Options.hit_effects_col_3.Value, Color3.new(1, 1, 1)),
    }

    local function cycleColor()
        if #self.colors == 0 then
            return Color3.new(1, 1, 1)
        end
        self.colorIndex = self.colorIndex + 1
        return self.colors[((self.colorIndex - 1) % #self.colors) + 1]
    end

    local function getType()
        return Options.hit_effects_selected.Value or "fortnite damage"
    end

    local STACK_WINDOW = 0.15

    local function stackDamage(character, damage)
        if not character then return false end
        damage = tonumber(damage) or 0
        local now = tick()
        local existing = self.stackWindows[character]
        if existing and now - existing.time < STACK_WINDOW then
            existing.damage = existing.damage + damage
            existing.time = now
            local label = existing.label
            if label and label.Parent then
                label.Text = tostring(math.round(existing.damage))
            end
            return true
        end
        return false
    end

    function self:spawnDamageMarker(character, damage, hitPart)
        if not Toggles.hit_effects_disable_marker.Value then
            if not character then return end
            damage = tonumber(damage) or 0
            if stackDamage(character, damage) then
                return
            end

            local color = cycleColor()
            local head = character:FindFirstChild("Head") or hitPart or character:FindFirstChild("HumanoidRootPart")
            if not head or (not head:IsA("BasePart") and not head:IsA("Attachment")) then return end

            local gui = Instance.new("BillboardGui")
            gui.Name = "BillboardDamage"
            gui.Size = UDim2.fromScale(1, 1)
            gui.AlwaysOnTop = true
            gui.ClipsDescendants = false
            gui.LightInfluence = 0
            gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            gui.Adornee = head
            gui.Parent = character

            local label = Instance.new("TextLabel")
            label.Name = "TextDamage"
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.Text = tostring(math.round(damage))
            label.TextColor3 = color
            label.TextSize = 60
            label.Font = Enum.Font.SciFi
            label.TextStrokeTransparency = 0
            label.Parent = gui

            local stroke = Instance.new("UIStroke")
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Color = Color3.new(0, 0, 0)
            stroke.Thickness = 4
            stroke.Parent = label

            local shadow = label:Clone()
            shadow.Name = "TextDamageShadow"
            shadow.TextColor3 = Color3.new(0, 0, 0)
            shadow.TextStrokeTransparency = 1
            shadow.Position = UDim2.fromOffset(3, 3)
            shadow.Parent = gui

            local startOffset = gui.StudsOffset
            local tween = TweenService:Create(gui, TweenInfo.new(
                1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out
            ), { StudsOffset = startOffset + Vector3.new(0, 2.5, 0) })
            tween:Play()

            self.stackWindows[character] = {
                time = tick(),
                damage = damage,
                label = label,
            }

            task.delay(1.2, function()
                if self.stackWindows[character] and self.stackWindows[character].label == label then
                    self.stackWindows[character] = nil
                end
                pcall(function() gui:Destroy() end)
            end)

            table.insert(self.markers, gui)
        end
    end

    function self:playShootSound(weapon)
        if not Toggles.shoot_sound_change.Value then return end
        local character = LocalPlayer.Character
        if not character then return end

        local volume = math.max(0, tonumber(Options.shoot_sound_volume.Value) or 1)
        local speed = math.max(0.01, tonumber(Options.shoot_sound_speed.Value) or 1)
        local custom = tostring(Options.shoot_sound_custom_value.Value or "")
        local weaponName = tostring(weapon or "Default")
        local sound = character:FindFirstChild("ShootSound_" .. weaponName)

        if not sound then
            sound = Instance.new("Sound")
            sound.Name = "ShootSound_" .. weaponName
            sound.SoundId = custom ~= "" and "rbxassetid://" .. custom or "rbxassetid://5617972474"
            sound.Parent = character
        end

        sound.Volume = volume
        sound.PlaybackSpeed = speed
        sound:Play()
    end

    function self:spawnHitEffect(character, hitPart)
        if not Toggles.hit_effects_enabled.Value then return end
        if Toggles.hit_effects_disable_numbers.Value then return end
        if not character or not hitPart or not hitPart:IsA("BasePart") then return end

        local effectType = getType()
        if effectType == "phantom forces" then
            self:spawnPhantomClone(character, hitPart)
        elseif effectType == "hit marker" then
            self:spawnHitMarker(character, hitPart)
        else
            self:spawnFortniteClone(character, hitPart)
        end
    end

    function self:spawnFortniteClone(character, hitPart)
        if not hitPart or not hitPart:IsA("BasePart") then return end
        local ok, clone = pcall(function() return hitPart:Clone() end)
        if not ok or not clone or not clone:IsA("BasePart") then return end

        clone.Parent = workspace
        clone.CFrame = hitPart.CFrame
        clone.CanCollide = false
        clone.CanQuery = false
        clone.CanTouch = false
        clone.Anchored = true
        clone.Material = Enum.Material.SmoothPlastic

        local material = Options.hit_effects_material.Value
        if material and material ~= "Default" then
            pcall(function()
                local enumMaterial = Enum.Material[material]
                if enumMaterial then clone.Material = enumMaterial end
            end)
        end

        if Toggles.hit_effects_weld.Value then
            pcall(function()
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = hitPart
                weld.Part1 = clone
                weld.Parent = clone
            end)
        end

        for _, child in ipairs(clone:GetChildren()) do
            if child:IsA("Accessory") or child:IsA("Motor6D") or child:IsA("Weld") then
                child:Destroy()
            end
        end

        table.insert(self.effects, clone)
        local tween = TweenService:Create(clone, TweenInfo.new(
            0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out
        ), { Transparency = 1 })
        tween:Play()
        task.delay(0.5, function()
            pcall(function() clone:Destroy() end)
        end)
    end

    function self:spawnPhantomClone(character, hitPart)
        if not hitPart or not hitPart:IsA("BasePart") then return end
        local ok, clone = pcall(function() return hitPart:Clone() end)
        if not ok or not clone or not clone:IsA("BasePart") then return end

        clone.Parent = workspace
        clone.CFrame = hitPart.CFrame
        clone.CanCollide = false
        clone.CanQuery = false
        clone.CanTouch = false
        clone.Anchored = true
        clone.Color = Color3.new(1, 1, 1)
        clone.Transparency = 0.5

        if Toggles.hit_effects_weld.Value then
            pcall(function()
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = hitPart
                weld.Part1 = clone
                weld.Parent = clone
            end)
        end

        for _, child in ipairs(clone:GetChildren()) do
            if child:IsA("Accessory") or child:IsA("Motor6D") or child:IsA("Weld") then
                child:Destroy()
            end
        end

        table.insert(self.effects, clone)
        local tween = TweenService:Create(clone, TweenInfo.new(
            0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out
        ), { Transparency = 1 })
        tween:Play()
        task.delay(0.4, function()
            pcall(function() clone:Destroy() end)
        end)
    end

    function self:spawnHitMarker(character, hitPart)
        if not character then return end
        local head = character:FindFirstChild("Head") or hitPart or character:FindFirstChild("HumanoidRootPart")
        if not head or (not head:IsA("BasePart") and not head:IsA("Attachment")) then return end

        local gui = Instance.new("BillboardGui")
        gui.Name = "HitMarker"
        gui.Size = UDim2.fromScale(1, 1)
        gui.AlwaysOnTop = true
        gui.ClipsDescendants = false
        gui.Adornee = head
        gui.Parent = character

        local cross = Instance.new("Frame")
        cross.Size = UDim2.fromScale(1, 1)
        cross.BackgroundTransparency = 1
        cross.Parent = gui

        local color = cycleColor()
        local thickness = UDim2.fromScale(0.02, 0.25)

        local vert = Instance.new("Frame")
        vert.Size = thickness
        vert.AnchorPoint = Vector2.new(0.5, 0.5)
        vert.Position = UDim2.fromScale(0.5, 0.5)
        vert.BackgroundColor3 = color
        vert.Parent = cross

        local horiz = Instance.new("Frame")
        horiz.Size = UDim2.fromScale(0.25, 0.02)
        horiz.AnchorPoint = Vector2.new(0.5, 0.5)
        horiz.Position = UDim2.fromScale(0.5, 0.5)
        horiz.BackgroundColor3 = color
        horiz.Parent = cross

        local tween = TweenService:Create(gui, TweenInfo.new(
            0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out
        ), { Size = gui.Size * 1.5 })
        tween:Play()
        task.delay(0.6, function() pcall(function() gui:Destroy() end) end)
    end

    function self:spawnExplosion(position, radius)
        if typeof(position) ~= "Vector3" then return end
        local explosion = Instance.new("Explosion")
        explosion.BlastRadius = math.max(0, tonumber(radius) or 4)
        explosion.Position = position
        explosion.DestroyJointRadiusPercent = 0
        explosion.Parent = workspace
    end

    function self:spawnParticleBurst(character, position)
        if typeof(position) ~= "Vector3" then return end
        local parentPart
        if character and character:IsA("Model") then
            parentPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
        elseif character and character:IsA("BasePart") then
            parentPart = character
        end
        if not parentPart then return end

        local attachment = Instance.new("Attachment")
        attachment.WorldPosition = position
        attachment.Parent = parentPart

        local emitter = Instance.new("ParticleEmitter")
        emitter.Rate = 0
        emitter.Lifetime = NumberRange.new(0.5)
        emitter.Speed = NumberRange.new(5, 10)
        emitter.VelocityPerpendicular = NumberRange.new(0, 4)
        emitter.RotSpeed = NumberRange.new(-90, 90)
        emitter.Color = ColorSequence.new(cycleColor())
        emitter.Size = NumberSequence.new(1)
        emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        emitter.Parent = attachment

        emitter:Emit(15)
        table.insert(self.particles, attachment)
        task.delay(1.5, function() pcall(function() attachment:Destroy() end) end)
    end

    function self:playHitSound()
        if not Toggles.hit_sounds_enabled.Value then return end
        if Toggles.hit_sounds_disable.Value then return end
        local character = LocalPlayer.Character
        if not character then return end

        local selected = Options.hit_sounds_selected.Value or "sparkle"
        local volume = math.max(0, tonumber(Options.hit_sounds_volume.Value) or 1)
        local soundId = HIT_SOUND_ASSETS[selected] or HIT_SOUND_ASSETS.sparkle

        local sound = character:FindFirstChild("HitSound_" .. selected)
        if not sound then
            sound = Instance.new("Sound")
            sound.Name = "HitSound_" .. selected
            sound.SoundId = "rbxassetid://" .. soundId
            sound.Parent = character
        end
        sound.Volume = volume
        sound:Play()
    end

    function self:registerHit(targetCharacter, damage, hitPart, hitPosition)
        self:spawnDamageMarker(targetCharacter, damage, hitPart)
        self:spawnHitEffect(targetCharacter, hitPart)
        if hitPosition then
            self:spawnParticleBurst(targetCharacter, hitPosition)
        end
        self:playHitSound()
    end

    local function trackCharacter(player, character)
        if not player or player == lp or not character then return end
        local hum = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        if not hum then return end
        local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
        if not root then return end
        if self.trackedCharacters[character] then return end

        self.trackedCharacters[character] = true
        local lastHealth = hum.Health
        local conn = hum.HealthChanged:Connect(function(newHealth)
            if not Toggles.hit_effects_enabled.Value then
                lastHealth = newHealth
                return
            end
            local previous = lastHealth
            lastHealth = newHealth
            local damage = previous - newHealth
            if damage > 0 and newHealth >= 0 and character.Parent then
                self:registerHit(character, damage, root, root.Position)
            end
        end)
        table.insert(self.connections, conn)

        local removingConn
        removingConn = character.AncestryChanged:Connect(function(_, parent)
            if parent == nil then
                self.trackedCharacters[character] = nil
                pcall(function() removingConn:Disconnect() end)
            end
        end)
        table.insert(self.connections, removingConn)
    end

    local function setupPlayer(player)
        if player == lp then return end
        if player.Character then
            task.spawn(trackCharacter, player, player.Character)
        end
        table.insert(self.connections, player.CharacterAdded:Connect(function(character)
            trackCharacter(player, character)
        end))
    end

    for _, player in ipairs(Players:GetPlayers()) do
        setupPlayer(player)
    end
    table.insert(self.connections, Players.PlayerAdded:Connect(setupPlayer))

    table.insert(self.connections, Options.hit_effects_col_1:OnChanged(function(value)
        self.colors[1] = resolveColor(value, Color3.new(1, 1, 1))
    end))
    table.insert(self.connections, Options.hit_effects_col_2:OnChanged(function(value)
        self.colors[2] = resolveColor(value, Color3.new(1, 1, 1))
    end))
    table.insert(self.connections, Options.hit_effects_col_3:OnChanged(function(value)
        self.colors[3] = resolveColor(value, Color3.new(1, 1, 1))
    end))

    return self
end

function Effects:destroy()
    for _, connection in ipairs(self.connections) do
        pcall(function() connection:Disconnect() end)
    end
    self.connections = {}
    for _, effect in ipairs(self.effects) do
        pcall(function() effect:Destroy() end)
    end
    for _, marker in ipairs(self.markers) do
        pcall(function() marker:Destroy() end)
    end
    for _, particle in ipairs(self.particles) do
        pcall(function() particle:Destroy() end)
    end
    self.effects = {}
    self.markers = {}
    self.particles = {}
    self.stackWindows = {}
    self.trackedCharacters = {}
end

