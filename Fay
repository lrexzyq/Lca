function Viewmodel.new()
    local self = setmetatable({}, Viewmodel)
    self.connections = {}
    self.baseCFrames = {}
    self.recoilCFrames = {}

    local function getToggle(name)
        return Toggles[name] and Toggles[name].Value or false
    end

    local function getOption(name, default)
        local option = Options[name]
        if option == nil then return default end
        return option.Value == nil and default or option.Value
    end

    local function apply(vm)
        if not vm then return end
        local ox = tonumber(getOption("viewmodel_offset_x", 0)) or 0
        local oy = tonumber(getOption("viewmodel_offset_y", 0)) or 0
        local oz = tonumber(getOption("viewmodel_offset_z", 0)) or 0
        local recoil = tonumber(getOption("viewmodel_recoil", 0)) or 0
        local transform = CFrame.new(ox, oy, oz) * CFrame.Angles(math.rad(-recoil), 0, math.rad(recoil * 0.5))
        if vm:IsA("BasePart") then
            local base = self.baseCFrames[vm]
            if not base then
                base = vm.CFrame
                self.baseCFrames[vm] = base
            end
            vm.CFrame = base * transform
        elseif vm:IsA("Model") then
            local base = self.baseCFrames[vm]
            if not base then
                base = vm:GetPivot()
                self.baseCFrames[vm] = base
            end
            pcall(function() vm:PivotTo(base * transform) end)
        end
    end

    local function applyDescendants(vm)
        local colorEnabled = getToggle("viewmodel_body_color")
        local override = getToggle("viewmodel_override_appearance")
        local transparency = tonumber(getOption("viewmodel_body_transparency", 0)) or 0
        local material = tostring(getOption("viewmodel_material", "Default"))
        local disableTextures = getToggle("viewmodel_disable_textures")
        local wireframe = getToggle("viewmodel_wireframe")
        local chams = getToggle("viewmodel_chams")

        for _, desc in ipairs(vm:GetDescendants()) do
            if desc:IsA("BasePart") then
                if colorEnabled or override then
                    pcall(function() desc.Color = getColorValue("viewmodel_body_color_value", Color3.new(1, 1, 1)) end)
                end
                desc.Transparency = math.clamp(transparency, 0, 1)
                if material ~= "Default" and Enum.Material[material] then
                    desc.Material = Enum.Material[material]
                end
                if wireframe then
                    desc.Material = Enum.Material.ForceField
                end
            elseif desc:IsA("Texture") or desc:IsA("Decal") then
                if disableTextures then
                    pcall(function() desc.Texture = "" end)
                end
            end
        end

        local highlight = vm:FindFirstChild("WorldVMChams")
        if chams then
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "WorldVMChams"
                highlight.Parent = vm
            end
            highlight.FillColor = getColorValue("viewmodel_chams_color", Color3.new(1, 1, 1))
            highlight.OutlineColor = getColorValue("viewmodel_chams_color2", Color3.new(0, 0, 0))
            highlight.FillTransparency = math.clamp(tonumber(getOption("viewmodel_chams_alpha_fill", 0.5)) or 0.5, 0, 1)
            highlight.OutlineTransparency = math.clamp(tonumber(getOption("viewmodel_chams_alpha_outline", 0)) or 0, 0, 1)
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        elseif highlight then
            highlight:Destroy()
        end
    end

    local function findViewmodel()
        local character = LocalPlayer.Character
        if not character then return nil end
        local item = character:FindFirstChild("EquippedItem")
        if not item then return nil end
        local vm = item:FindFirstChild("ViewModel")
        if vm and (vm:IsA("BasePart") or vm:IsA("Model")) then return vm end
        return nil
    end

    table.insert(self.connections, RunService.RenderStepped:Connect(function()
        if not getToggle("viewmodel_enabled") then return end
        local vm = findViewmodel()
        if not vm then return end
        apply(vm)
        applyDescendants(vm)
    end))

    return self
end

function Viewmodel:destroy()
    for _, connection in ipairs(self.connections) do
        pcall(function() connection:Disconnect() end)
    end
    self.connections = {}
    self.baseCFrames = {}
end


