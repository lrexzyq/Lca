                local equippedIsMelee = equippedInfo and (equippedInfo.Class == 'Melee' or equippedInfo.Type == 'Melee') and true or false
                local ranges
                if name and RivalsRagebot.WeaponRanges[name] then
                    ranges = RivalsRagebot.WeaponRanges[name]
                elseif equippedIsMelee then
                    ranges = { In = MeleeFastFire.RagebotStuds, Out = MeleeFastFire.RagebotStuds }
                else
                    ranges = { In = RivalsRagebot.RadiusIn, Out = RivalsRagebot.RadiusOut }
                end
                RivalsRagebotState.LastWeaponName = name
                RivalsRagebotState.CachedRanges = ranges
                return ranges
            end

            function RivalsRagebot.ResolveRadius()
                local ranges = RivalsRagebot.ResolveWeaponRanges()
                local toggle = math.floor(tick() * RivalsRagebot.InOutToggleHz) % 2 == 0
                return toggle and ranges.In or ranges.Out
            end

            function RivalsRagebot.ResolveHeightOffset(clockSec)
                local t = clockSec or 0
                return RivalsRagebot.HeightBase + math.sin(2 * math.pi * RivalsRagebot.HeightWobbleRateHz * t) * RivalsRagebot.HeightWobbleAmp
            end

            function RivalsRagebot.ResolveRagebotCFrame(targetRootPart, radius, heightOffset, phaseRad)
                local localOffset = Vector3.new(
                    math.sin(phaseRad) * radius,
                    heightOffset,
                    math.cos(phaseRad) * radius
                )
                local worldPos = targetRootPart.CFrame:PointToWorldSpace(localOffset)
                return CFrame.lookAt(worldPos, targetRootPart.Position)
            end

            function RivalsRagebot.IsCandidatePositionInBounds(candidatePos, subject)
                local CollectionService = game:GetService('CollectionService')
                local insideSafePart = false
                for _, safe in ipairs(CollectionService:GetTagged('OutOfBoundsSafePart')) do
                    if safe:IsA('BasePart') then
                        local rel = safe.CFrame:PointToObjectSpace(candidatePos)
                        local hx, hy, hz = safe.Size.X * 0.5, safe.Size.Y * 0.5, safe.Size.Z * 0.5
                        if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                            insideSafePart = true
                            break
                        end
                    end
                end
                if not insideSafePart then
                    local oobBufferSq = RivalsRagebot.OOBBufferDistance * RivalsRagebot.OOBBufferDistance
                    for _, oob in ipairs(CollectionService:GetTagged('OutOfBoundsPart')) do
                        if oob:IsA('BasePart') then
                            local rel = oob.CFrame:PointToObjectSpace(candidatePos)
                            local hx, hy, hz = oob.Size.X * 0.5, oob.Size.Y * 0.5, oob.Size.Z * 0.5
                            local dx = math.max(math.abs(rel.X) - hx, 0)
                            local dy = math.max(math.abs(rel.Y) - hy, 0)
                            local dz = math.max(math.abs(rel.Z) - hz, 0)
                            if (dx * dx + dy * dy + dz * dz) < oobBufferSq then
                                return false
                            end
                        end
                    end
                end

                return true
            end

            local function IsPointInOOBVolume(pos)
                local CollectionService = game:GetService('CollectionService')
                for _, safe in ipairs(CollectionService:GetTagged('OutOfBoundsSafePart')) do
                    if safe:IsA('BasePart') then
                        local rel = safe.CFrame:PointToObjectSpace(pos)
                        local hx, hy, hz = safe.Size.X * 0.5, safe.Size.Y * 0.5, safe.Size.Z * 0.5
                        if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                            return false
                        end
                    end
                end
                for _, oob in ipairs(CollectionService:GetTagged('OutOfBoundsPart')) do
                    if oob:IsA('BasePart') then
                        local rel = oob.CFrame:PointToObjectSpace(pos)
                        local hx, hy, hz = oob.Size.X * 0.5, oob.Size.Y * 0.5, oob.Size.Z * 0.5
                        if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                            return true
                        end
                    end
                end
                return false
            end

            local function GetOOBPartAt(pos)
                local CollectionService = game:GetService('CollectionService')
                for _, safe in ipairs(CollectionService:GetTagged('OutOfBoundsSafePart')) do
                    if safe:IsA('BasePart') then
                        local rel = safe.CFrame:PointToObjectSpace(pos)
                        local hx, hy, hz = safe.Size.X * 0.5, safe.Size.Y * 0.5, safe.Size.Z * 0.5
                        if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                            return nil
                        end
                    end
                end
                for _, oob in ipairs(CollectionService:GetTagged('OutOfBoundsPart')) do
                    if oob:IsA('BasePart') then
                        local rel = oob.CFrame:PointToObjectSpace(pos)
                        local hx, hy, hz = oob.Size.X * 0.5, oob.Size.Y * 0.5, oob.Size.Z * 0.5
                        if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                            return oob
                        end
                    end
                end
                return nil
            end

            local KILL_SEAT_SAMPLE_DIRECTIONS = (function()
                local d = {}
                local axes = {
                    Vector3.new( 1,  0,  0), Vector3.new(-1,  0,  0),
                    Vector3.new( 0,  1,  0), Vector3.new( 0, -1,  0),
                    Vector3.new( 0,  0,  1), Vector3.new( 0,  0, -1),
                    Vector3.new( 1,  1,  0), Vector3.new( 1, -1,  0),
                    Vector3.new(-1,  1,  0), Vector3.new(-1, -1,  0),
                    Vector3.new( 1,  0,  1), Vector3.new( 1,  0, -1),
                    Vector3.new(-1,  0,  1), Vector3.new(-1,  0, -1),
                    Vector3.new( 0,  1,  1), Vector3.new( 0,  1, -1),
                    Vector3.new( 0, -1,  1), Vector3.new( 0, -1, -1),
                    Vector3.new( 1,  1,  1), Vector3.new( 1,  1, -1),
                    Vector3.new( 1, -1,  1), Vector3.new( 1, -1, -1),
                    Vector3.new(-1,  1,  1), Vector3.new(-1,  1, -1),
                    Vector3.new(-1, -1,  1), Vector3.new(-1, -1, -1),
                }
                for _, v in ipairs(axes) do d[#d + 1] = v.Unit end
                return d
            end)()

            local KILL_SEAT_AXIS_OFFSETS = {
                Vector3.new( 1,  0,  0), Vector3.new(-1,  0,  0),
                Vector3.new( 0,  1,  0), Vector3.new( 0, -1,  0),
                Vector3.new( 0,  0,  1), Vector3.new( 0,  0, -1),
                Vector3.new( 1,  1,  0), Vector3.new( 1, -1,  0),
                Vector3.new(-1,  1,  0), Vector3.new(-1, -1,  0),
                Vector3.new( 1,  0,  1), Vector3.new( 1,  0, -1),
                Vector3.new(-1,  0,  1), Vector3.new(-1,  0, -1),
                Vector3.new( 0,  1,  1), Vector3.new( 0,  1, -1),
                Vector3.new( 0, -1,  1), Vector3.new( 0, -1, -1),
                Vector3.new( 1,  1,  1), Vector3.new( 1,  1, -1),
                Vector3.new( 1, -1,  1), Vector3.new( 1, -1, -1),
                Vector3.new(-1,  1,  1), Vector3.new(-1,  1, -1),
                Vector3.new(-1, -1,  1), Vector3.new(-1, -1, -1),
            }

            local KILL_SEAT_REFINE_LATTICE = (function()
                local lattice = {}
                for x = -1, 1 do
                    for y = -1, 1 do
                        for z = -1, 1 do
                            if not (x == 0 and y == 0 and z == 0) then
                                lattice[#lattice + 1] = Vector3.new(x, y, z)
                            end
                        end
                    end
                end
                return lattice
            end)()

            function RivalsRagebot.ScoreSeatPosition(pos)
                if IsPointInOOBVolume(pos) then return -1 end
                local distinctParts = {}
                local distinctCount = 0
                local hitCount = 0
                local cardinalHits = 0
                local rayLen = RivalsRagebot.KillSeatScoreRayLength
                for _, dir in ipairs(KILL_SEAT_SAMPLE_DIRECTIONS) do
                    local samplePos = pos + dir * rayLen
                    local hitPart = GetOOBPartAt(samplePos)
                    if hitPart then
                        hitCount = hitCount + 1
                        if not distinctParts[hitPart] then
                            distinctParts[hitPart] = true
                            distinctCount = distinctCount + 1
                        end
                        if (math.abs(dir.X) + math.abs(dir.Y) + math.abs(dir.Z)) < 1.05 then
                            cardinalHits = cardinalHits + 1
                        end
                    end
                end
                if hitCount == 0 then return 0 end
                return cardinalHits * 10000 + distinctCount * 1000 + hitCount
            end

            function RivalsRagebot.RefineKillSeatPosition(seatPos)
                local step = RivalsRagebot.KillSeatRefineStep or 1.0
                local bestPos = seatPos
                local bestScore = RivalsRagebot.ScoreSeatPosition(seatPos)
                for _, offset in ipairs(KILL_SEAT_REFINE_LATTICE) do
                    local candidatePos = seatPos + offset * step
                    local s = RivalsRagebot.ScoreSeatPosition(candidatePos)
                    if s > bestScore then
                        bestScore = s
                        bestPos = candidatePos
                    end
                end
                return bestPos
            end

            function RivalsRagebot.BuildKillSeats(force)
                local now = tick()
                if not force
                    and RivalsRagebotState.KillSeats
                    and (now - RivalsRagebotState.KillSeatsBuiltAt) < RivalsRagebot.KillSeatBuildTtlSec
                then
                    return RivalsRagebotState.KillSeats
                end

                local CollectionService = game:GetService('CollectionService')
                local oobParts = CollectionService:GetTagged('OutOfBoundsPart')
                if not oobParts or #oobParts == 0 then
                    RivalsRagebotState.KillSeats = {}
                    RivalsRagebotState.KillSeatsBuiltAt = now
                    return RivalsRagebotState.KillSeats
                end

                local buffer = RivalsRagebot.KillSeatBufferDistance
                local rayLen = RivalsRagebot.KillSeatScoreRayLength
                local candidates = {}

                for _, oob in ipairs(oobParts) do
                    if oob:IsA('BasePart') then
                        local size = oob.Size
                        local cframe = oob.CFrame
                        local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
                        for _, axis in ipairs(KILL_SEAT_AXIS_OFFSETS) do
                            local localOffset = Vector3.new(
                                axis.X * (hx + buffer),
                                axis.Y * (hy + buffer),
                                axis.Z * (hz + buffer)
                            )
                            local seatPos = cframe:PointToWorldSpace(localOffset)
                            if not IsPointInOOBVolume(seatPos) then
                                local distinctParts = {}
                                local distinctCount = 0
                                local hitCount = 0
                                local cardinalHits = 0
                                local openSum = Vector3.zero
                                for _, dir in ipairs(KILL_SEAT_SAMPLE_DIRECTIONS) do
                                    local samplePos = seatPos + dir * rayLen
                                    local hitPart = GetOOBPartAt(samplePos)
                                    if hitPart then
                                        hitCount = hitCount + 1
                                        if not distinctParts[hitPart] then
                                            distinctParts[hitPart] = true
                                            distinctCount = distinctCount + 1
                                        end
                                        if (math.abs(dir.X) + math.abs(dir.Y) + math.abs(dir.Z)) < 1.05 then
                                            cardinalHits = cardinalHits + 1
                                        end
                                    else
                                        openSum = openSum + dir
                                    end
                                end
                                if hitCount > 0 then
                                    local openDir = (openSum.Magnitude > 0.001) and openSum.Unit or Vector3.new(0, 1, 0)
                                    table.insert(candidates, {
                                        Position = seatPos,
                                        Score = cardinalHits * 10000 + distinctCount * 1000 + hitCount,
                                        CardinalHits = cardinalHits,
                                        DistinctParts = distinctCount,
                                        HitCount = hitCount,
                                        OpenDirection = openDir,
                                    })
                                end
                            end
                        end
                    end
                end

                table.sort(candidates, function(a, b)
                    return a.Score > b.Score
                end)

                local maxKept = RivalsRagebot.KillSeatMaxKept
                if maxKept and #candidates > maxKept then
                    for i = #candidates, maxKept + 1, -1 do
                        candidates[i] = nil
                    end
                end

                RivalsRagebotState.KillSeats = candidates
                RivalsRagebotState.KillSeatsBuiltAt = now
                return candidates
            end

            function RivalsRagebot.PickKillSeatNearestTarget(referencePos)
                local now = tick()
                if RivalsRagebotState.CurrentKillSeat
                    and (now - RivalsRagebotState.LastKillSeatPickAt) < RivalsRagebot.KillSeatRefreshIntervalSec
                then
                    return RivalsRagebotState.CurrentKillSeat
                end

                local seats = RivalsRagebot.BuildKillSeats(false)
                if not seats or #seats == 0 then
                    RivalsRagebotState.CurrentKillSeat = nil
                    RivalsRagebotState.LastKillSeatPickAt = now
                    return nil
                end

                local bestSeat = nil
                local bestComposite = math.huge
                local distanceWeight = RivalsRagebot.KillSeatScoreDistanceWeight
                for _, seat in ipairs(seats) do
                    local dist = referencePos and (seat.Position - referencePos).Magnitude or 0
                    local composite = -seat.Score + dist * distanceWeight
                    if composite < bestComposite then
                        bestComposite = composite
                        bestSeat = seat
                    end
                end

                local picked = nil
                if bestSeat then
                    if not bestSeat.RefinedPosition then
                        bestSeat.RefinedPosition = RivalsRagebot.RefineKillSeatPosition(bestSeat.Position)
                    end
                    picked = bestSeat.RefinedPosition
                end
                RivalsRagebotState.CurrentKillSeat = picked
                RivalsRagebotState.LastKillSeatPickAt = now
                return picked
            end

            function RivalsRagebot.IsBaitModeEnabled()
                return Toggles.P8S4T3 and Toggles.P8S4T3.Value == true
            end

            function RivalsRagebot.UpdateHostileTeleportTracker(now)
                local minDt = RivalsRagebot.HostileTrackerSampleMinDt
                if (now - (RivalsRagebotState.LastHostileTrackerSampleAt or 0)) < minDt then
                    return
                end
                RivalsRagebotState.LastHostileTrackerSampleAt = now

                local hostileTeleports = RivalsRagebotState.HostileTeleports
                local fighters = LocalFighterController and LocalFighterController.Objects or {}
                for _, fighter in ipairs(fighters) do
                    local player = fighter and fighter.Player
                    if player and player ~= LP and player.Parent == Players and RivalsRagebot.IsCombatTarget(player) then
                        local char = player.Character
                        local hrp = char and char:FindFirstChild('HumanoidRootPart')
                        if hrp and hrp.Parent then
                            local entry = hostileTeleports[player]
                            if not entry then
                                entry = { LastPos = hrp.Position, LastCheckedAt = now, Teleports = {}, Offsets = {} }
                            end
                            hostileTeleports[player] = entry
                            entry.SeenAt = now

                            local dt = now - entry.LastCheckedAt
                            if dt >= minDt then
                                local dist = (hrp.Position - entry.LastPos).Magnitude
                                if dist > RivalsRagebot.HostileTeleportDeltaStuds and (dist / dt) > RivalsRagebot.HostileTeleportMinSpeed then
                                    table.insert(entry.Teleports, now)
                                    local localChar = LP and LP.Character
                                    local localHrp = localChar and localChar:FindFirstChild('HumanoidRootPart')
                                    if localHrp then
                                        table.insert(entry.Offsets, { Time = now, Offset = hrp.Position - localHrp.Position })
                                    end
                                end
                                entry.LastPos = hrp.Position
                                entry.LastCheckedAt = now
                            end

                            local windowSec = RivalsRagebot.HostileTeleportWindowSec
                            for index = #entry.Teleports, 1, -1 do
                                if (now - entry.Teleports[index]) >= windowSec then
                                    table.remove(entry.Teleports, index)
                                end
                            end
                            for index = #entry.Offsets, 1, -1 do
                                if (now - entry.Offsets[index].Time) >= windowSec then
                                    table.remove(entry.Offsets, index)
                                end
                            end
                        end
                    end
                end
                for player, entry in pairs(hostileTeleports) do
                    if entry.SeenAt ~= now then
                        hostileTeleports[player] = nil
                    end
                end
            end

            function RivalsRagebot.IsHostileCheating()
                local minCount = RivalsRagebot.HostileTeleportMinCount
                local hostileTeleports = RivalsRagebotState.HostileTeleports
                if not hostileTeleports then
                    return false
                end
                for _, entry in pairs(hostileTeleports) do
                    if entry.Teleports and #entry.Teleports >= minCount then
                        return true
                    end
                end
                return false
            end

            function RivalsRagebot.GetMostActiveCheater()
                local hostileTeleports = RivalsRagebotState.HostileTeleports
                if not hostileTeleports then return nil end
                local bestPlayer, bestCount = nil, 0
                for player, entry in pairs(hostileTeleports) do
                    local count = entry.Teleports and #entry.Teleports or 0
                    if count > bestCount then
                        bestCount = count
                        bestPlayer = player
                    end
                end
                return bestPlayer, bestCount
            end

            function RivalsRagebot.GetCheaterOffsetPrediction(player)
                local entry = player and RivalsRagebotState.HostileTeleports and RivalsRagebotState.HostileTeleports[player]
                if not entry or not entry.Offsets then return nil end
                local samples = RivalsRagebot.BaitTrapOffsetSamples
                local minSamples = RivalsRagebot.BaitTrapMinSamples
                local total = #entry.Offsets
                if total < minSamples then return nil end
                local startIdx = math.max(1, total - samples + 1)
                local sum = Vector3.zero
                local count = 0
                for i = startIdx, total do
                    sum = sum + entry.Offsets[i].Offset
                    count = count + 1
                end
                if count == 0 then return nil end
                return sum / count
            end

            function RivalsRagebot.FindBaitTrapPosition(predictedOffset)
                if not predictedOffset then return nil end
                local seats = RivalsRagebot.BuildKillSeats(false)
                if not seats or #seats == 0 then return nil end
                local localChar = LP and LP.Character
                local localHrp = localChar and localChar:FindFirstChild('HumanoidRootPart')
                local refPos = localHrp and localHrp.Position or nil
                local maxDist = RivalsRagebot.BaitTrapMaxCandidateDist
                local bestSeat, bestComposite = nil, math.huge
                for _, seat in ipairs(seats) do
                    if seat.Position then
                        local landingPos = seat.Position + predictedOffset
                        if IsPointInOOBVolume(landingPos) then
                            local dist = refPos and (seat.Position - refPos).Magnitude or 0
                            if not refPos or dist <= maxDist then
                                local composite = dist - (seat.Score * 0.0001)
                                if composite < bestComposite then
                                    bestComposite = composite
                                    bestSeat = seat
                                end
                            end
                        end
                    end
                end
                if not bestSeat then return nil end
                if not bestSeat.RefinedPosition then
                    bestSeat.RefinedPosition = RivalsRagebot.RefineKillSeatPosition(bestSeat.Position)
                end
                return bestSeat.RefinedPosition or bestSeat.Position
            end

            function RivalsRagebot.PivotToBaitTrapOrSnug()
                local now = tick()
                if RivalsRagebotState.LastBaitTrapPos
                    and (now - (RivalsRagebotState.LastBaitTrapPickAt or 0)) < RivalsRagebot.BaitTrapHysteresisSec
                then
                    local activeChar = RivalsRuntimeBridge.AcquireActiveCharacter()
                    if activeChar then
                        local cur = activeChar:GetPivot()
                        activeChar:PivotTo(CFrame.new(RivalsRagebotState.LastBaitTrapPos) * (cur - cur.Position))
                        return true
                    end
                end

                local cheater = RivalsRagebot.GetMostActiveCheater()
                local predicted = cheater and RivalsRagebot.GetCheaterOffsetPrediction(cheater) or nil
                local trapPos = predicted and RivalsRagebot.FindBaitTrapPosition(predicted) or nil

                if not trapPos then
                    -- Snug-lock fallback: highest-scored seat (seats are pre-sorted descending by Score).
                    local seats = RivalsRagebot.BuildKillSeats(false)
                    if seats and #seats > 0 then
                        local snug = seats[1]
                        if not snug.RefinedPosition then
                            snug.RefinedPosition = RivalsRagebot.RefineKillSeatPosition(snug.Position)
                        end
                        trapPos = snug.RefinedPosition or snug.Position
                    end
                end

                if not trapPos then return false end
                RivalsRagebotState.LastBaitTrapPos = trapPos
                RivalsRagebotState.LastBaitTrapPickAt = now

                local activeChar = RivalsRuntimeBridge.AcquireActiveCharacter()
                if not activeChar then return false end
                local cur = activeChar:GetPivot()
                activeChar:PivotTo(CFrame.new(trapPos) * (cur - cur.Position))
                return true
            end

            function RivalsRagebot.ResolveRespawnRemote()
                local remotes = ReplicatedStorage:FindFirstChild('Remotes')
                local duels = remotes and remotes:FindFirstChild('Duels')
                local respawnNow = duels and duels:FindFirstChild('RespawnNow')
                if respawnNow and respawnNow:IsA('RemoteEvent') then
                    return respawnNow
                end
                return nil
            end

            function RivalsRagebot.TryRespawn()
                if not RivalsRagebot.IsRespawnEnabled() then
                    return false
                end

                local now = tick()
                if (now - RivalsRagebotState.LastRespawnRequestAt) < RivalsRagebot.RespawnRequestInterval then
                    return false
                end

                local respawnNow = RivalsRagebot.ResolveRespawnRemote()
                if not respawnNow then
                    return false
                end

                RivalsRagebotState.LastRespawnRequestAt = now
                task.spawn(GuardRivalsCallback('AutoRespawn_Burst', function()
                    for requestIndex = 1, RivalsRagebot.RespawnBurstCount do
                        safe_fire_server(respawnNow)
                        if requestIndex < RivalsRagebot.RespawnBurstCount then
                            task.wait(RivalsRagebot.RespawnBurstDelay)
                        end
                    end
                end))
                return true
            end

            function RivalsRagebot.QueueRespawn()
                task.defer(function()
                    RivalsRagebot.TryRespawn()
                end)
            end

            -- Kicia parity: Auto Respawn triggers on the replicated respawn-animation event
            -- for the local player, not on the death prompt appearing. Their handler is
            -- exactly `enumName == "RespawnNowAnimation" and args[1] == LocalPlayer`, then
            -- the bounded five-request burst. The event is upstream of the button, so it
            -- fires earlier and does not depend on the MainGui hierarchy rendering at all.
            function RivalsRagebot.RegisterRespawnSignals()
                local binding = RivalsRagebotState.RespawnBinding
                if not binding then
                    binding = RivalsRuntimeBridge.ReplicateHook.Reserve({ 'RespawnNowAnimation' })
                    if not binding then
                        return
                    end
                    binding:SetHandler(function(packet)
                        if packet.enumName ~= 'RespawnNowAnimation' or packet.args[1] ~= LP then
                            return
                        end
                        RivalsRagebot.QueueRespawn()
                    end)
                    RivalsRagebotState.RespawnBinding = binding
                end
                binding:SetEnabled(RivalsRagebot.IsRespawnEnabled())
                RivalsRuntimeBridge.ReplicateHook.RevertIfIdle()
            end

            function RivalsRagebot.IsCombatTarget(player)
                return IsPlayerInLocalEnvironment(player)
            end

            local SHIELD_CLAMP_RAD = math.rad(45)

            function RivalsRagebot.ResolveTarget(rawPhase)
                EnsureAimbotTargetTracking()

                local camera = Workspace.CurrentCamera
                if not camera then
                    return nil
                end

                local mousePosition = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)
                local radius = RivalsRagebot.ResolveRadius()
                local heightOffset = RivalsRagebot.ResolveHeightOffset(RivalsRagebotState.PhaseClockSec)
                local observerPosition = HumanoidRootPart and HumanoidRootPart.Position
                local bestTarget = nil
                local bestHoverCFrame = nil

                for _, fighter in ipairs(LocalFighterController and LocalFighterController.Objects or {}) do
                    local player = fighter and fighter.Player
                    if player and player ~= LP and player.Parent == Players and ShouldShow(player, false) and RivalsRagebot.IsCombatTarget(player) then
                        local entity = fighter.Entity
                        local subject = entity and entity.Model
                        -- Spawn-shield pre-track: ragebot hovers around shielded targets so native
                        -- trigger input can resume as soon as the shield ends.
                        if subject then
                            local targetInfo = RivalsRuntimeBridge.BuildAimbotTargetInfo(subject, 'Players', 'Auto', mousePosition, player, math.huge, nil, true, camera, 'Ragebot', true)
                            if targetInfo then
                                local targetRootPart = subject:FindFirstChild('HumanoidRootPart')
                                if targetRootPart and targetRootPart.Parent then
                                    local effectivePhase = rawPhase or 0
                                    local shieldState = EvaluateRivalsRiotShieldChecker(player, subject or player.Character, observerPosition)
                                    if shieldState and shieldState.IsShieldEquipped == true then
                                        effectivePhase = math.clamp(effectivePhase, -SHIELD_CLAMP_RAD, SHIELD_CLAMP_RAD)
                                    elseif shieldState and shieldState.HasShieldInLoadout == true then
                                        effectivePhase = math.pi + math.clamp(effectivePhase, -SHIELD_CLAMP_RAD, SHIELD_CLAMP_RAD)
                                    end
                                    local hoverCFrame = RivalsRagebot.ResolveRagebotCFrame(targetRootPart, radius, heightOffset, effectivePhase)
                                    if RivalsRagebot.IsCandidatePositionInBounds(hoverCFrame.Position, subject) then
                                        local clearLine = shieldState and shieldState.IsShieldEquipped == true
                                        if not clearLine then
                                            local rayOrigin = hoverCFrame.Position
                                            local rayDir = targetRootPart.Position - rayOrigin
                                            if rayDir.Magnitude > 0 then
                                                RivalsRagebot.LosRaycastParams.FilterDescendantsInstances = { Char, subject }
                                                clearLine = not Workspace:Raycast(rayOrigin, rayDir, RivalsRagebot.LosRaycastParams)
                                            end
                                        end
                                        -- Ragebot hovers the physically nearest enemy; keep ranking by
                                        -- world distance now that selectionDistance is cursor-first.
                                        if clearLine and (not bestTarget or targetInfo.worldDistance < bestTarget.worldDistance) then
                                            bestTarget = targetInfo
                                            bestHoverCFrame = hoverCFrame
                                            RivalsRagebotState.LastKnownTargetPos = targetRootPart.Position
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                return bestTarget, bestHoverCFrame
            end

            function RivalsRagebot.Update(deltaTime)
                RefreshRageHandles()
                local now = tick()
                if RivalsRagebot.IsBaitModeEnabled() then
                    RivalsRagebot.UpdateHostileTeleportTracker(now)
                    if RivalsRagebot.IsHostileCheating() then
                        -- OOB Bait takes over the root this frame; release the Kicia ragebot's
                        -- part-glue/server-CFrame so the two mechanisms do not fight.
                        if RivalsRuntimeBridge.ResetKiciaRagebot then
                            RivalsRuntimeBridge.ResetKiciaRagebot()
                        end
                        local item = AimbotBridge.ResolveAimbotEquippedItem()
                        local shotReady = AimbotBridge.IsShotImmediatelyReady(item)

                        if shotReady then
                            RivalsRagebotState.PhaseClockSec = RivalsRagebotState.PhaseClockSec + (deltaTime or 0)
                            local rawPhase = math.random() * TWO_PI
                            local targetInfo, hoverCFrame = RivalsRagebot.ResolveTarget(rawPhase)
                            if hoverCFrame then
                                RivalsRagebotState.HoldCFrame = hoverCFrame
                                RivalsRagebotState.LastHoldUpdateAt = now
                            end
                            local stale = (now - (RivalsRagebotState.LastHoldUpdateAt or 0)) > RivalsRagebot.HoldCFrameStaleTtlSec
                            local holdCFrame = hoverCFrame or (not stale and RivalsRagebotState.HoldCFrame) or nil
                            if stale then
                                RivalsRagebotState.HoldCFrame = nil
                            end
                            if holdCFrame and not RivalsRagebot.IsCandidatePositionInBounds(holdCFrame.Position, nil) then
                                RivalsRagebotState.HoldCFrame = nil
                                holdCFrame = nil
                            end
                            RivalsRagebotState.Target = targetInfo or nil
                            if holdCFrame then
                                local activeChar = RivalsRuntimeBridge.AcquireActiveCharacter()
                                if activeChar then
                                    local cur = activeChar:GetPivot()
                                    activeChar:PivotTo(CFrame.new(holdCFrame.Position) * (cur - cur.Position))
                                end
                                return
                            end
                        end

                        RivalsRagebotState.Target = nil
                        RivalsRagebotState.HoldCFrame = nil
                        RivalsRagebotState.LastHoldUpdateAt = 0
                        RivalsRagebot.PivotToBaitTrapOrSnug()
                        return
                    end
                end

                local enabled = RivalsRagebot.IsEnabled()
                if not enabled then
                    RivalsRagebotState.Target = nil
                    RivalsRagebotState.HoldCFrame = nil
                    RivalsRagebotState.LastHoldUpdateAt = 0
                    RivalsRagebotState.PhaseClockSec = 0
                    RivalsRuntimeBridge.RecordCharacterLoadingCheckpoint('Ragebot', false, false)
                    -- Let the Kicia ragebot settle to its disabled state (release glue, restore FFlags).
                    if RivalsRuntimeBridge.UpdateKiciaRagebot then
