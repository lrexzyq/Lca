                    end
                    return 'Above'
                end
                for _, it in obs:GetItems() do
                    if it.name == 'Riot Shield' then
                        local pitch = math.deg(target:GetCameraRotation().X)
                        if 315 < pitch and pitch < 360 or 0 < pitch and pitch < 91 then
                            return 'Above'
                        end
                        return 'Below'
                    end
                end
                return 'None'
            end)
            if ok and result then
                return result
            end
        end
        return 'None'
    end
