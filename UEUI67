local function safeRequire(obj)
    local success, res = pcall(require, obj)
    if success then return res end
    return nil
end

local function worldToScreen(pos)
    local cam = Workspace.CurrentCamera
    if not cam or typeof(pos) ~= "Vector3" then
        return nil, false
    end
    local ok, vec, onScreen = pcall(cam.WorldToViewportPoint, cam, pos)
    if not ok or not vec then
        return nil, false
    end
    return Vector2.new(vec.X, vec.Y), onScreen == true
end

