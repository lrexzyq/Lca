do
    local _desyncEnabled = false
    local _desyncConn = nil
    local _desyncOriginalEncode = nil
    local _desyncPitch = 89   
    local _desyncYaw   = 0    

    local function encodeSingleByte(radVal)
        
        
        local ok, r = pcall(string.pack, "<f", radVal)
        return ok and r or ""
    end

    local function applyDesyncHook(on)
        
        
        pcall(function()
            local rs = cloneref(game:GetService("ReplicatedStorage"))
            local remote = rs.Remotes and rs.Remotes.Replication
                and rs.Remotes.Replication.Fighter
                and rs.Remotes.Replication.Fighter.UpdateCameraRotation

            if not remote then
                
                for _, obj in ipairs(rs:GetDescendants()) do
                    if obj:IsA("RemoteEvent") and obj.Name:lower():find("camera") then
                        remote = obj
                        break
                    end
                end
            end

            if not remote then return end

            if on then
                if _desyncOriginalEncode then return end 
                local oldFireServer
                oldFireServer = hookmetamethod(remote, "__namecall", function(self, ...)
                    local method = getnamecallmethod()
                    if method == "FireServer" and self == remote and _desyncEnabled then
                        
                        local fakeData = encodeSingleByte(math.rad(_desyncPitch))
                                       .. encodeSingleByte(math.rad(_desyncYaw))
                        return oldFireServer(self, fakeData)
                    end
                    return oldFireServer(self, ...)
                end)
                _desyncOriginalEncode = oldFireServer
            else
                
                _desyncEnabled = false
            end
        end)
    end

    
    Ragebot._desyncState = {
        setEnabled = function(v)
            _desyncEnabled = v
            if v then applyDesyncHook(true) end
        end,
        setPitch = function(v) _desyncPitch = tonumber(v) or 89 end,
        setYaw   = function(v) _desyncYaw   = tonumber(v) or 0  end,
    }
end

