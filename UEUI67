local Exploits = (function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    local Exploits = {}
    Exploits.__index = Exploits

    function Exploits.new(clientFighter, clientItem)
        local self = setmetatable({}, Exploits)
        self.clientFighter = clientFighter
        self.clientItem = clientItem
        self.lastShot = 0

        local function getEquippedItem(character)
            return character and character:FindFirstChild("EquippedItem")
        end

        local function getCurrentItem()
            local item = getEquippedItem(LocalPlayer.Character)
            if item then
                self.clientItem = item
                return item
            end
            return self.clientItem
        end

        local function forceBackstab(character)
            local toggle = Toggles.exploits_always_backstab
            if not toggle or not toggle.Value then return false end

            local item = getCurrentItem()
            if not item then return false end
            local info = item:FindFirstChild("Info") or item.Info
            if not info or info.Type ~= "Melee" then return false end
            if not character then return false end

            local root = character:FindFirstChild("HumanoidRootPart")
            if not root then return false end

            if type(item.HeavyAttack) ~= "function" then
                return false
            end

            local ok = pcall(function()
                item:HeavyAttack(root.Position)
            end)
            return ok
        end

        local lastBackstab = 0
        local function autoBackstab()
            local toggle = Toggles.exploits_always_backstab
            if not toggle or not toggle.Value then return end

            local now = os.clock()
            if now - lastBackstab < 0.15 then return end

            local myCharacter = LocalPlayer.Character
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end

            local nearest, nearestDistance
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local targetHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
                    if targetHumanoid and targetHumanoid.Health > 0 and targetRoot then
                        local sameTeam = false
                        pcall(function()
                            sameTeam = player.Team == LocalPlayer.Team
                        end)
                        if not sameTeam then
                            local distance = (targetRoot.Position - myRoot.Position).Magnitude
                            if not nearestDistance or distance < nearestDistance then
                                nearestDistance = distance
                                nearest = player.Character
                            end
                        end
                    end
                end
            end

            if nearest and forceBackstab(nearest) then
                lastBackstab = now
            end
        end

        local function autoRespawn()
            local toggle = Toggles.arcade_auto_respawn
            if not toggle or not toggle.Value then return end
            local character = LocalPlayer.Character
            local hum = character and character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                task.spawn(function()
                    while Toggles.arcade_auto_respawn and Toggles.arcade_auto_respawn.Value do
                        local char = LocalPlayer.Character
                        local currentHum = char and char:FindFirstChildOfClass("Humanoid")
                        if currentHum and currentHum.Health > 0 then break end
                        local ok = pcall(function() keypress(0x20) end)
                        if ok then
                            task.wait(0.1)
                            pcall(function() keyrelease(0x20) end)
                            task.wait(0.1)
                        else
                            break
                        end
                    end
                end)
            end
        end

        local boosterTime = 0
        local function autoCollect(dt)
            local healthOn = Toggles.arcade_auto_health and Toggles.arcade_auto_health.Value
            local ammoOn = Toggles.arcade_auto_ammo and Toggles.arcade_auto_ammo.Value
            if not healthOn and not ammoOn then return end

            local character = LocalPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            boosterTime += (tonumber(dt) or 0.016) * 8
            local bounce = math.sin(boosterTime) * 4

            for _, obj in ipairs(workspace:GetChildren()) do
                if obj.Name == "_drop" and obj:IsA("BasePart") then
                    local collect = (ammoOn and obj:FindFirstChild("Ammo")) or (healthOn and obj:FindFirstChild("Health"))
                    if collect then
                        pcall(function()
                            obj.Anchored = true
                            obj.CFrame = CFrame.new(hrp.Position + Vector3.new(0, bounce, 0))
                            obj.Transparency = 1
                            for _, child in ipairs(obj:GetDescendants()) do
                                if child:IsA("BasePart") or child:IsA("UnionOperation") or child:IsA("MeshPart") or child:IsA("SpecialMesh") then
                                    child.Transparency = 1
                                elseif child:IsA("BillboardGui") or child:IsA("SurfaceGui") or child:IsA("ParticleEmitter") or child:IsA("SelectionBox") then
                                    child.Enabled = false
                                end
                            end
                        end)
                    end
                end
            end
        end

        self.connections = {
            RunService.Heartbeat:Connect(autoBackstab),
            RunService.Heartbeat:Connect(autoRespawn),
            RunService.RenderStepped:Connect(autoCollect),
        }

        return self
    end

    function Exploits:Destroy()
        if self.connections then
            for _, connection in ipairs(self.connections) do
                pcall(function() connection:Disconnect() end)
            end
            self.connections = nil
        end
    end

    return Exploits
end)()

