local function getAimPartCandidates(character)
    local candidates = {}
    if not character then return candidates end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") then
            candidates[#candidates + 1] = child
        end
    end
    return candidates
end

local function isHeadPart(part)
    if not part then return false end
    local n = string.lower(part.Name)
    return n == "head" or n:find("head", 1, true) ~= nil
end

local function resolveSilentPart(character)
    if not character then return nil end
    local mode = silentAim.aimPart
    if mode == "Auto" or mode == "Head" then
        return character:FindFirstChild("Head")
            or character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("HumanoidRootPart")
    end
    if mode == "Random" then
        local candidates = getAimPartCandidates(character)
        if #candidates == 0 then return nil end
        local heads, body = {}, {}
        for _, part in ipairs(candidates) do
            if isHeadPart(part) then
                heads[#heads + 1] = part
            else
                body[#body + 1] = part
            end
        end
        local bucket = math.random(1, 2) == 1 and heads or body
        if #bucket == 0 then bucket = #heads > 0 and heads or body end
        return bucket[math.random(1, #bucket)]
    end
    return character:FindFirstChild(mode) or character:FindFirstChild("Head")
end

local function isSpawnShielded(player)
