Connections = Connections or (function()
    local handles = {}
    local registry = {}
    local function disconnectHandle(handle)
        if type(handle) == "function" then
            pcall(handle)
        elseif type(handle) == "table" and type(handle.Disconnect) == "function" then
            pcall(handle.Disconnect, handle)
        else
            pcall(function() handle:Disconnect() end)
        end
    end
    function registry:register(name, handle)
        if handles[name] ~= nil then disconnectHandle(handles[name]) end
        handles[name] = handle
        return handle
    end
    function registry:get(name) return handles[name] end
    function registry:disconnect(names)
        for _, name in ipairs(names) do
            if handles[name] ~= nil then
                disconnectHandle(handles[name])
                handles[name] = nil
            end
        end
    end
    function registry:disconnect_all()
        for name, handle in pairs(handles) do
            disconnectHandle(handle)
            handles[name] = nil
        end
    end
    setmetatable(registry, {
        __newindex = function(_, name, handle) registry:register(name, handle) end,
        __index = function(_, name) return handles[name] end,
    })
    return registry
end)()

local GuardRivalsWarnAt = {}
local function GuardRivalsCallback(feature, callback)
    return function(...)
        local args = table.pack(...)
        if type(callback) ~= 'function' then
            local now = os.clock()
            if now - (GuardRivalsWarnAt[feature] or 0) >= 2 then
                GuardRivalsWarnAt[feature] = now
                warn(string.format('[%s] callback unavailable', tostring(feature)))
            end
            return nil
        end
        local ok, result = xpcall(function()
            return callback(table.unpack(args, 1, args.n))
        end, function(err)
            return debug.traceback(string.format('[%s] %s', tostring(feature), tostring(err)), 2)
        end)
        if not ok then
            local now = os.clock()
            if now - (GuardRivalsWarnAt[feature] or 0) >= 2 then
                GuardRivalsWarnAt[feature] = now
                warn(result)
            end
            return nil
        end
        return result
    end
end

local ReplicatedStateReady = false
local ReplicatedStateBootStarted = false
local function BeginReplicatedStateBoot()
    if ReplicatedStateBootStarted then return end
    ReplicatedStateBootStarted = true
    task.defer(function()
        local enumLibrary = nil
        pcall(function() enumLibrary = ResolveEnumLibrary() end)
        if enumLibrary then
            local ready = enumLibrary._enum_builder_complete == true
            if type(enumLibrary.WaitForEnumBuilder) == "function" and not ready then
                pcall(enumLibrary.WaitForEnumBuilder, enumLibrary)
                ready = enumLibrary._enum_builder_complete == true
            end
            if ready or type(enumLibrary.FromEnum) == "function" then
                ReplicatedStateReady = true
            end
        end
        if not ReplicatedStateReady then
            ReplicatedStateReady = KiciaIsReadyToFight()
        end
    end)
end
local function IsReplicatedStateReady()
    if not ReplicatedStateReady then BeginReplicatedStateBoot() end
    return ReplicatedStateReady or KiciaIsReadyToFight()
end


local function ResolveLocalFighter()
    local playerScripts = LP and LP:FindFirstChild('PlayerScripts')
    local controllers = playerScripts and playerScripts:FindFirstChild('Controllers')
    local fighterModule = controllers and controllers:FindFirstChild('FighterController')
    if fighterModule then
        local ok, controller = pcall(require, fighterModule)
        if ok and type(controller) == 'table' then
            if type(controller.CurrentObject) == 'table' then
                return controller.CurrentObject
            end
            if type(controller.Objects) == 'table' then
                for _, fighter in pairs(controller.Objects) do
                    if type(fighter) == 'table' and (fighter.Player == LP or fighter.IsLocal == true) then
                        return fighter
                    end
                end
            end
        end
    end
    local character = LP and LP.Character
    local humanoid = character and character:FindFirstChildOfClass('Humanoid')
    local root = character and character:FindFirstChild('HumanoidRootPart')
    return {
        Player = LP,
        Character = character,
        Humanoid = humanoid,
        RootPart = root,
        Data = {
            ObjectID = character,
            EnvironmentID = character and character:GetAttribute('EnvironmentID') or nil,
            IsInShootingRange = false,
            IsInDuel = false,
        },
        Items = {},
        Entity = nil,
    }
end

