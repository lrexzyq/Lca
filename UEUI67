local function getModule(pathParts)
    local obj = lp.PlayerScripts
    for _, name in ipairs(pathParts) do
        obj = obj and obj:FindFirstChild(name)
    end
    if not obj then return nil end
    local ok, result = pcall(require, obj)
    return ok and result or nil
end

local function restoreWeaponOriginals(name)
    if name == "NoMeleeAnimation" then
        local m = getModule({"Modules", "ItemTypes", "Melee"})
        if m and WeaponOriginals.MeleeStartShooting then m.StartShooting = WeaponOriginals.MeleeStartShooting end
    elseif name == "NoShootAnimation" then
        local g = getModule({"Modules", "ItemTypes", "Gun"})
        if g then
            if WeaponOriginals.GunStartShooting then g.StartShooting = WeaponOriginals.GunStartShooting end
            if WeaponOriginals.GunFinishShooting then g.FinishShooting = WeaponOriginals.GunFinishShooting end
            if WeaponOriginals.GunShootBurst then g.ShootBurst = WeaponOriginals.GunShootBurst end
        end
    elseif name == "NoEquipAnimation" then
        local g = getModule({"Modules", "ItemTypes", "Gun"})
        if g and WeaponOriginals.GunEquip then g.Equip = WeaponOriginals.GunEquip end
    elseif name == "InstantADS" then
        local g = getModule({"Modules", "ItemTypes", "Gun"})
        if g then
            if WeaponOriginals.GunStartAiming then g.StartAiming = WeaponOriginals.GunStartAiming end
            if WeaponOriginals.GunGetAimSpeed then g.GetAimSpeed = WeaponOriginals.GunGetAimSpeed end
        end
    elseif name == "RapidFire" then
        local g = getModule({"Modules", "ItemTypes", "Gun"})
        if g and WeaponOriginals.GunUpdate then g.Update = WeaponOriginals.GunUpdate end
    elseif name == "NoSpread" then
        local g = getModule({"Modules", "GameplayUtility"})
        if g and WeaponOriginals.GameplayGetSpread then g.GetSpread = WeaponOriginals.GameplayGetSpread end
    elseif name == "NoSmoke" then
        local m = getModule({"Modules", "ClientReplicatedClasses", "ClientFighter", "FighterInterface", "SmokeScreen"})
        if m and WeaponOriginals.SmokeScreenUpdate then m.Update = WeaponOriginals.SmokeScreenUpdate end
        local c = getModule({"Modules", "SmokeCloud"})
        if c and WeaponOriginals.SmokeCloudUpdate then c.Update = WeaponOriginals.SmokeCloudUpdate end
    elseif name == "NoRecoil" then
        local m = getModule({"Modules", "ClientReplicatedClasses", "ClientFighter", "ClientItem"})
        if m and WeaponOriginals.ClientRecoil then m._Recoil = WeaponOriginals.ClientRecoil end
    elseif name == "NoFlash" then
        local m = getModule({"Modules", "ClientReplicatedClasses", "ClientFighter", "FighterInterface", "Flashed"})
        if m and WeaponOriginals.Flashed then m.Flash = WeaponOriginals.Flashed end
    elseif name == "DeviceSpoof" then
        local m = getModule({"Controllers", "FighterController"})
        if m and WeaponOriginals.FighterReplicateControls then m._ReplicateControls = WeaponOriginals.FighterReplicateControls end
    elseif name == "NoDashCooldown" then
        for item, fields in pairs(WeaponOriginals.ScytheFields) do
            if type(item) == "table" then
                for field, original in pairs(fields) do item[field] = original end
            end
        end
    elseif name == "NoMeleeCooldown" then
        for item, fields in pairs(WeaponOriginals.MeleeFields) do
            if type(item) == "table" then
                for field, original in pairs(fields) do item[field] = original end
            end
        end
    end
end

