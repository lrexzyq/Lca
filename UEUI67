function RivalsRuntimeBridge.MovementRecorder.Notify(message)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if recorder.ReadToggle('P10S4T3') then
        return
    end
    if Library and type(Library.Notify) == 'function' then
        Library:Notify({Title = 'Movement Recorder', Description = message, Time = 3})
    end
