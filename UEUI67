function RivalsRuntimeBridge.MovementRecorder.RebuildWaypoints(context)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.DestroyWaypoints()
    recorder.WaypointDirty = false
    recorder.WaypointMapName = context.MapName
    recorder.WaypointMapModel = context.MapModel
    recorder.WaypointAnchor = context.MapAnchor
    local grouped = {}
    for _, name in ipairs(recorder.RecordsByMap[context.MapName] or {}) do
        local recording = recorder.RecordsByName[name]
        if recording then
            local position = recording.startCFrame.Position
            local key = math.floor(position.X / 8) .. ','
                .. math.floor(position.Y / 8) .. ',' .. math.floor(position.Z / 8)
            local group = grouped[key]
            if not group then
                group = {Recordings = {}, Position = Vector3.zero}
                grouped[key] = group
            end
            group.Recordings[#group.Recordings + 1] = recording
            group.Position = group.Position + position
        end
    end
    for _, group in pairs(grouped) do
        local worldPosition = context.MapAnchor:PointToWorldSpace(
            group.Position / #group.Recordings)
        local text = #group.Recordings == 1 and '1 recording'
            or tostring(#group.Recordings) .. ' recordings'
        local marker = recorder.CreateWaypointGui(text, worldPosition, false)
        marker.Recordings = group.Recordings
        recorder.Markers[#recorder.Markers + 1] = marker
        for _, recording in ipairs(group.Recordings) do
            local route = recorder.CreateWaypointGui(
                recording.name,
                context.MapAnchor:PointToWorldSpace(recording.displayPosition),
                true
            )
            route.Recording = recording
            route.Marker = marker
            recorder.Routes[#recorder.Routes + 1] = route
        end
    end
end

function RivalsRuntimeBridge.MovementRecorder.UpdateWaypoints()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    for _, marker in ipairs(recorder.Markers) do marker.Gui.Enabled = false end
    for _, route in ipairs(recorder.Routes) do route.Gui.Enabled = false end
    if not recorder.ReadToggle('P10S4T1') then
        recorder.SelectedRecording = nil
        return
    end
    local context = recorder.ResolveMapContext()
    if not context then
        recorder.SelectedRecording = nil
        return
    end
    if recorder.WaypointDirty or recorder.WaypointMapName ~= context.MapName
        or recorder.WaypointMapModel ~= context.MapModel
        or recorder.WaypointAnchor ~= context.MapAnchor then
        recorder.RebuildWaypoints(context)
    end
    local hideUi = recorder.ReadToggle('P10S4T2')
    if recorder.ActivatedRecording then
        recorder.SelectedRecording = recorder.ActivatedRecording
        if not hideUi then
            for _, route in ipairs(recorder.Routes) do
                if route.Recording == recorder.ActivatedRecording then
                    route.Label.TextColor3 = Color3.new(0, 1, 0)
                    route.Gui.Enabled = true
                    break
                end
            end
        end
        return
    end
    local nearest, nearestDistance = nil, math.huge
    for _, marker in ipairs(recorder.Markers) do
        local distance = (marker.Position - context.RootPart.Position).Magnitude
        if distance < recorder.ReadNumber('P10S4S1', 3) and distance < nearestDistance then
            nearest, nearestDistance = marker, distance
        end
    end
    if nearest then
        local camera = Workspace.CurrentCamera
        local bestDistance = math.huge
        recorder.SelectedRecording = nil
        for _, route in ipairs(recorder.Routes) do
            if route.Marker == nearest then
                route.Fulfillable = recorder.LoadoutFulfilled(route.Recording)
                local point, visible = camera and camera:WorldToViewportPoint(route.Position) or nil, false
                if point then visible = point.Z >= 0 end
                if route.Fulfillable and visible then
                    local screenDistance = (Vector2.new(point.X, point.Y) - camera.ViewportSize / 2).Magnitude
                    if screenDistance < bestDistance then
                        bestDistance = screenDistance
                        recorder.SelectedRecording = route.Recording
                    end
                end
            end
        end
        for _, route in ipairs(recorder.Routes) do
            if route.Marker == nearest then
                route.Label.TextColor3 = not route.Fulfillable and Color3.new(1, 0, 0)
                    or route.Recording == recorder.SelectedRecording and Color3.new(1, 1, 0)
                    or Color3.new(1, 1, 1)
                route.Gui.Enabled = not hideUi
            end
        end
        return
    end
    recorder.SelectedRecording = nil
    if not hideUi then
        local renderDistance = recorder.ReadNumber('P10S4S2', 50)
        for _, marker in ipairs(recorder.Markers) do
            local distance = (marker.Position - context.RootPart.Position).Magnitude
            if distance < renderDistance then
                marker.Label.Text = string.format('%s  %.0fm',
                    #marker.Recordings == 1 and '1 recording'
                        or tostring(#marker.Recordings) .. ' recordings',
                    distance)
                marker.Gui.Enabled = true
            end
        end
    end
end

function RivalsRuntimeBridge.MovementRecorder.Begin(kind)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if not recorder.ReadToggle('P10S4T1') then
        recorder.SetToggle(kind == 'Record' and 'P10S4T4' or 'P10S4T5', false)
        return false
    end
    if recorder.IsRoundActive() then
        return kind == 'Record' and recorder.StartRecording()
            or recorder.StartReplay(recorder.SelectedRecording)
    end
    if not recorder.ResolveMapContext() then
        recorder.Notify('You need to be in a match')
        recorder.SetToggle(kind == 'Record' and 'P10S4T4' or 'P10S4T5', false)
        return false
    end
    recorder.PendingKind = kind
    recorder.Notify(kind .. ' will start when the round begins')
    return true
end

function RivalsRuntimeBridge.MovementRecorder.OnRecordToggled(value)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if value then
        if recorder.Mode ~= 'Idle' or recorder.PendingKind then
            recorder.Notify((recorder.Mode == 'Playing' or recorder.Mode == 'Aligning')
                and "Can't record while replaying" or 'Already recording')
            recorder.SetToggle('P10S4T4', false)
            return
        end
        if not recorder.Begin('Record') then
            recorder.SetToggle('P10S4T4', false)
        end
    else
        if recorder.PendingKind == 'Record' then recorder.PendingKind = nil end
        recorder.StopRecording(true, true)
    end
end

function RivalsRuntimeBridge.MovementRecorder.OnReplayToggled(value)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if value then
        if recorder.Mode ~= 'Idle' or recorder.PendingKind then
            recorder.Notify(recorder.Mode == 'Recording'
                and "Can't replay while recording" or 'Already replaying')
            recorder.SetToggle('P10S4T5', false)
            return
        end
        if not recorder.SelectedRecording then
            recorder.Notify('Stand near a recording marker first')
            recorder.SetToggle('P10S4T5', false)
            return
        end
        if not recorder.Begin('Replay') then
            recorder.SetToggle('P10S4T5', false)
        end
    else
        if recorder.PendingKind == 'Replay' then recorder.PendingKind = nil end
        recorder.StopReplay('Stopped', true)
    end
end

function RivalsRuntimeBridge.MovementRecorder.OnEnabledToggled(value)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.LoadPersistence()
    recorder.WaypointDirty = true
    if value then
        return
    end
    recorder.PendingKind = nil
    recorder.StopRecording(false, false)
    recorder.StopReplay('Stopped', false)
    recorder.SetToggle('P10S4T4', false)
    recorder.SetToggle('P10S4T5', false)
    recorder.DestroyWaypoints()
end

function RivalsRuntimeBridge.MovementRecorder.HandleReplicate(_, objectId, enumToken, ...)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if enumToken ~= recorder.RoundToken then
        return
    end
    local fighter = ResolveLocalFighter()
    local data = type(fighter) == 'table' and rawget(fighter, 'Data') or nil
    if type(data) == 'table' and rawget(data, 'ObjectID') ~= objectId then
        return
    end
    local status = ...
    recorder.RoundActive = status == 'RoundStarted'
end

function RivalsRuntimeBridge.MovementRecorder.BindRoundSignal()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if recorder.RoundBindingPending or not Connections then
        return
    end
    recorder.RoundBindingPending = true
    recorder.RoundBindingGeneration = recorder.RoundBindingGeneration + 1
    local generation = recorder.RoundBindingGeneration
    BeginReplicatedStateBoot()
    task.spawn(GuardRivalsCallback('MovementRecorder_BindRound', function()
        local deadline = tick() + 30
        while generation == recorder.RoundBindingGeneration and not ReplicatedStateReady
            and tick() < deadline do
            task.wait(0.1)
        end
        local enumLibrary = ResolveEnumLibrary()
        local tokenOk, token = false, nil
        if enumLibrary and enumLibrary._enum_builder_complete == true
            and type(enumLibrary.ToEnum) == 'function' then
            tokenOk, token = pcall(enumLibrary.ToEnum, enumLibrary, 'Status')
        end
        local remotes = ReplicatedStorage:FindFirstChild('Remotes')
        local replication = remotes and remotes:FindFirstChild('Replication')
        local fighter = replication and replication:FindFirstChild('Fighter')
        local replicate = fighter and fighter:FindFirstChild('Replicate')
        if generation == recorder.RoundBindingGeneration and tokenOk and type(token) == 'string'
            and replicate and replicate:IsA('RemoteEvent') then
            recorder.RoundToken = token
            Connections:disconnect({'MovementRecorder_RoundReplicate'})
            Connections:register('MovementRecorder_RoundReplicate', replicate.OnClientEvent:Connect(
                GuardRivalsCallback('MovementRecorder_RoundReplicate', recorder.HandleReplicate)))
        end
        recorder.RoundBindingPending = false
    end))
end

function RivalsRuntimeBridge.MovementRecorder.Update(deltaTime)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.LoadPersistence()
    if not recorder.ReadToggle('P10S4T1') then
        return
    end
    local context = recorder.ResolveMapContext()
    local activeCharacter = recorder.Recording and recorder.Recording.Character
        or recorder.Replay and recorder.Replay.Character or nil
    if activeCharacter and (not context or context.Character ~= activeCharacter) then
        recorder.StopRecording(false, false)
        recorder.StopReplay('Stopped', false)
        recorder.SetToggle('P10S4T4', false)
        recorder.SetToggle('P10S4T5', false)
        return
    end
    if recorder.PendingKind and recorder.IsRoundActive() then
        local kind = recorder.PendingKind
        recorder.PendingKind = nil
        local started = kind == 'Record' and recorder.StartRecording()
            or recorder.StartReplay(recorder.SelectedRecording)
        if not started then
            recorder.SetToggle(kind == 'Record' and 'P10S4T4' or 'P10S4T5', false)
        end
    end
    if recorder.Mode == 'Recording' then
        recorder.SampleRecording()
    elseif recorder.Mode == 'Aligning' then
        recorder.StepAlign(math.clamp(tonumber(deltaTime) or 0, 0, 0.1))
    elseif recorder.Mode == 'Playing' then
        recorder.StepPlaying(math.clamp(tonumber(deltaTime) or 0, 0, 0.1))
    end
end

function RivalsRuntimeBridge.MovementRecorder.UpdateRender(deltaTime)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if not recorder.ReadToggle('P10S4T1') then
        return
    end
    recorder.UpdateReplayCamera(math.clamp(tonumber(deltaTime) or 0, 0, 0.1))
    recorder.UpdateWaypoints()
end

function RivalsRuntimeBridge.MovementRecorder.IsCameraClaimed()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    return recorder.Replay ~= nil
        and (recorder.Mode == 'Aligning' or recorder.Mode == 'Playing')
end

function RivalsRuntimeBridge.MovementRecorder.Destroy()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.RoundBindingGeneration = recorder.RoundBindingGeneration + 1
    recorder.RoundBindingPending = false
    if Connections then
        Connections:disconnect({'MovementRecorder_RoundReplicate'})
    end
    recorder.PendingKind = nil
    recorder.StopRecording(false, false)
    recorder.StopReplay('Stopped', false)
    recorder.DisconnectRecordingInputs()
    recorder.DestroyWaypoints()
    recorder.RoundActive = nil
    recorder.RoundToken = nil
    recorder.PlayerControls = nil
    recorder.InputLibrary = nil
    recorder.MechanicsController = nil
    recorder.Mode = 'Idle'
end


