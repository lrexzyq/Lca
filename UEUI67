local RivalsModsState = {
    OriginalItemInfo = setmetatable({}, {__mode = 'k'}),
    InfoModifierFighter = nil,
    InfoModifierItemAdded = nil,
    InfoModifierItemRemoved = nil,
}
function RivalsModsState.StoreOriginalItemInfo(item)
    if type(item) ~= 'table' or self.OriginalItemInfo[item] ~= nil then
        return
    end
    local info = rawget(item, 'Info')
    if type(info) ~= 'table' then
        return
    end
    self.OriginalItemInfo[item] = {
        Info = info,
        HasMaxDoubleJumps = rawget(info, 'MaxDoubleJumps') ~= nil,
        MaxDoubleJumps = rawget(info, 'MaxDoubleJumps'),
    }
end
function RivalsModsState.ApplyPersistentItemModifiers(item)
    self:StoreOriginalItemInfo(item)
    local original = self.OriginalItemInfo[item]
    local info = original and original.Info
    if type(info) ~= 'table' then
        return
    end
    if Toggles and Toggles.P4S2T5 and Toggles.P4S2T5.Value == true then
        rawset(info, 'MaxDoubleJumps', 676767)
    elseif original.HasMaxDoubleJumps then
        rawset(info, 'MaxDoubleJumps', original.MaxDoubleJumps)
    else
        rawset(info, 'MaxDoubleJumps', nil)
    end
end
function RivalsModsState.RestorePersistentItem(item)
    local original = self.OriginalItemInfo[item]
    local info = original and original.Info
    if type(info) ~= 'table' then
        self.OriginalItemInfo[item] = nil
        return
    end
    if original.HasMaxDoubleJumps then
        rawset(info, 'MaxDoubleJumps', original.MaxDoubleJumps)
    else
        rawset(info, 'MaxDoubleJumps', nil)
    end
    self.OriginalItemInfo[item] = nil
end
function RivalsModsState.RestorePersistentItemModifiers(disconnectSignals)
    if disconnectSignals then
        if self.InfoModifierItemAdded then pcall(self.InfoModifierItemAdded.Disconnect, self.InfoModifierItemAdded) end
        if self.InfoModifierItemRemoved then pcall(self.InfoModifierItemRemoved.Disconnect, self.InfoModifierItemRemoved) end
        self.InfoModifierItemAdded = nil
        self.InfoModifierItemRemoved = nil
    end
    local items = {}
    for item in pairs(self.OriginalItemInfo) do
        items[#items + 1] = item
    end
    for _, item in ipairs(items) do
        self:RestorePersistentItem(item)
    end
end
function RivalsModsState.RefreshPersistentItemModifiers()
    local fighter = ResolveLocalFighter()
    if fighter ~= self.InfoModifierFighter then
        self:RestorePersistentItemModifiers(true)
        self.InfoModifierFighter = fighter
        if fighter then
            if fighter.ItemAdded and type(fighter.ItemAdded.Connect) == 'function' then
                self.InfoModifierItemAdded = fighter.ItemAdded:Connect(GuardRivalsCallback('Mods_ItemAdded', function(item)
                    self:ApplyPersistentItemModifiers(item)
                end))
            end
            if fighter.ItemRemoved and type(fighter.ItemRemoved.Connect) == 'function' then
                self.InfoModifierItemRemoved = fighter.ItemRemoved:Connect(GuardRivalsCallback('Mods_ItemRemoved', function(item)
                    self:RestorePersistentItem(item)
                end))
            end
        end
    end
    if not fighter or type(fighter.Items) ~= 'table' then
        return false
    end
    for _, item in pairs(fighter.Items) do
        self:ApplyPersistentItemModifiers(item)
    end
    return true
end
function RivalsModsState.EnsureHooks()
    local enabled = Toggles and Toggles.P4S2T5 and Toggles.P4S2T5.Value == true
    if enabled then
        return self:RefreshPersistentItemModifiers()
    end
    self:RestorePersistentItemModifiers(false)
    self.InfoModifierFighter = nil
    return true
end

