local function UEUI_FinalCleanup()
    if UEUI_FinalCleanup._done then return end
    UEUI_FinalCleanup._done = true
    pcall(function() Aimbot:Destroy() end)
    pcall(function() if _FPSConnection then _FPSConnection:Disconnect(); _FPSConnection = nil end end)
    pcall(function() setRunService("Disabled") end)
    pcall(function() stopUnderground() end)
    pcall(function() stopslingTP() end)
    pcall(function() sling.enabled = false end)
    pcall(function() vfrSnap.cf = nil; vfrSnap.lv = nil; vfrSnap.av = nil end)
    pcall(function() if _silentInputConnection then _silentInputConnection:Disconnect(); _silentInputConnection = nil end end)
    pcall(function() if _silentInputEndConnection then _silentInputEndConnection:Disconnect(); _silentInputEndConnection = nil end end)
    pcall(function() if _silentHeartbeatConnection then _silentHeartbeatConnection:Disconnect(); _silentHeartbeatConnection = nil end end)
    pcall(function() if immuneConnection then immuneConnection:Disconnect(); immuneConnection = nil end end)
    pcall(function()
        for key in pairs(immuneList) do immuneList[key] = nil end
        for i = #onImmune, 1, -1 do onImmune[i] = nil end
        for i = #onVulnerable, 1, -1 do onVulnerable[i] = nil end
    end)
    pcall(function() if _kiciaRageHeartbeat then _kiciaRageHeartbeat:Disconnect(); _kiciaRageHeartbeat = nil end end)
    pcall(function() if RageRespawnSignalConnection then RageRespawnSignalConnection:Disconnect(); RageRespawnSignalConnection = nil end end)
    pcall(function() if Ragebot and Ragebot.Reset then Ragebot.Reset() end end)
    pcall(function() if Ragebot and Ragebot.Destroy then Ragebot.Destroy() end end)
    pcall(function() if Connections then Connections:disconnect({'Movement_PreSimulation','MovementRecorder_PreSimulation','Movement_BlankFlight','AnimationPlayer_Render','MovementRecorder_Render','MovementRecorder_RoundReplicate'}) end end)
    pcall(function() RivalsRuntimeBridge.MovementRecorder:Destroy() end)
    pcall(function() RivalsRuntimeBridge.AnimationPlayer:Destroy() end)
    pcall(function() RivalsRuntimeBridge.Movement:Destroy() end)
    pcall(function() runsvc:UnbindFromRenderStep("vfr_csync") end)
    pcall(function() if CombatExploits then CombatExploits:Destroy() end end)
    pcall(function() ModSettings.NoSpread = false; restoreWeaponOriginals("NoSpread") end)
    pcall(function() ModSettings.NoSmoke = false; restoreWeaponOriginals("NoSmoke") end)
    pcall(function() ModSettings.NoRecoil = false; restoreWeaponOriginals("NoRecoil") end)
    pcall(function() ModSettings.NoFlash = false; restoreWeaponOriginals("NoFlash") end)
    pcall(function() ModSettings.NoShootAnimation = false; restoreWeaponOriginals("NoShootAnimation") end)
    pcall(function() ModSettings.NoEquipAnimation = false; restoreWeaponOriginals("NoEquipAnimation") end)
    pcall(function() ModSettings.InstantADS = false; restoreWeaponOriginals("InstantADS") end)
    pcall(function() ModSettings.RapidFire = false; restoreWeaponOriginals("RapidFire") end)
    pcall(function() ModSettings.NoMeleeAnimation = false; restoreWeaponOriginals("NoMeleeAnimation") end)
    pcall(function() ModSettings.NoDashCooldown = false; restoreWeaponOriginals("NoDashCooldown") end)
    pcall(function() ModSettings.NoMeleeCooldown = false; restoreWeaponOriginals("NoMeleeCooldown") end)
    pcall(function() ModSettings.DeviceSpoof = false; restoreWeaponOriginals("DeviceSpoof") end)
    pcall(function() _desyncEnabled = false end)
    pcall(function()
        indicator.Visible = false
        indicatoroutline.Visible = false
        tracerline.Visible = false
        traceroutline.Visible = false
    end)
    pcall(function()
        if indicator then indicator:Remove() end
        if indicatoroutline then indicatoroutline:Remove() end
        if tracerline then tracerline:Remove() end
        if traceroutline then traceroutline:Remove() end
    end)
end

Library:OnUnload(UEUI_FinalCleanup)
