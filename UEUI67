local function silentTargetVisible(origin, targetPart, targetCharacter)
    if not silentAim.requireVisible then return true end
    if not origin or not targetPart then return false end
    local direction = targetPart.Position - origin
    if direction.Magnitude <= 0 then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {lp.Character, targetCharacter}
    local hit = Workspace:Raycast(origin, direction, params)
    return hit == nil or hit.Instance:IsDescendantOf(targetCharacter)
end

