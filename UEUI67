function RivalsRuntimeBridge.MovementRecorder.SetToggle(optionId, value)
    local toggle = Toggles and Toggles[optionId]
    if not toggle or toggle.Value == value or type(toggle.SetValue) ~= 'function' then
        return
    end
    task.defer(function()
        if Toggles and Toggles[optionId] == toggle and toggle.Value ~= value then
            toggle:SetValue(value)
        end
    end)
end

function RivalsRuntimeBridge.MovementRecorder.EncodeVector3(value)
    return {value.X, value.Y, value.Z}
end

function RivalsRuntimeBridge.MovementRecorder.DecodeVector3(value)
    if type(value) ~= 'table' then
        return nil
    end
    local x, y, z = tonumber(value[1]), tonumber(value[2]), tonumber(value[3])
    if not x or not y or not z then
        return nil
    end
    return Vector3.new(x, y, z)
end

function RivalsRuntimeBridge.MovementRecorder.EncodeCFrame(value)
    return {value:GetComponents()}
end

function RivalsRuntimeBridge.MovementRecorder.DecodeCFrame(value)
    if type(value) ~= 'table' or #value ~= 12 then
        return nil
    end
    local components = table.create(12)
    for index = 1, 12 do
        components[index] = tonumber(value[index])
        if components[index] == nil then
            return nil
        end
    end
    return CFrame.new(table.unpack(components))
end

function RivalsRuntimeBridge.MovementRecorder.EncodeAction(action)
    local encoded = {kind = action.kind}
    if action.kind == 'Move' then
        encoded.direction = RivalsRuntimeBridge.MovementRecorder.EncodeVector3(action.direction)
    elseif action.kind == 'Look' then
        encoded.cframe = RivalsRuntimeBridge.MovementRecorder.EncodeCFrame(action.cframe)
    elseif action.kind == 'Equip' then
        encoded.index = action.index
    elseif action.kind == 'ItemInput' then
        encoded.inputType = action.inputType
    elseif action.kind == 'QuickAttack' then
        encoded.attackType = action.attackType
    elseif action.kind == 'Crouch' then
        encoded.crouching = action.crouching == true
    end
    return encoded
end

function RivalsRuntimeBridge.MovementRecorder.DecodeAction(action)
    if type(action) ~= 'table' or type(action.kind) ~= 'string' then
        return nil
    end
    local decoded = {kind = action.kind}
    if action.kind == 'Move' then
        decoded.direction = RivalsRuntimeBridge.MovementRecorder.DecodeVector3(action.direction)
        return decoded.direction and decoded or nil
    elseif action.kind == 'Look' then
        decoded.cframe = RivalsRuntimeBridge.MovementRecorder.DecodeCFrame(action.cframe)
        return decoded.cframe and decoded or nil
    elseif action.kind == 'Equip' then
        decoded.index = tonumber(action.index)
        return decoded.index and decoded or nil
    elseif action.kind == 'ItemInput' then
        decoded.inputType = type(action.inputType) == 'string' and action.inputType or nil
        return decoded.inputType and decoded or nil
    elseif action.kind == 'QuickAttack' then
        decoded.attackType = type(action.attackType) == 'string' and action.attackType or nil
        return decoded.attackType and decoded or nil
    elseif action.kind == 'Crouch' then
        decoded.crouching = action.crouching == true
    elseif action.kind ~= 'Jump' and action.kind ~= 'Slide' then
        return nil
    end
    return decoded
end

function RivalsRuntimeBridge.MovementRecorder.EncodeRecording(recording)
    local encoded = {
        mapName = recording.mapName,
        startCFrame = RivalsRuntimeBridge.MovementRecorder.EncodeCFrame(recording.startCFrame),
        displayPosition = RivalsRuntimeBridge.MovementRecorder.EncodeVector3(recording.displayPosition),
        startEquippedIndex = recording.startEquippedIndex,
        startEquipCooldown = recording.startEquipCooldown,
        loadoutRequirements = {},
        keypoints = {},
        positions = {},
    }
    for itemName in pairs(recording.loadoutRequirements or {}) do
        encoded.loadoutRequirements[#encoded.loadoutRequirements + 1] = itemName
    end
    table.sort(encoded.loadoutRequirements)
    for _, keypoint in ipairs(recording.keypoints or {}) do
        encoded.keypoints[#encoded.keypoints + 1] = {
            offset = keypoint.offset,
            action = RivalsRuntimeBridge.MovementRecorder.EncodeAction(keypoint.action),
        }
    end
    for _, position in ipairs(recording.positions or {}) do
        encoded.positions[#encoded.positions + 1] = {
            offset = position.offset,
            position = RivalsRuntimeBridge.MovementRecorder.EncodeVector3(position.position),
        }
    end
    return encoded
end

function RivalsRuntimeBridge.MovementRecorder.DecodeRecording(encoded)
    if type(encoded) ~= 'table' or type(encoded.mapName) ~= 'string' then
        return nil
    end
    local recording = {
        mapName = encoded.mapName,
        startCFrame = RivalsRuntimeBridge.MovementRecorder.DecodeCFrame(encoded.startCFrame),
        displayPosition = RivalsRuntimeBridge.MovementRecorder.DecodeVector3(encoded.displayPosition),
        startEquippedIndex = tonumber(encoded.startEquippedIndex),
        startEquipCooldown = tonumber(encoded.startEquipCooldown),
        loadoutRequirements = {},
        keypoints = {},
        positions = {},
    }
    if not recording.startCFrame or not recording.displayPosition then
        return nil
    end
    for _, itemName in ipairs(type(encoded.loadoutRequirements) == 'table'
        and encoded.loadoutRequirements or {}) do
        if type(itemName) == 'string' and itemName ~= '' then
            recording.loadoutRequirements[itemName] = true
        end
    end
    for _, keypoint in ipairs(type(encoded.keypoints) == 'table' and encoded.keypoints or {}) do
        local action = RivalsRuntimeBridge.MovementRecorder.DecodeAction(keypoint.action)
        local offset = tonumber(keypoint.offset)
        if action and offset then
            recording.keypoints[#recording.keypoints + 1] = {offset = offset, action = action}
        end
    end
    for _, position in ipairs(type(encoded.positions) == 'table' and encoded.positions or {}) do
        local value = RivalsRuntimeBridge.MovementRecorder.DecodeVector3(position.position)
        local offset = tonumber(position.offset)
        if value and offset then
            recording.positions[#recording.positions + 1] = {offset = offset, position = value}
        end
    end
    if #recording.keypoints == 0 then
        return nil
    end
    table.sort(recording.keypoints, function(left, right) return left.offset < right.offset end)
    table.sort(recording.positions, function(left, right) return left.offset < right.offset end)
    return recording
end

function RivalsRuntimeBridge.MovementRecorder.ReindexRecordings()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.RecordsByMap = {}
    for name, recording in pairs(recorder.RecordsByName) do
        recording.name = name
        local names = recorder.RecordsByMap[recording.mapName]
        if not names then
            names = {}
            recorder.RecordsByMap[recording.mapName] = names
        end
        names[#names + 1] = name
    end
    for _, names in pairs(recorder.RecordsByMap) do
        table.sort(names)
    end
    recorder.WaypointDirty = true
end

function RivalsRuntimeBridge.MovementRecorder.LoadPersistence()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if recorder.PersistenceLoaded then
        return
    end
    recorder.PersistenceLoaded = true
    recorder.RecordsByName = {}
    if type(isfile) == 'function' and isfile(recorder.SavePath) then
        local ok, decoded = pcall(function()
            return game:GetService('HttpService'):JSONDecode(readfile(recorder.SavePath))
        end)
        if ok and type(decoded) == 'table' and decoded.version == recorder.Version
            and type(decoded.recordings) == 'table' then
            for name, encoded in pairs(decoded.recordings) do
                local recording = type(name) == 'string' and recorder.DecodeRecording(encoded) or nil
                if recording then
                    recorder.RecordsByName[name] = recording
                end
            end
        end
    end
    recorder.ReindexRecordings()
end

function RivalsRuntimeBridge.MovementRecorder.WritePersistence()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if type(writefile) ~= 'function' then
        return false
    end
    local encoded = {}
    for name, recording in pairs(recorder.RecordsByName) do
        encoded[name] = recorder.EncodeRecording(recording)
    end
    local ok = pcall(function()
        if type(makefolder) == 'function' and type(isfolder) == 'function'
            and not isfolder('KiciaHook') then
            makefolder('KiciaHook')
        end
        writefile(recorder.SavePath, game:GetService('HttpService'):JSONEncode({
            version = recorder.Version,
            recordings = encoded,
        }))
    end)
    return ok
end

function RivalsRuntimeBridge.MovementRecorder.GetMapNames()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.LoadPersistence()
    local maps = {}
    for mapName in pairs(recorder.RecordsByMap) do
        maps[#maps + 1] = mapName
    end
    table.sort(maps)
    return maps
end

function RivalsRuntimeBridge.MovementRecorder.GetRecordingNames(mapName)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.LoadPersistence()
    return table.clone(recorder.RecordsByMap[mapName] or {})
end

function RivalsRuntimeBridge.MovementRecorder.RefreshRecordingOptions()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if recorder.RefreshingOptions then
        return
    end
    local mapOption = Options and Options.P10S4D1
    local recordingOption = Options and Options.P10S4D2
    if not mapOption or not recordingOption then
        return
    end
    recorder.RefreshingOptions = true
    local maps = recorder.GetMapNames()
    local currentMap = mapOption.Value
    if type(mapOption.SetValues) == 'function' then
        mapOption:SetValues(maps)
    end
    if type(currentMap) ~= 'string' or table.find(maps, currentMap) == nil then
        currentMap = maps[1]
        if type(mapOption.SetValue) == 'function' then
            mapOption:SetValue(currentMap)
        end
    end
    local names = recorder.GetRecordingNames(currentMap)
    local selectedName = recordingOption.Value
    if type(recordingOption.SetValues) == 'function' then
        recordingOption:SetValues(names)
    end
    if type(selectedName) ~= 'string' or table.find(names, selectedName) == nil then
        if type(recordingOption.SetValue) == 'function' then
            recordingOption:SetValue(names[1])
        end
    end
    recorder.RefreshingOptions = false
end

function RivalsRuntimeBridge.MovementRecorder.SaveLastRecording(name)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.LoadPersistence()
    name = type(name) == 'string' and name:match('^%s*(.-)%s*$') or ''
    if name == '' then
        recorder.Notify('Enter a recording name first')
        return false
    end
    if not recorder.LastRecording then
        recorder.Notify('No recording to save')
        return false
    end
    local previous = recorder.RecordsByName[name]
    recorder.RecordsByName[name] = recorder.LastRecording
    recorder.ReindexRecordings()
    if not recorder.WritePersistence() then
        recorder.RecordsByName[name] = previous
        recorder.ReindexRecordings()
        recorder.Notify('Failed to save recording')
        return false
    end
    recorder.LastRecording = nil
    recorder.RefreshRecordingOptions()
    recorder.Notify('Recording saved')
    return true
end

function RivalsRuntimeBridge.MovementRecorder.DeleteRecording(name)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.LoadPersistence()
    if type(name) ~= 'string' or name == '' or not recorder.RecordsByName[name] then
        recorder.Notify('Select a recording to delete')
        return false
    end
    local previous = recorder.RecordsByName[name]
    recorder.RecordsByName[name] = nil
    recorder.ReindexRecordings()
    if not recorder.WritePersistence() then
        recorder.RecordsByName[name] = previous
        recorder.ReindexRecordings()
        recorder.Notify('Failed to delete recording')
        return false
    end
    recorder.RefreshRecordingOptions()
    recorder.Notify('Recording deleted')
    return true
end

function RivalsRuntimeBridge.MovementRecorder.ResolveMapContext()
    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass('Humanoid') or nil
    local rootPart = character and character:FindFirstChild('HumanoidRootPart') or nil
    if not character or not humanoid or humanoid.Health <= 0 or not rootPart then
        return nil
    end
    local environmentId = character:GetAttribute('EnvironmentID')
    if environmentId == nil then
        local fighter = ResolveLocalFighter()
        local data = type(fighter) == 'table' and rawget(fighter, 'Data') or nil
        environmentId = type(data) == 'table' and rawget(data, 'EnvironmentID') or nil
    end
    if environmentId == nil then
        return nil
    end
    local tagged = game:GetService('CollectionService'):GetTagged('RaycastWhitelist' .. tostring(environmentId))
    local mapModel = tagged[1]
    while mapModel and mapModel ~= Workspace
        and not (mapModel:IsA('Model') or mapModel:GetAttribute('EnvironmentID') == environmentId) do
        mapModel = mapModel.Parent
    end
    if not mapModel or mapModel == Workspace or not mapModel:IsA('PVInstance') then
        return nil
    end
    local mapName
    local playerScripts = LP:FindFirstChild('PlayerScripts')
    local controllers = playerScripts and playerScripts:FindFirstChild('Controllers')
    local duelModule = controllers and controllers:FindFirstChild('DuelController')
    if duelModule and IsReplicatedStateReady() then
        local ok, duelController = pcall(require, duelModule)
        local duel = ok and type(duelController) == 'table' and duelController.CurrentObject or nil
        if duel and type(duel.GetMapName) == 'function' then
            local mapOk, value = pcall(duel.GetMapName, duel)
            mapName = mapOk and type(value) == 'string' and value ~= '' and value or nil
        end
        if not mapName and duel and type(duel.Get) == 'function' then
            for _, key in ipairs({'MapName', 'Map'}) do
                local mapOk, value = pcall(duel.Get, duel, key)
                if mapOk and type(value) == 'string' and value ~= '' then
                    mapName = value
                    break
                end
            end
        end
    end
    if not mapName then
        for _, attributeName in ipairs({'MapName', 'MatchMap'}) do
            local value = Workspace:GetAttribute(attributeName)
            if type(value) == 'string' and value ~= '' then
                mapName = value
                break
            end
        end
    end
    mapName = mapName or mapModel.Name
    return {
        Character = character,
        Humanoid = humanoid,
        RootPart = rootPart,
        MapModel = mapModel,
        MapAnchor = mapModel:GetPivot(),
        MapName = mapName,
        EnvironmentId = environmentId,
    }
end

function RivalsRuntimeBridge.MovementRecorder.IsRoundActive()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local fighter = ResolveLocalFighter()
    local data = type(fighter) == 'table' and rawget(fighter, 'Data') or nil
    if type(data) == 'table' and rawget(data, 'IsInShootingRange') == true then
        return true
    end
    if recorder.RoundActive ~= nil then
        return recorder.RoundActive == true
    end
    return FighterDataCache.LocalDuel.IsInDuel == true
end

function RivalsRuntimeBridge.MovementRecorder.ResolveDependencies()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if not recorder.PlayerControls then
        local playerModule = LP:FindFirstChild('PlayerScripts')
            and LP.PlayerScripts:FindFirstChild('PlayerModule')
        if playerModule then
            local ok, module = pcall(require, playerModule)
            if ok and type(module) == 'table' and type(module.GetControls) == 'function' then
                local controlsOk, controls = pcall(module.GetControls, module)
                recorder.PlayerControls = controlsOk and controls or nil
            end
        end
    end
    if not recorder.InputLibrary then
        local modules = ReplicatedStorage:FindFirstChild('Modules')
        local inputModule = modules and modules:FindFirstChild('InputLibrary')
        if inputModule then
            local ok, library = pcall(require, inputModule)
            recorder.InputLibrary = ok and type(library) == 'table' and library or nil
        end
    end
    if not recorder.MechanicsController and IsReplicatedStateReady() then
        local playerScripts = LP:FindFirstChild('PlayerScripts')
        local controllers = playerScripts and playerScripts:FindFirstChild('Controllers')
        local mechanicsModule = controllers and controllers:FindFirstChild('MechanicsController')
        if mechanicsModule then
            local ok, controller = pcall(require, mechanicsModule)
            recorder.MechanicsController = ok and type(controller) == 'table' and controller or nil
        end
    end
    return recorder.PlayerControls ~= nil and recorder.InputLibrary ~= nil
end

function RivalsRuntimeBridge.MovementRecorder.ResolveEquippedItem(fighter)
    if type(fighter) ~= 'table' then
        return nil
    end
    return rawget(fighter, 'EquippedItem')
end

function RivalsRuntimeBridge.MovementRecorder.ResolveItemIndex(item, fighter)
    local data = type(item) == 'table' and rawget(item, 'Data') or nil
    local index = type(data) == 'table' and tonumber(rawget(data, 'ItemIndex')) or nil
    if index then
        return index
    end
    for slotIndex, candidate in ipairs(type(fighter) == 'table' and rawget(fighter, 'Items') or {}) do
        if candidate == item then
            return slotIndex
        end
    end
    return nil
end

function RivalsRuntimeBridge.MovementRecorder.ResolveItemName(item)
    if type(item) ~= 'table' then
        return nil
    end
    local name = rawget(item, 'Name')
    if type(name) == 'string' and name ~= '' then
        return name
    end
    local data = rawget(item, 'Data')
    name = type(data) == 'table' and rawget(data, 'Name') or nil
    return type(name) == 'string' and name ~= '' and name or nil
end

function RivalsRuntimeBridge.MovementRecorder.GetOffset()
    local active = RivalsRuntimeBridge.MovementRecorder.Recording
    return active and math.max(0, os.clock() - active.StartTime) or 0
end

function RivalsRuntimeBridge.MovementRecorder.RecordAction(action)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local active = recorder.Recording
    if not active then
        return
    end
    active.Data.keypoints[#active.Data.keypoints + 1] = {
        offset = recorder.GetOffset(),
        action = action,
    }
end

function RivalsRuntimeBridge.MovementRecorder.DiscardUnusedStartItem()
    local active = RivalsRuntimeBridge.MovementRecorder.Recording
    if not active or active.StartItemUsed or active.Data.startEquippedIndex == nil then
        return
    end
    active.Data.startEquippedIndex = nil
    active.Data.startEquipCooldown = nil
end

function RivalsRuntimeBridge.MovementRecorder.RecordItemInput(inputType)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local active = recorder.Recording
    if not active then
        return
    end
    local fighter = ResolveLocalFighter()
    local item = recorder.ResolveEquippedItem(fighter)
    local itemName = recorder.ResolveItemName(item)
    if itemName then
        active.Data.loadoutRequirements[itemName] = true
    end
    if recorder.ResolveItemIndex(item, fighter) == active.StartItemIndex then
        active.StartItemUsed = true
    end
    recorder.RecordAction({kind = 'ItemInput', inputType = inputType})
end

function RivalsRuntimeBridge.MovementRecorder.InputMatches(input, inputName)
    local library = RivalsRuntimeBridge.MovementRecorder.InputLibrary
    if not library or type(library.InputIs) ~= 'function' then
        return false
    end
    local ok, matches = pcall(library.InputIs, library, input, inputName)
    return ok and matches == true
end

function RivalsRuntimeBridge.MovementRecorder.HandleInput(input, gameProcessed, began)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if recorder.Mode ~= 'Recording' or gameProcessed then
        return
    end
    if began and recorder.InputMatches(input, 'Jump') then
        recorder.RecordAction({kind = 'Jump'})
        return
    end
    if began and recorder.InputMatches(input, 'QuickMelee') then
        recorder.RecordAction({kind = 'QuickAttack', attackType = 'Melee'})
        return
    end
    if began and recorder.InputMatches(input, 'QuickUtility') then
        recorder.RecordAction({kind = 'QuickAttack', attackType = 'Utility'})
        return
    end
    local library = recorder.InputLibrary
    for _, inputName in ipairs(type(library) == 'table' and library.ItemInputs or {}) do
        local definition = type(library.Inputs) == 'table' and library.Inputs[inputName] or nil
        if definition and recorder.InputMatches(input, inputName) then
            local inputType = began and definition.StartName or definition.FinishName
            if type(inputType) == 'string' then
                recorder.RecordItemInput(inputType)
            end
            return
        end
    end
end

function RivalsRuntimeBridge.MovementRecorder.DisconnectRecordingInputs()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    for _, connection in ipairs(recorder.InputConnections) do
        connection:Disconnect()
    end
    recorder.InputConnections = {}
end

function RivalsRuntimeBridge.MovementRecorder.ConnectRecordingInputs()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    recorder.DisconnectRecordingInputs()
    recorder.InputConnections = {
        UserInputService.InputBegan:Connect(GuardRivalsCallback(
            'MovementRecorder_InputBegan', function(input, gameProcessed)
                recorder.HandleInput(input, gameProcessed, true)
            end)),
        UserInputService.InputEnded:Connect(GuardRivalsCallback(
            'MovementRecorder_InputEnded', function(input, gameProcessed)
                recorder.HandleInput(input, gameProcessed, false)
            end)),
    }
end

function RivalsRuntimeBridge.MovementRecorder.SampleRecording()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local active = recorder.Recording
    if not active then
        return
    end
    local controls = recorder.PlayerControls
    local moveVector = Vector3.zero
    if controls and type(controls.GetMoveVector) == 'function' then
        local ok, value = pcall(controls.GetMoveVector, controls)
        if ok and typeof(value) == 'Vector3' then
            moveVector = value
        end
    end
    if moveVector ~= active.LastMoveVector then
        active.LastMoveVector = moveVector
        recorder.RecordAction({kind = 'Move', direction = moveVector})
    end

    local camera = Workspace.CurrentCamera
    if camera then
        local pitch, yaw = camera.CFrame:ToOrientation()
        local cameraRotation = Vector2.new(pitch, yaw)
        if (cameraRotation - active.LastCameraRotation).Magnitude > 0.0001 then
            active.LastCameraRotation = cameraRotation
            recorder.RecordAction({
                kind = 'Look',
                cframe = active.AnchorInverse * CFrame.fromOrientation(pitch, yaw, 0),
            })
        end
    end

    local fighter = ResolveLocalFighter()
    local item = recorder.ResolveEquippedItem(fighter)
    local equippedIndex = recorder.ResolveItemIndex(item, fighter)
    if equippedIndex ~= active.LastEquippedIndex then
        active.LastEquippedIndex = equippedIndex
        recorder.DiscardUnusedStartItem()
        if equippedIndex ~= nil then
            recorder.RecordAction({kind = 'Equip', index = equippedIndex})
        end
    end

    local mechanics = recorder.MechanicsController
    local crouching = mechanics and rawget(mechanics, 'IsCrouching') == true or false
    if crouching ~= active.LastCrouching then
        active.LastCrouching = crouching
        recorder.RecordAction({kind = 'Crouch', crouching = crouching})
    end
    local sliding = mechanics and rawget(mechanics, 'IsSliding') == true or false
    if sliding ~= active.LastSliding then
        active.LastSliding = sliding
        if sliding then
            recorder.RecordAction({kind = 'Slide'})
        end
    end

    local now = os.clock()
    if now - active.LastPositionSampleTime >= 0.1 then
        active.LastPositionSampleTime = now
        active.Data.positions[#active.Data.positions + 1] = {
            offset = recorder.GetOffset(),
            position = active.AnchorInverse * active.RootPart.Position,
        }
    end
end

function RivalsRuntimeBridge.MovementRecorder.StartRecording()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local context = recorder.ResolveMapContext()
    if not context or not recorder.ResolveDependencies() then
        recorder.Notify('You need to be alive and in a match')
        return false
    end
    if recorder.Mode ~= 'Idle' then
        recorder.Notify(recorder.Mode == 'Recording' and 'Already recording' or "Can't record while replaying")
        return false
    end
    local fighter = ResolveLocalFighter()
    local item = recorder.ResolveEquippedItem(fighter)
    local equippedIndex = recorder.ResolveItemIndex(item, fighter)
    local equipCooldown = type(item) == 'table' and tonumber(rawget(item, '_equip_cooldown')) or nil
    if equipCooldown then
        equipCooldown = math.max(0, equipCooldown - tick())
    end
    local camera = Workspace.CurrentCamera
    local pitch, yaw = camera and camera.CFrame:ToOrientation() or 0, 0
    if camera then
        pitch, yaw = camera.CFrame:ToOrientation()
    end
    local anchorInverse = context.MapAnchor:Inverse()
    local displayPosition = context.RootPart.Position
    if camera then
        local center = camera.ViewportSize / 2
        local ray = camera:ViewportPointToRay(center.X, center.Y)
        displayPosition = ray.Origin + ray.Direction * 100
    end
    recorder.Recording = {
        Data = {
            mapName = context.MapName,
            displayPosition = anchorInverse * displayPosition,
            startCFrame = anchorInverse * context.RootPart.CFrame,
            startEquippedIndex = equippedIndex,
            startEquipCooldown = equipCooldown,
            keypoints = {{
                offset = 0,
                action = {
                    kind = 'Look',
                    cframe = anchorInverse * CFrame.fromOrientation(pitch, yaw, 0),
                },
            }},
            loadoutRequirements = {},
            positions = {},
        },
        AnchorInverse = anchorInverse,
        RootPart = context.RootPart,
        Character = context.Character,
        StartTime = os.clock(),
        StartItemIndex = equippedIndex,
        StartItemUsed = false,
        LastMoveVector = Vector3.zero,
        LastCameraRotation = Vector2.new(pitch, yaw),
        LastEquippedIndex = equippedIndex,
        LastCrouching = false,
        LastSliding = false,
        LastPositionSampleTime = 0,
    }
    recorder.Mode = 'Recording'
    recorder.ConnectRecordingInputs()
    recorder.SampleRecording()
    recorder.Notify('Now recording')
    return true
end

function RivalsRuntimeBridge.MovementRecorder.StopRecording(saveLast, notify)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    if recorder.Mode ~= 'Recording' or not recorder.Recording then
        return
    end
    recorder.SampleRecording()
    recorder.DiscardUnusedStartItem()
    if saveLast then
        recorder.LastRecording = recorder.Recording.Data
    end
    recorder.DisconnectRecordingInputs()
    recorder.Recording = nil
    recorder.Mode = 'Idle'
    if notify then
        recorder.Notify('Recording stopped')
    end
end

function RivalsRuntimeBridge.MovementRecorder.ResolveStartLook(mapAnchor, keypoints)
    for _, keypoint in ipairs(keypoints or {}) do
        local action = keypoint.action
        if action and action.kind == 'Look' then
            local pitch, yaw = (mapAnchor * action.cframe):ToOrientation()
            return Vector2.new(pitch, yaw)
        end
    end
    return nil
end

function RivalsRuntimeBridge.MovementRecorder.LoadoutFulfilled(recording)
    local owned = {}
    local fighter = ResolveLocalFighter()
    for _, item in ipairs(type(fighter) == 'table' and rawget(fighter, 'Items') or {}) do
        local itemName = RivalsRuntimeBridge.MovementRecorder.ResolveItemName(item)
        if itemName then
            owned[itemName] = true
        end
    end
    for itemName in pairs(recording.loadoutRequirements or {}) do
        if not owned[itemName] then
            return false
        end
    end
    return true
end

function RivalsRuntimeBridge.MovementRecorder.StartReplay(recording)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local context = recorder.ResolveMapContext()
    if not context or not recorder.ResolveDependencies() then
        recorder.Notify('You need to be alive and in a match')
        return false
    end
    if recorder.Mode ~= 'Idle' then
        recorder.Notify(recorder.Mode == 'Recording' and "Can't replay while recording" or 'Already replaying')
        return false
    end
    if not recording or recording.mapName ~= context.MapName then
        recorder.Notify('Stand near a recording marker first')
        return false
    end
    if not recorder.LoadoutFulfilled(recording) then
        recorder.Notify('Your loadout does not meet this recording')
        return false
    end
    local fighter = ResolveLocalFighter()
    if recording.startEquippedIndex ~= nil and fighter and type(fighter.EquipItem) == 'function' then
        task.spawn(function()
            pcall(fighter.EquipItem, fighter, recording.startEquippedIndex)
        end)
    end
    local controls = recorder.PlayerControls
    local activeController = type(controls) == 'table'
        and rawget(controls, 'activeController') or nil
    local controlsWereEnabled = type(activeController) ~= 'table' or rawget(activeController, 'enabled') ~= false
    if controls and type(controls.Disable) == 'function' then
        pcall(controls.Disable, controls)
    end
    recorder.Replay = {
        Data = recording,
        Character = context.Character,
        Humanoid = context.Humanoid,
        RootPart = context.RootPart,
        Fighter = fighter,
        MapAnchor = context.MapAnchor,
        State = 'Aligning',
        AlignElapsed = 0,
        StuckTime = 0,
        BestDistance = math.huge,
        LookAligned = false,
        StartLook = recorder.ResolveStartLook(context.MapAnchor, recording.keypoints),
        TargetLook = nil,
        MoveVector = Vector3.zero,
        Offset = 0,
        KeypointIndex = 1,
        PositionIndex = 1,
        Controls = controls,
        ControlsWereEnabled = controlsWereEnabled,
    }
    recorder.Mode = 'Aligning'
    recorder.ActivatedRecording = recording
    recorder.SelectedRecording = recording
    RivalsRuntimeBridge.ResetFlickbot()
    recorder.Notify('Now replaying')
    return true
end

function RivalsRuntimeBridge.MovementRecorder.StopReplay(reason, notify)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local replay = recorder.Replay
    if not replay then
        return
    end
    if replay.Humanoid and replay.Humanoid.Parent then
        pcall(replay.Humanoid.Move, replay.Humanoid, Vector3.zero, false)
    end
    if replay.ControlsWereEnabled and replay.Controls and type(replay.Controls.Enable) == 'function' then
        pcall(replay.Controls.Enable, replay.Controls)
    end
    local mechanics = recorder.MechanicsController
    if mechanics and type(mechanics.SetCrouching) == 'function' then
        pcall(mechanics.SetCrouching, mechanics, false)
    end
    recorder.Replay = nil
    recorder.Mode = 'Idle'
    recorder.ActivatedRecording = nil
    if notify then
        if reason == 'Diverged' then
            recorder.Notify('Replay stopped (off course)')
        elseif reason == 'Completed' then
            recorder.Notify('Finished replaying')
        else
            recorder.Notify('Stopped replaying')
        end
    end
end

function RivalsRuntimeBridge.MovementRecorder.IsStartItemReady()
    local replay = RivalsRuntimeBridge.MovementRecorder.Replay
    if not replay or replay.Data.startEquippedIndex == nil then
        return true
    end
    local fighter = replay.Fighter
    local item = RivalsRuntimeBridge.MovementRecorder.ResolveEquippedItem(fighter)
    if RivalsRuntimeBridge.MovementRecorder.ResolveItemIndex(item, fighter)
        ~= replay.Data.startEquippedIndex then
        return false
    end
    local cooldown = type(item) == 'table' and rawget(item, '_equip_cooldown') or nil
    return type(cooldown) ~= 'number' or cooldown <= tick()
end

function RivalsRuntimeBridge.MovementRecorder.StepAlign(deltaTime)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local replay = recorder.Replay
    if not replay then
        return
    end
    if not recorder.IsRoundActive() then
        replay.Humanoid:Move(Vector3.zero, false)
        return
    end
    replay.AlignElapsed = replay.AlignElapsed + deltaTime
    local targetPosition = (replay.MapAnchor * replay.Data.startCFrame).Position
    local difference = targetPosition - replay.RootPart.Position
    local planar = Vector3.new(difference.X, 0, difference.Z)
    local distance = planar.Magnitude
    local snapped = distance <= recorder.ReadNumber('P10S4S5', 0.2)
    if snapped then
        replay.Humanoid:Move(Vector3.zero, false)
    else
        replay.Humanoid:Move(planar.Unit, false)
    end
    if distance < replay.BestDistance - 0.1 then
        replay.BestDistance = distance
        replay.StuckTime = 0
    else
        replay.StuckTime = replay.StuckTime + deltaTime
    end
    local aligned = (snapped and (replay.StartLook == nil or replay.LookAligned))
        or replay.StuckTime >= 1
    if not aligned then
        return
    end
    replay.Humanoid:Move(Vector3.zero, false)
    if not recorder.IsStartItemReady() and replay.AlignElapsed < 3 then
        return
    end
    replay.State = 'Playing'
    recorder.Mode = 'Playing'
end

function RivalsRuntimeBridge.MovementRecorder.HasDiverged(offset)
    local replay = RivalsRuntimeBridge.MovementRecorder.Replay
    local positions = replay and replay.Data.positions or nil
    if not positions or #positions == 0 then
        return false
    end
    while replay.PositionIndex < #positions
        and positions[replay.PositionIndex + 1].offset <= offset do
        replay.PositionIndex = replay.PositionIndex + 1
    end
    local first = positions[replay.PositionIndex]
    local second = positions[replay.PositionIndex + 1]
    local expected = first.position
    if second then
        local span = second.offset - first.offset
        local alpha = span > 0 and math.clamp((offset - first.offset) / span, 0, 1) or 0
        expected = first.position:Lerp(second.position, alpha)
    end
    return (replay.MapAnchor:PointToWorldSpace(expected) - replay.RootPart.Position).Magnitude > 15
end

function RivalsRuntimeBridge.MovementRecorder.ApplyReplayAction(action)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local replay = recorder.Replay
    if not replay then
        return
    end
    if action.kind == 'Move' then
        replay.MoveVector = action.direction
    elseif action.kind == 'Look' then
        local pitch, yaw = (replay.MapAnchor * action.cframe):ToOrientation()
        replay.TargetLook = Vector2.new(pitch, yaw)
    elseif action.kind == 'Equip' and replay.Fighter and type(replay.Fighter.EquipItem) == 'function' then
        task.spawn(function() pcall(replay.Fighter.EquipItem, replay.Fighter, action.index) end)
    elseif action.kind == 'ItemInput' and replay.Fighter and type(replay.Fighter.Input) == 'function' then
        task.spawn(function() pcall(replay.Fighter.Input, replay.Fighter, action.inputType) end)
    elseif action.kind == 'QuickAttack' and replay.Fighter
        and type(replay.Fighter.QuickAttackDown) == 'function' then
        task.spawn(function()
            pcall(replay.Fighter.QuickAttackDown, replay.Fighter, action.attackType)
            task.wait(0.05)
            if replay.Fighter and type(replay.Fighter.QuickAttackUp) == 'function' then
                pcall(replay.Fighter.QuickAttackUp, replay.Fighter, action.attackType)
            end
        end)
    elseif action.kind == 'Jump' then
        local mechanics = recorder.MechanicsController
        if mechanics then
            if rawget(mechanics, 'IsSliding') == true and type(mechanics.HighJump) == 'function' then
                pcall(mechanics.HighJump, mechanics)
            else
                if type(mechanics.DoubleJumpRequest) == 'function' then
                    pcall(mechanics.DoubleJumpRequest, mechanics)
                end
                if type(mechanics.JumpRequest) == 'function' then
                    pcall(mechanics.JumpRequest, mechanics)
                end
            end
        end
    elseif action.kind == 'Crouch' then
        local mechanics = recorder.MechanicsController
        if mechanics and type(mechanics.SetCrouching) == 'function' then
            pcall(mechanics.SetCrouching, mechanics, action.crouching)
        end
    elseif action.kind == 'Slide' then
        local mechanics = recorder.MechanicsController
        if mechanics and type(mechanics.Slide) == 'function' then
            task.spawn(function() pcall(mechanics.Slide, mechanics) end)
        end
    end
end

function RivalsRuntimeBridge.MovementRecorder.StepPlaying(deltaTime)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local replay = recorder.Replay
    if not replay then
        return
    end
    replay.Offset = replay.Offset + deltaTime
    if recorder.HasDiverged(replay.Offset) then
        recorder.StopReplay('Diverged', true)
        recorder.SetToggle('P10S4T5', false)
        return
    end
    local keypoints = replay.Data.keypoints
    while replay.KeypointIndex <= #keypoints do
        local keypoint = keypoints[replay.KeypointIndex]
        if replay.Offset < keypoint.offset then
            break
        end
        recorder.ApplyReplayAction(keypoint.action)
        replay.KeypointIndex = replay.KeypointIndex + 1
    end
    replay.Humanoid:Move(replay.MoveVector, true)
    if replay.KeypointIndex > #keypoints then
        recorder.StopReplay('Completed', true)
        recorder.SetToggle('P10S4T5', false)
    end
end

function RivalsRuntimeBridge.MovementRecorder.WrapAngle(value)
    return (value + math.pi) % (2 * math.pi) - math.pi
end

function RivalsRuntimeBridge.MovementRecorder.SmoothingAlpha(deltaTime)
    local tau = RivalsRuntimeBridge.MovementRecorder.ReadNumber('P10S4S4', 35) / 100 * 0.3
    return tau <= 0 and 1 or 1 - math.exp(-deltaTime / tau)
end

function RivalsRuntimeBridge.MovementRecorder.ReadCameraRotation()
    local camera = Workspace.CurrentCamera
    if not camera then
        return nil
    end
    local pitch, yaw = camera.CFrame:ToOrientation()
    return Vector2.new(pitch, yaw)
end

function RivalsRuntimeBridge.MovementRecorder.WriteCameraRotation(rotation)
    local camera = Workspace.CurrentCamera
    if camera and rotation then
        camera.CFrame = CFrame.new(camera.CFrame.Position)
            * CFrame.fromOrientation(rotation.X, rotation.Y, 0)
    end
end

function RivalsRuntimeBridge.MovementRecorder.UpdateReplayCamera(deltaTime)
    local recorder = RivalsRuntimeBridge.MovementRecorder
    local replay = recorder.Replay
    local current = replay and recorder.ReadCameraRotation() or nil
    if not replay or not current then
        return
    end
    if replay.State == 'Aligning' and replay.StartLook then
        local difference = Vector2.new(
            replay.StartLook.X - current.X,
            recorder.WrapAngle(replay.StartLook.Y - current.Y)
        )
        local magnitude = difference.Magnitude
        if magnitude <= math.rad(0.1) then
            current = replay.StartLook
            replay.LookAligned = true
        else
            local step = math.min(
                magnitude * recorder.SmoothingAlpha(deltaTime),
                math.rad(recorder.ReadNumber('P10S4S3', 180)) * deltaTime
            )
            current = current + difference.Unit * step
            replay.LookAligned = false
        end
        recorder.WriteCameraRotation(current)
    elseif replay.State == 'Playing' and replay.TargetLook then
        local alpha = recorder.SmoothingAlpha(deltaTime)
        recorder.WriteCameraRotation(Vector2.new(
            current.X + (replay.TargetLook.X - current.X) * alpha,
            current.Y + recorder.WrapAngle(replay.TargetLook.Y - current.Y) * alpha
        ))
    end
end

function RivalsRuntimeBridge.MovementRecorder.DestroyWaypoints()
    local recorder = RivalsRuntimeBridge.MovementRecorder
    for _, marker in ipairs(recorder.Markers) do
        pcall(function() marker.Gui:Destroy() end)
        pcall(function() marker.Attachment:Destroy() end)
    end
    for _, route in ipairs(recorder.Routes) do
        pcall(function() route.Gui:Destroy() end)
        pcall(function() route.Attachment:Destroy() end)
    end
    recorder.Markers = {}
    recorder.Routes = {}
    recorder.SelectedRecording = nil
    recorder.WaypointMapName = nil
    recorder.WaypointMapModel = nil
    recorder.WaypointAnchor = nil
end

function RivalsRuntimeBridge.MovementRecorder.ResolveGuiParent()
    if type(gethui) == 'function' then
        local ok, parent = pcall(gethui)
        if ok and typeof(parent) == 'Instance' then
            return parent
        end
    end
    return game:GetService('CoreGui')
end

function RivalsRuntimeBridge.MovementRecorder.CreateWaypointGui(name, position, isRoute)
