local function isAimbotWeaponIgnored(item)
    if not item then return true end
    local name = item.Name
    if AIMBOT_HARD_BLOCK_ITEMS[name] then
        return true
    end
    local selection = Options.P2S1D4 and Options.P2S1D4.Value
    if type(selection) == "table" then
        if selection[name] == true then return true end
        for _, selectedName in ipairs(selection) do
            if selectedName == name then return true end
        end
    end
    local info = item.Info
    if info and type(item.StartShooting) == "function" then
        local hasTimedShotCooldown = type(info.ShootCooldown) == "number"
            or type(info.ShootBurstCooldown) == "number"
            or type(info.ShootBurst) == "number"
            or type(info.QuickShotCooldown) == "number"
            or type(info.ChargeReleaseCooldown) == "number"
            or type(info.BladeCooldown) == "number"
        local hasMeleeAttackCooldown = type(info.AttackCooldown) == "number"
            and (info.Class == "Melee" or info.Type == "Melee")
        if hasTimedShotCooldown or hasMeleeAttackCooldown then
            return false
        end
    end
    if name == "Daggers" or name == "Bow" or name == "Slingshot" then
        return false
    end
    if AIMBOT_HOLD_FIRE_ITEMS[name] then
        return false
    end
    return true
end

local function getSilentTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local pointer = getPointerPosition()
    local best, bestDistance = nil, math.huge
    local maxDistance = 100000
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position or cam.CFrame.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local root = character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and root then
                local teamMismatch = lp:GetAttribute("TeamID") == nil or player:GetAttribute("TeamID") ~= lp:GetAttribute("TeamID")
                if teamMismatch and not isSpawnShielded(player) and (not Toggles.P2S1T8 or Toggles.P2S1T8.Value ~= true or not isKatanaDeflectTarget(player)) and (not Toggles.P2S1T9 or Toggles.P2S1T9.Value ~= true or not isRiotShieldTarget(player)) then
                    local part = resolveSilentPart(character)
                    if part then
                        local worldDistance = (part.Position - myPos).Magnitude
                        if worldDistance <= maxDistance then
                            local screen, onScreen = cam:WorldToViewportPoint(part.Position)
                            local isOnScreen = onScreen and screen.Z > 0
                            if silentAim.ignoreFov or isOnScreen then
                                local screenDistance = (Vector2.new(screen.X, screen.Y) - pointer).Magnitude
                                if silentAim.ignoreFov or screenDistance <= silentAim.fovRadius then
                                    if (not silentAim.requireVisible) or silentTargetVisible(myPos, part, character) then
                                        local selectionDistance = isOnScreen and screenDistance or (1000000 + worldDistance)
                                        if selectionDistance < bestDistance then
                                            bestDistance = selectionDistance
                                            best = {
                                                player = player,
                                                character = character,
                                                part = part,
                                                worldPosition = part.Position,
                                                screenDistance = screenDistance,
                                                worldDistance = worldDistance,
                                            }
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

