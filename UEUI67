    end
    local item = localFighter and localFighter.EquippedItem
    if item and item.Name == "Katana" then
        local attackCooldown = rawget(item, "_attack_cooldown")
        local deflectCooldown = rawget(item, "_deflect_cooldown")
        local deflectHash = rawget(item, "_deflect_hash")
        local now = tick()
        return type(attackCooldown) == "number"
            and type(deflectCooldown) == "number"
            and type(deflectHash) == "number"
            and attackCooldown > now
            and deflectCooldown > now
            and deflectHash % 2 == 1
    end
    return false
end

