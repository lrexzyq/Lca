-- Kicia's Flight input [103480]: W/S ride the flattened look vector, A/D the raw
-- camera RightVector, Space rises, LeftControl/LeftShift descend; without a keyboard
-- the PlayerModule move vector rides the unflattened look/right vectors. The sum is
-- returned unnormalized - UpdateFlight normalizes, like Kicia's Update does.
function RivalsRuntimeBridge.Movement.FlightMoveDirection()
    local movement = RivalsRuntimeBridge.Movement
    if UserInputService:GetFocusedTextBox() then
        return Vector3.zero
    end
    local direction = Vector3.zero
    local cframe = Workspace.CurrentCamera.CFrame
    if UserInputService.KeyboardEnabled then
        local look = cframe.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0 then
            flatLook = flatLook.Unit
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction = direction + flatLook
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction = direction - cframe.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction = direction - flatLook
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction = direction + cframe.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction = direction + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            direction = direction - Vector3.new(0, 1, 0)
        end
    else
        local moveVector = movement.ResolveControlsMoveVector()
        if moveVector.Magnitude > 0 then
            direction = direction + cframe.LookVector * -moveVector.Z
            direction = direction + cframe.RightVector * moveVector.X
        end
    end
    return direction
end

function RivalsRuntimeBridge.Movement.FlattenDirection(vector)
    local flat = Vector3.new(vector.X, 0, vector.Z)
    return flat.Magnitude > 0 and flat.Unit or Vector3.zero
end

-- Kicia's Auto Strafe input [70819]: flattened look AND right vectors, W/S/D/A only,
-- PlayerModule move vector without a keyboard, normalized before returning.
function RivalsRuntimeBridge.Movement.StrafeMoveDirection()
    local movement = RivalsRuntimeBridge.Movement
    if UserInputService:GetFocusedTextBox() then
        return Vector3.zero
    end
    local direction = Vector3.zero
    local cframe = Workspace.CurrentCamera.CFrame
    local look = movement.FlattenDirection(cframe.LookVector)
    local right = movement.FlattenDirection(cframe.RightVector)
    if UserInputService.KeyboardEnabled then
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction = direction + look
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction = direction - look
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction = direction + right
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction = direction - right
        end
    else
        local moveVector = movement.ResolveControlsMoveVector()
        if moveVector.Magnitude > 0 then
            direction = direction + look * -moveVector.Z
            direction = direction + right * moveVector.X
        end
    end
    if direction.Magnitude > 0 then
        direction = direction.Unit
    end
    return direction
end

function RivalsRuntimeBridge.Movement.UpdateFlight(active)
    local movement = RivalsRuntimeBridge.Movement
    local rootPart = movement.RootPart
    if not active or not rootPart or rootPart.Parent == nil
        or not movement.Humanoid or movement.Humanoid.Health <= 0 then
        movement.DestroyFlight()
        return
    end
    local direction = movement.FlightMoveDirection()
    if direction.Magnitude > 0 then
        direction = direction.Unit
    end
    local velocityVector = direction * movement.ReadNumber('P10S3S4', 100)
    local flight = movement.Flight
    if flight and flight.RootPart ~= rootPart then
        movement.DestroyFlight()
        flight = nil
    end
    if flight then
        flight.Velocity.VectorVelocity = velocityVector
        return
    end
    -- Kicia's _ApplyVelocity [103530]: unnamed Attachment + LinearVelocity, world
    -- relative, infinite force, velocity assigned before Attachment0/Parent.
    local attachment = Instance.new('Attachment')
    attachment.Parent = rootPart
    local velocity = Instance.new('LinearVelocity')
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.MaxForce = math.huge
    velocity.VectorVelocity = velocityVector
    velocity.Attachment0 = attachment
    velocity.Parent = rootPart
    movement.Flight = { RootPart = rootPart, Attachment = attachment, Velocity = velocity }
end

function RivalsRuntimeBridge.Movement.BlankFlightVelocity()
    local movement = RivalsRuntimeBridge.Movement
    if movement.Flight and movement.RootPart and movement.RootPart.Parent then
        movement.RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

function RivalsRuntimeBridge.Movement.UpdateNoclip(active)
    local movement = RivalsRuntimeBridge.Movement
    local character = movement.Character
    local alive = character ~= nil and movement.Humanoid ~= nil and movement.Humanoid.Health > 0
    if not alive then
        -- Kicia's died path [139956] clears the registry without restoring: the
        -- character is on its way out, so there is nothing to put back.
        movement.ClearNoclipCharacter()
    elseif movement.NoclipCharacter ~= character then
        movement.BindNoclipCharacter(character)
    end
    movement.SetNoclipEnabled(active == true and alive)
    if not movement.NoclipEnabled then
        return
    end
    for part in pairs(movement.CollidableParts) do
        part.CanCollide = false
    end
end

function RivalsRuntimeBridge.Movement.UpdateAutoStrafe(deltaTime, active)
    local movement = RivalsRuntimeBridge.Movement
    local rootPart = movement.RootPart
    if not active or not rootPart or not movement.Humanoid or movement.Humanoid.Health <= 0
        or not UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        return
    end
    local speed = movement.ReadNumber('P10S3S5', 50)
    rootPart.CFrame = rootPart.CFrame + movement.StrafeMoveDirection() * (speed / 100) * deltaTime * 60
    rootPart.AssemblyLinearVelocity = rootPart.AssemblyLinearVelocity * Vector3.new(0, 1, 0)
end

function RivalsRuntimeBridge.Movement.ResolveMechanicsController()
    local movement = RivalsRuntimeBridge.Movement
    if movement.MechanicsController then
        return movement.MechanicsController
    end
    if not IsReplicatedStateReady() then
        return nil
    end
    local playerScripts = LP:FindFirstChild('PlayerScripts')
    local controllers = playerScripts and playerScripts:FindFirstChild('Controllers')
    local mechanicsModule = controllers and controllers:FindFirstChild('MechanicsController')
    if mechanicsModule then
        local ok, controller = pcall(require, mechanicsModule)
        movement.MechanicsController = ok and type(controller) == 'table' and controller or nil
    end
    return movement.MechanicsController
end

function RivalsRuntimeBridge.Movement.AttemptLoadWalkSpeedHook()
    local movement = RivalsRuntimeBridge.Movement
    if movement.WalkSpeedHookLoaded then
        return true
    end
    if type(debug.getupvalues) ~= 'function' or type(debug.setupvalue) ~= 'function' then
        return false
    end
    local mechanics = movement.ResolveMechanicsController()
    if type(mechanics) ~= 'table' then
        return false
    end
    local metatable = getmetatable(mechanics)
    local classIndex = type(metatable) == 'table' and rawget(metatable, '__index') or nil
    local getWalkSpeed = type(classIndex) == 'table' and rawget(classIndex, '_GetWalkSpeed') or nil
    if type(getWalkSpeed) ~= 'function' then
        return false
    end
    local upvalueIndex, oldUpvalue
    for index, value in pairs(debug.getupvalues(getWalkSpeed)) do
        if type(value) == 'table' and rawget(value, 'BASE_WALKSPEED') ~= nil then
            upvalueIndex = index
            oldUpvalue = value
            break
        end
    end
    if upvalueIndex == nil then
        return false
    end
    movement.WalkSpeedHookGetter = getWalkSpeed
    movement.WalkSpeedHookUpvalueIndex = upvalueIndex
    movement.WalkSpeedHookOldUpvalue = oldUpvalue
    -- Kicia's injection [111866]: swap _GetWalkSpeed's constants upvalue for a proxy.
    -- One proxy serves both features: the Slide caller (debug.info level 3 names the
    -- game's Slide routine) gets the sliding multiplier first, every other caller gets
    -- the WalkSpeed multiplier, and any non-BASE_WALKSPEED read trips Kicia's kick.
    debug.setupvalue(getWalkSpeed, upvalueIndex, setmetatable({}, {
        __index = function(_, key)
            if key ~= 'BASE_WALKSPEED' then
                LP:Kick('Unexpected behavior (client physics 1)')
                return nil
            end
            local baseWalkSpeed = rawget(oldUpvalue, 'BASE_WALKSPEED')
            if movement.SlidingMultiplierEnabled and debug.info(3, 'n') == 'Slide' then
                return baseWalkSpeed * movement.SlidingMultiplier
            end
            if movement.WalkMultiplierEnabled then
                return baseWalkSpeed * movement.WalkMultiplier
            end
            return baseWalkSpeed
        end,
    }))
    movement.WalkSpeedHookLoaded = true
    return true
end

function RivalsRuntimeBridge.Movement.UpdateWalkSpeed(active)
    local movement = RivalsRuntimeBridge.Movement
    movement.WalkMultiplier = movement.ReadNumber('P10S3S1', 2)
    movement.WalkMultiplierEnabled = active == true
    movement.AttemptLoadWalkSpeedHook()
end

function RivalsRuntimeBridge.Movement.UpdateSliding(active)
    local movement = RivalsRuntimeBridge.Movement
    movement.SlidingMultiplier = movement.ReadNumber('P10S3S2', 10)
    movement.SlidingMultiplierEnabled = active == true
    movement.AttemptLoadWalkSpeedHook()
end

function RivalsRuntimeBridge.Movement.UpdateJumpPower(active)
    local movement = RivalsRuntimeBridge.Movement
    movement.JumpPowerMultiplier = movement.ReadNumber('P10S3S3', 2)
    movement.JumpPowerEnabled = active == true
    movement.AttemptLoadJumpPowerHook()
end

function RivalsRuntimeBridge.Movement.LaunchLongJump()
    local movement = RivalsRuntimeBridge.Movement
    local fighter = ResolveLocalFighter()
    local entity = type(fighter) == 'table' and rawget(fighter, 'Entity') or nil
    if not entity and fighter and type(fighter.GetEntity) == 'function' then
        local ok, value = pcall(fighter.GetEntity, fighter)
        entity = ok and value or nil
    end
    local rootPart = movement.RootPart
    local camera = Workspace.CurrentCamera
    if type(entity) ~= 'table' or not rootPart or not camera or not movement.Humanoid
        or movement.Humanoid.Health <= 0 then
        return false
    end
    local lookVector = camera.CFrame.LookVector
    local direction = Vector3.new(lookVector.X, 0, lookVector.Z)
    if direction.Magnitude < 0.001 then
        local rootLook = rootPart.CFrame.LookVector
        direction = Vector3.new(rootLook.X, 0, rootLook.Z)
    end
    direction = direction.Unit
    if Options.P10S3D1 and Options.P10S3D1.Value == 'Under Feet' then
        direction = (direction * movement.ReadNumber('P10S3S8', 8) + Vector3.new(0, 4, 0)).Unit
    end
    local velocity = direction * movement.ReadNumber('P10S3S6', 60)
        + Vector3.new(0, movement.ReadNumber('P10S3S7', 20), 0)
    if type(entity.AirborneCancel) ~= 'function' or type(entity.AirborneTrigger) ~= 'function' then
        return false
    end
    pcall(entity.AirborneCancel, entity)
    local ok = pcall(entity.AirborneTrigger, entity, velocity, 4)
    return ok
end

function RivalsRuntimeBridge.Movement.UpdateLongJump(active)
    local movement = RivalsRuntimeBridge.Movement
    if active and not movement.LongJumpPressed then
        movement.LaunchLongJump()
    end
    movement.LongJumpPressed = active
end

function RivalsRuntimeBridge.Movement.Update(deltaTime)
    local movement = RivalsRuntimeBridge.Movement
    movement.ResolveCharacter()
    movement.UpdateWalkSpeed(
        movement.ReadToggle('P10S3T1') and movement.IsKeyActive('P10S3T1K'))
    movement.UpdateSliding(
        movement.ReadToggle('P10S3T2') and movement.IsKeyActive('P10S3T2K'))
    -- Kicia's Jump Power has no keybind [53609]; the toggle alone drives it.
    movement.UpdateJumpPower(movement.ReadToggle('P10S3T3'))
    -- Kicia's physics pump order [90368]: autoStrafe, flight, noclip.
    movement.UpdateAutoStrafe(
        deltaTime,
        movement.ReadToggle('P10S3T6') and movement.IsKeyActive('P10S3T6K'))
    movement.UpdateFlight(
        movement.ReadToggle('P10S3T4') and movement.IsKeyActive('P10S3T4K'))
    movement.UpdateNoclip(
        movement.ReadToggle('P10S3T5') and movement.IsKeyActive('P10S3T5K'))
    movement.UpdateLongJump(
        movement.ReadToggle('P10S3T7') and movement.IsKeyActive('P10S3T7K'))
end

function RivalsRuntimeBridge.Movement.RefreshAll()
    local movement = RivalsRuntimeBridge.Movement
    local caps = __kicia_hook_genv.KiciaHookCaps
    -- Support notices only -- the Attempt*Hook loaders already decline
    -- cleanly when the debug surface is missing.
    if movement.ReadToggle('P10S3T1') or movement.ReadToggle('P10S3T2') then
        caps.gate('WalkSpeed / Sliding Speed', 'debug.getupvalues', 'debug.setupvalue')
    end
    if movement.ReadToggle('P10S3T3') then
        caps.gate('Jump Power', 'debug.getupvalues', 'debug.setupvalue', 'debug.getconstants', 'debug.getprotos', 'debug.getproto')
    end
    RivalsRuntimeBridge.Movement.Update(0)
end

function RivalsRuntimeBridge.Movement.Destroy()
    local movement = RivalsRuntimeBridge.Movement
    movement.SetNoclipEnabled(false)
    movement.ClearNoclipCharacter()
    movement.DestroyFlight()
    if movement.WalkSpeedHookLoaded and movement.WalkSpeedHookGetter
        and movement.WalkSpeedHookUpvalueIndex ~= nil and movement.WalkSpeedHookOldUpvalue ~= nil then
        pcall(debug.setupvalue, movement.WalkSpeedHookGetter,
            movement.WalkSpeedHookUpvalueIndex, movement.WalkSpeedHookOldUpvalue)
    end
    movement.WalkSpeedHookLoaded = false
    movement.WalkSpeedHookGetter = nil
    movement.WalkSpeedHookUpvalueIndex = nil
    movement.WalkSpeedHookOldUpvalue = nil
    movement.WalkMultiplierEnabled = false
    movement.SlidingMultiplierEnabled = false
    -- Kicia's JumpPower Destroy [91454] flags the hook destroyed; the proxies restore
    -- their original upvalues lazily on the next read instead of being torn down here.
    movement.JumpPowerHookDestroyed = true
    movement.JumpPowerHookLoaded = false
    movement.JumpPowerEnabled = false
    movement.MechanicsController = nil
    movement.PlayerModule = nil
    movement.Character = nil
    movement.Humanoid = nil
    movement.RootPart = nil
    movement.LongJumpPressed = false
end

-- Device Spoof: direct 1:1 port of Kicia's DeviceSpoof [17425]. Replaces the
-- ControlsController upvalue inside FighterController._ReplicateControls with a proxy
-- that only answers CurrentControls (kicking any other read, exactly like Kicia) and
-- returns the spoofed device string. The game's own replication then reports that
-- device to the server.

RivalsRuntimeBridge.AnimationPlayer = {
    Character = nil,
    Humanoid = nil,
    Track = nil,
    AnimatorWait = nil,
    AwaitingOwnership = false,
    LastLoadFailure = nil,
}

function RivalsRuntimeBridge.AnimationPlayer.ReadEnabled()
    return Toggles and Toggles.P10S6T1 and Toggles.P10S6T1.Value == true
end

function RivalsRuntimeBridge.AnimationPlayer.ReadSpeed()
    local option = Options and Options.P10S6S1
    return option and type(option.Value) == 'number' and option.Value or 1
end

function RivalsRuntimeBridge.AnimationPlayer.ResolveAnimationId()
    local option = Options and Options.P10S6I1
    local value = option and option.Value
    if type(value) ~= 'string' then
        return nil
    end
    return value:match('%d+')
end

function RivalsRuntimeBridge.AnimationPlayer.Stop()
    local player = RivalsRuntimeBridge.AnimationPlayer
    if player.AnimatorWait then
        player.AnimatorWait:Disconnect()
        player.AnimatorWait = nil
    end
    local track = player.Track
    player.Track = nil
    if track then
        pcall(track.Stop, track)
        pcall(track.Destroy, track)
    end
end

function RivalsRuntimeBridge.AnimationPlayer.Apply(awaitOwnership)
    local player = RivalsRuntimeBridge.AnimationPlayer
    player.Stop()
    player.AwaitingOwnership = false
    if not player.ReadEnabled() then
        return
    end
    local humanoid = player.Humanoid
    if not humanoid or humanoid.Parent == nil then
        return
    end
    local animator = humanoid:FindFirstChildOfClass('Animator')
    if not animator then
        player.AnimatorWait = humanoid.ChildAdded:Connect(function(child)
            if child:IsA('Animator') and player.Humanoid == humanoid then
                player.Apply(true)
            end
        end)
        return
    end
    local animationId = player.ResolveAnimationId()
    if not animationId then
        return
    end
    local animation = Instance.new('Animation')
    animation.AnimationId = 'rbxassetid://' .. animationId
    local ok, track = pcall(animator.LoadAnimation, animator, animation)
    animation:Destroy()
    if not ok or not track then
        if player.LastLoadFailure ~= animationId then
            player.LastLoadFailure = animationId
            if Library and type(Library.Notify) == 'function' then
                Library:Notify({
                    Title = 'Animation Player',
                    Description = 'Animation ' .. animationId .. ' could not be loaded.',
                    Time = 3,
                })
            end
        end
        return
    end
    player.LastLoadFailure = nil
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = true
    player.Track = track
    track:Play()
    track:AdjustSpeed(player.ReadSpeed())
    player.AwaitingOwnership = awaitOwnership == true
end

function RivalsRuntimeBridge.AnimationPlayer.AdjustSpeed()
    local player = RivalsRuntimeBridge.AnimationPlayer
    if player.Track then
        pcall(player.Track.AdjustSpeed, player.Track, player.ReadSpeed())
    end
end

function RivalsRuntimeBridge.AnimationPlayer.EnforceWindow(track)
    local length = track.Length
    if type(length) ~= 'number' or length <= 0 then
        return
    end
    local startOption = Options and Options.P10S6S2
    local endOption = Options and Options.P10S6S3
    local startPercent = startOption and tonumber(startOption.Value) or 0
    local endPercent = endOption and tonumber(endOption.Value) or 100
    local windowStart = math.clamp(startPercent, 0, 100) / 100 * length
    local windowEnd = math.clamp(endPercent, 0, 100) / 100 * length
    if windowEnd <= windowStart then
        return
    end
    if track.TimePosition >= windowEnd or track.TimePosition < windowStart then
        track.TimePosition = windowStart
    end
end

function RivalsRuntimeBridge.AnimationPlayer.Update()
    local player = RivalsRuntimeBridge.AnimationPlayer
    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass('Humanoid') or nil
    if character ~= player.Character or humanoid ~= player.Humanoid then
        player.Stop()
        player.Character = character
        player.Humanoid = humanoid
        player.Apply(true)
        return
    end
    local track = player.Track
    if not track then
        return
    end
    if not track.IsPlaying then
        player.Track = nil
        pcall(track.Destroy, track)
        player.Apply(false)
        return
    end
    if player.AwaitingOwnership and humanoid and humanoid.RootPart then
        player.AwaitingOwnership = false
        player.Apply(false)
        return
    end
    player.EnforceWindow(track)
end

function RivalsRuntimeBridge.AnimationPlayer.RefreshAll()
    RivalsRuntimeBridge.AnimationPlayer.Apply(false)
end

function RivalsRuntimeBridge.AnimationPlayer.Destroy()
    local player = RivalsRuntimeBridge.AnimationPlayer
    player.Stop()
    player.Character = nil
    player.Humanoid = nil
    player.AwaitingOwnership = false
    player.LastLoadFailure = nil
end

