local function applyMeleeAnimation()
    if ModSettings.NoMeleeAnimation then
        task.spawn(function()
            local ok, Melee = pcall(function() return require(lp.PlayerScripts.Modules.ItemTypes.Melee) end)
            if ok and Melee and Melee.StartShooting then
                if not WeaponOriginals.MeleeStartShooting then WeaponOriginals.MeleeStartShooting = Melee.StartShooting end
                local old = WeaponOriginals.MeleeStartShooting
                Melee.StartShooting = function(self, p1, p2)
                    local vm = self.ViewModel; local savedPlay
                    if vm then savedPlay = vm.PlayAnimation; vm.PlayAnimation = function() end end
                    local result = { old(self, p1, p2) }
                    if vm and savedPlay then
                        vm.PlayAnimation = savedPlay
                        pcall(function()
                            for _, name in ipairs({"Attack", "Attack1", "Attack2", "Swing", "Slash", "Combo1", "Combo2", "Combo3"}) do
                                vm:StopAnimation(name)
                            end
                        end)
                    end
                    return table.unpack(result)
                end
            end
        end)
    end
end

local function applyDashCooldown()
    if ModSettings.NoDashCooldown then
        task.spawn(function()
            local modules = ReplicatedStorage:FindFirstChild("Modules")
            local itemLib = modules and modules:FindFirstChild("ItemLibrary")
            if itemLib then
                local success, library = pcall(require, itemLib)
                if success and type(library) == "table" then
