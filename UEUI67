local function restoreSilentHook()
    local item = silentAim.hookedItem
    local original = silentAim.originalStartShooting
    if item and original and item.StartShooting == silentAim.wrappedStartShooting then
        pcall(function() item.StartShooting = original end)
    end
    silentAim.hookedItem = nil
    silentAim.originalStartShooting = nil
    silentAim.wrappedStartShooting = nil
end

local function ensureSilentHook(item)
    if not item or type(item.StartShooting) ~= "function" then return end
    if silentAim.hookedItem == item then return end
    restoreSilentHook()
    local original = item.StartShooting
    local wrapped
    wrapped = function(self, ...)
        local camera = Workspace.CurrentCamera
        local oldCF = camera and camera.CFrame or nil
        local target = silentAim.enabled and getSilentTarget() or nil
        if target and camera and oldCF then
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, target.worldPosition)
        end
        local packed = table.pack(pcall(original, self, ...))
        if camera and oldCF and Workspace.CurrentCamera == camera then
            camera.CFrame = oldCF
        end
        if not packed[1] then
            error(packed[2])
        end
        return table.unpack(packed, 2, packed.n)
    end
    silentAim.hookedItem = item
    silentAim.originalStartShooting = original
    silentAim.wrappedStartShooting = wrapped
    item.StartShooting = wrapped
end

local function updateSilentRuntime()
    local item = resolveSilentHookItem()
    if silentAim.enabled and item and not isAimbotWeaponIgnored(item) then
        ensureSilentHook(item)
    else
        restoreSilentHook()
    end
    local target = (silentAim.enabled and item and not isAimbotWeaponIgnored(item)) and getSilentTarget() or nil
    silentAim.target = target
    silentAim.targetAt = target and tick() or 0
    updateSilentFov()
end

