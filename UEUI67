function Aimbot:_getBestTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end

    local myPos = cam.CFrame.Position
    local myTeam = lp:GetAttribute("TeamID")
    local myEnv = lp:GetAttribute("EnvironmentID")
    local viewport = cam.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local best, bestScore = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        if p:GetAttribute("EnvironmentID") ~= myEnv then continue end
        if self.teamCheck and myTeam ~= nil and p:GetAttribute("TeamID") == myTeam then continue end

        local char = p.Character
        if not char then continue end

        local part = char:FindFirstChild(self.hitPart)
        if not part then
            part = char:FindFirstChild("Head")
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not part or not hum or hum.Health <= 0 then continue end

        local aimPos = part.Position
        if self.prediction > 0 then
            local vel = part.AssemblyLinearVelocity
            if vel.Magnitude < 500 then
                aimPos += vel * self.prediction
            end
        end

        local delta = aimPos - myPos
        local dist = delta.Magnitude
        if dist > self.maxDist or dist <= 0 then continue end

        local screen, onScreen = cam:WorldToViewportPoint(aimPos)
        if not onScreen then continue end

        local screenDelta = Vector2.new(screen.X, screen.Y) - center
        local fovDist = screenDelta.Magnitude
        if fovDist > self.fov then continue end

        if self.visCheck then
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {lp.Character, char}
            params.FilterType = Enum.RaycastFilterType.Exclude
            local hit = Workspace:Raycast(myPos, delta, params)
            if hit and not hit.Instance:IsDescendantOf(char) then
                continue
            end
        end

        local score = fovDist * 0.7 + (dist / 1000) * 0.3
        if score < bestScore then
            bestScore = score
            best = {
                character = char,
                part = part,
                position = aimPos,
                screenPos = Vector2.new(screen.X, screen.Y),
            }
        end
    end

    return best
end

function Aimbot:_generateTrajectory(targetScreenPos)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end

    local viewport = cam.ViewportSize
    local startPos = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local duration = math.max(0.05, self.flickDuration)
    local steps = math.max(10, math.floor(duration * 60))
    local trajectory = {}

    for i = 0, steps do
        local t = i / steps
        local eased = t ^ (1 + self.flickCurvature * 0.5)
        local x = startPos.X + (targetScreenPos.X - startPos.X) * eased
        local y = startPos.Y + (targetScreenPos.Y - startPos.Y) * eased

        if self.flickHumanness > 0 and i < steps then
            local noise = (math.random() - 0.5) * self.flickHumanness * 12
            x += noise
            y += noise
        end

        local ray = cam:ViewportPointToRay(x, y)
        trajectory[#trajectory + 1] = {
            direction = ray.Direction,
            t = t * duration,
        }
    end

    local finalRay = cam:ViewportPointToRay(targetScreenPos.X, targetScreenPos.Y)
    trajectory[#trajectory].direction = finalRay.Direction
    return trajectory
end

function Aimbot:_startFlick(target)
    self._trajectory = self:_generateTrajectory(target.screenPos)
    if not self._trajectory then return end

    self._trajectoryIndex = 1
    self._elapsed = 0
    self._total = self._trajectory[#self._trajectory].t
    self._selected = target
    self._state = "Flicking"
end

function Aimbot:_finishFlick()
    self._trajectory = nil
    self._selected = nil
    self._state = "Cooldown"
    self._elapsed = 0
end

function Aimbot:_updateNormal(dt, target)
    if not target then return end
    local cam = Workspace.CurrentCamera
    local cc = self:getCC()
    if not cam or not cc then return end

    local targetCF = CFrame.lookAt(cam.CFrame.Position, target.position)
    if self.smoothing > 0 then
        local alpha = math.clamp(dt * (1 / (self.smoothing / 100 + 0.01)), 0, 1)
        targetCF = cam.CFrame:Lerp(targetCF, alpha)
    end

    local ok = false
    if cc and type(cc.MimicRotation) == "function" then
        ok = pcall(function()
            cc:MimicRotation(targetCF.Rotation)
        end)
    end

    if not ok then
        pcall(function()
            cam.CFrame = targetCF
        end)
    end
end

function Aimbot:_applyFlickRotation(cam, cc, rotation)
    local ok = false

    if cc and type(cc.MimicRotation) == "function" then
        ok = pcall(function()
            cc:MimicRotation(rotation)
        end)
    end

    if not ok then
        pcall(function()
            cam.CFrame = CFrame.new(cam.CFrame.Position) * rotation
        end)
    end
end

function Aimbot:_fireAfterFlick()
    local target = self._selected
    if not target or not target.part or not target.part.Parent then return end

    if self.fireMode == "MouseClick" then
        local click = mouse1click
        if type(click) == "function" then
            pcall(click)
        end
        return
    end

    pcall(function()
        local fighterController = getFighterController()
        local fighter = fighterController and fighterController.LocalFighter
        local equipped = fighter and fighter.EquippedItem
        if not equipped then return end

        local objId = equipped:Get("ObjectID")
        if not objId or not Utility or not EnumLibrary then return end

        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local shootPos = root.Position
        local targetPos = target.part.Position
        local aimCF = CFrame.new(shootPos, targetPos)

        local data = {
            [utf8.char(1)] = {
                [utf8.char(0)] = Utility:EncodeCFrame(aimCF),
                [utf8.char(1)] = Utility:EncodeCFrame(aimCF),
                [utf8.char(2)] = target.part,
                [utf8.char(3)] = Utility:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42)),
            },
        }

        ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(
            objId,
            EnumLibrary:ToEnum("StartShooting"),
            data,
            nil
        )
    end)
end

function Aimbot:_updateFlick(dt)
    local target = self._selected
    local cam = Workspace.CurrentCamera
    local cc = self:getCC()

    
    if not target or not target.character or not target.character.Parent or not target.part.Parent
        or not cam then
        self:_finishFlick()
        return
    end

    self._elapsed += dt
    local traj = self._trajectory
    if not traj then
        self:_finishFlick()
        return
    end

    local idx = self._trajectoryIndex
    while idx < #traj and traj[idx + 1].t <= self._elapsed do
        idx += 1
    end
    self._trajectoryIndex = idx

    if idx >= #traj then
        local pos = target.part.Position
        self:_applyFlickRotation(
            cam,
            cc,
            CFrame.lookAt(cam.CFrame.Position, pos).Rotation
        )

        if self.shootAfterFlick then
            self._state = "PostFlickShot"
            self._elapsed = 0
        else
            self:_finishFlick()
        end
        return
    end

    local a, b = traj[idx], traj[idx + 1]
    local alpha = 0
    if b.t > a.t then
        alpha = math.clamp((self._elapsed - a.t) / (b.t - a.t), 0, 1)
    end

    local dir = a.direction:Lerp(b.direction, alpha)
    self:_applyFlickRotation(
        cam,
        cc,
        CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + dir * 100).Rotation
    )
end

function Aimbot:update(dt)
    if not self.enabled then return end
    dt = tonumber(dt) or 0.016

    if self._state == "Cooldown" then
        self._elapsed += dt
        if self._elapsed >= self.cooldown then
            self._elapsed = 0
            self._state = "Idle"
        end
        return
    end

    if self._state == "Flicking" then
        self:_updateFlick(dt)
        return
    end

    if self._state == "PostFlickShot" then
        self._elapsed += dt
        if self._elapsed >= self.shotDelay then
            self:_fireAfterFlick()
            self:_finishFlick()
        end
        return
    end

    local target = self:_getBestTarget()
    if not target then return end

    if self.flickEnabled then
        self:_startFlick(target)
    else
        self:_updateNormal(dt, target)
    end
end

local function setRunService(type)
    runServiceType = type
    if runServiceConnection then
        runServiceConnection:Disconnect()
        runServiceConnection = nil
    end

    local signal
    if type == "Heartbeat" then
        signal = RunService.Heartbeat
    elseif type == "RenderStepped" then
        signal = RunService.RenderStepped
    elseif type == "PreSimulation" then
        signal = RunService.PreSimulation
    end

    if signal then
        runServiceConnection = signal:Connect(function(dt)
            Aimbot:update(dt)
        end)
    end
end

